{
  "name": "flambette",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:unit": "bun test src",
    "test:e2e": "playwright test",
    "test:worker": "vitest run --config server/vitest.config.ts",
    "typecheck:worker": "tsc -p server/tsconfig.json",
    "dev:relay": "wrangler dev -c server/wrangler.jsonc",
    "deploy:web": "wrangler deploy",
    "deploy:relay": "wrangler deploy -c server/wrangler.jsonc",
    "types:worker": "wrangler types -c server/wrangler.jsonc server/worker-configuration.d.ts --include-runtime=false --strict-vars=false",
    "data:pack": "python3 scripts/build_pack_index.py",
    "data:verify": "bun run scripts/verify_pack_index_parity.ts"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "lucide-vue-next": "^1.0.0",
    "minisearch": "^7.2.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.42",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4"
  }
}

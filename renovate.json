{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranches": ["main"],
  "timezone": "America/New_York",
  "schedule": ["at any time"],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "prCreation": "immediate",
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 0,
  "ignoreUnstable": true,
  "packageRules": [
    {
      "description": [
        "Group minor, patch, pin and digest updates (npm/bun, GH Actions, Docker) into one PR, then auto-merge when the full e2e + unit + docker CI gate is green — keeps the 288-test e2e suite from running once per package."
      ],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "minor & patch updates",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": [
        "Major bumps land one per PR; auto-merge only when CI is green (never on a red run)."
      ],
      "matchUpdateTypes": ["major"],
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "lockFileMaintenance": {
    "enabled": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true,
    "prCreation": "immediate"
  }
}

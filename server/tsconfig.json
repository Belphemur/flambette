{
  // The Cloudflare relay worker (ADR-0038). It is NOT part of the Vue
  // app's tsconfig: the worker runs in workerd, so it type-checks against
  // the Workers runtime types rather than the DOM, and it shares nothing
  // with the browser bundle except the pure room-code module.
  //
  //   bunx tsc -p server/tsconfig.json      # type-check the worker
  //   bun run test:worker                   # drive the real DO in workerd
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types/experimental"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "relay-core/**/*.ts",
    "worker/**/*.ts",
    "worker-configuration.d.ts",
    "../src/lib/roomWords.ts"
  ],
  // The shared core's specs run under `bun test`, not workerd, and import
  // `bun:test`; they are type-checked by server/tsconfig.relay.json's
  // sibling (bun) project and by the runner that actually executes them.
  "exclude": ["**/*.test.ts"]
}

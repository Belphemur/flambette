    "instructions": [
     {
      "id": 90000101,
      "primary_message": "Prepare the buttermilk substitute, if using: combine the milk and the lemon juice or vinegar, then stand for 5 minutes to curdle slightly.",
      "secondary_message": "500 ml whole milk\n40 ml lemon juice"
     },
     {
      "id": 90000102,
      "primary_message": "Mix the dry ingredients: whisk together the flour, baking powder, salt and sugar.",
      "secondary_message": "400 g all-purpose flour\n35 g baking powder\n3 g salt\n50 g granulated sugar"
     },
     {
      "id": 90000103,
      "primary_message": "Combine the wet ingredients: whisk the eggs, then whisk in the milk (or the buttermilk substitute), the cooled melted butter and the vanilla.",
      "secondary_message": "3 large eggs\n500 ml whole milk\n120 g butter, unsalted\n10 ml vanilla extract"
     },
     {
      "id": 90000104,
      "primary_message": "Make the batter: pour the wet into the dry and fold gently until JUST combined. Lumpy is correct — overmixing makes tough pancakes.",
      "secondary_message": null
     },
     {
      "id": 90000105,
      "primary_message": "Rest the batter for 5-10 minutes for maximum fluffiness.",
      "secondary_message": null
     },
     {
      "id": 90000106,
      "primary_message": "Cook on medium-low heat on a lightly greased pan, about 60 ml of batter per pancake, about 2 minutes until bubbles appear and the edges set, then flip and cook 1-2 minutes more until golden.",
      "secondary_message": "60 ml batter"
     },
     {
      "id": 90000107,
      "primary_message": "Keep the cooked pancakes warm on a baking sheet in a 90C oven, and serve them straight away with butter, maple syrup and fresh fruit.",
      "secondary_message": null
     }
    ],

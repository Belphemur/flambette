{"id":12300,"recipe_id":1444,"serving_count":6,"cooking_minutes":30,"name":"Gnocchi with Broccoli \u0026 Cheddar Cheese Sauce","slug":"gnocchi-broccoli-cheddar-cheese-sauce","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1444/thumbnail_373fab37-9126-4542-b2bd-b44c7b76be33.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1444/presentation_373fab37-9126-4542-b2bd-b44c7b76be33.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":15,"name":"grater","slug":"grater"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":48,"name":"medium saucepan","slug":"medium-saucepan"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":206140,"primary_message":"Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.","secondary_message":null},{"id":206141,"primary_message":"Meanwhile, wash and dry broccoli. Separate into bite-sized florets and cut stems into smaller pieces.","secondary_message":"3 crowns broccoli"},{"id":206142,"primary_message":"Once the water in the pot is boiling, add broccoli and gnocchi. Cook, stirring occasionally, until gnocchi begins to float to the surface, about 4-5 minutes.","secondary_message":"3 (454 g) pkgs potato gnocchi"},{"id":206143,"primary_message":"Meanwhile, coarsely grate the cheese and set aside.","secondary_message":"1 (227 g) block cheddar cheese"},{"id":206144,"primary_message":"When the gnocchi and broccoli are done, drain and return to the pot. Cover and set aside.","secondary_message":null},{"id":206145,"primary_message":"Preheat a medium saucepan over medium heat.","secondary_message":null},{"id":206146,"primary_message":"Once the pan is hot, add butter and swirl to coat the bottom.","secondary_message":"¼ cup butter, unsalted"},{"id":206147,"primary_message":"Add flour and whisk until smooth. Cook, whisking frequently, for 1 minute.","secondary_message":"¼ cup all-purpose flour"},{"id":206148,"primary_message":"Slowly pour milk into the pan, whisking constantly. Continue whisking until the sauce has thickened, 4-5 minutes.","secondary_message":"887 ml whole milk"},{"id":206149,"primary_message":"Add cheese and spices to the pan; whisk until cheese is melted and sauce is smooth. ","secondary_message":"1 ½ tsp salt\n½ tsp black pepper\n½ tsp garlic powder"},{"id":206150,"primary_message":"Pour sauce into the pot with the gnocchi and broccoli; stir to combine.","secondary_message":null},{"id":206151,"primary_message":"To serve, divide gnocchi and broccoli between bowls and enjoy!","secondary_message":null}],"line_items":[{"id":215739,"quantity":"3 crowns","ingredient_name":"broccoli"},{"id":215735,"quantity":"1 (227 g) block","ingredient_name":"cheddar cheese"},{"id":215743,"quantity":"3 (454 g) pkgs","ingredient_name":"potato gnocchi"},{"id":215742,"quantity":"887 ml","ingredient_name":"whole milk"},{"id":215741,"quantity":"","ingredient_name":"all-purpose flour"},{"id":215736,"quantity":"","ingredient_name":"black pepper"},{"id":215740,"quantity":"","ingredient_name":"butter, unsalted"},{"id":215737,"quantity":"","ingredient_name":"garlic powder"},{"id":215738,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":677.7,"alcohol":0.0,"ash":7.46,"caffeine":0.0,"water":392.98,"carbs":57.03,"fiber":4.96,"starch":37.66,"sugars":11.46,"fructose":0.83,"galactose":0.04,"glucose":0.71,"lactose":9.42,"maltose":0.21,"sucrose":0.31,"sugar_alcohol":0.0,"fat":41.03,"monounsaturated":10.32,"polyunsaturated":1.91,"omega_3":0.29,"omega_6":1.61,"saturated":24.55,"transfats":1.55,"cholesterol":114.34,"protein":22.42,"alanine":0.75,"arginine":0.75,"
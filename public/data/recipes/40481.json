{"id":40481,"recipe_id":4368,"serving_count":6,"cooking_minutes":15,"name":"Grapefruit with Caramelized Sugar Topping \u0026 Peanut Butter-Banana Toast","slug":"grapefruit-caramelized-sugar-topping-peanut-butter-banana-toast","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/4368/thumbnail_3c5ea417-35f3-4780-834e-ad97636e689b.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/4368/presentation_3c5ea417-35f3-4780-834e-ad97636e689b.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":77,"name":"toaster (optional)","slug":"toaster"},{"id":35,"name":"tongs","slug":"tongs"}],"instructions":[{"id":626504,"primary_message":"Preheat oven to broil on high and position rack in the upper third of the oven. ","secondary_message":null},{"id":626505,"primary_message":"Wash, dry, and cut grapefruits in half crosswise. (To make eating the grapefruit easier, score the grapefruit, separating the segments from the membrane, using a sharp knife.) Transfer grapefruit to a large baking sheet pan, cut-side up, and sprinkle tops evenly with sugar.","secondary_message":"3 grapefruits\n3 tbsp brown sugar"},{"id":626506,"primary_message":"Place baking sheet in the oven and broil until sugar is caramelized, 2-3 minutes. Remove from oven and set grapefruit aside. (Reserve baking sheet for the next step.)","secondary_message":null},{"id":626507,"primary_message":"Arrange bread on the reserved baking sheet. Place in the oven and broil, flipping halfway through, until toasted, 1-2 minutes. Remove from oven. (Skip this step if you are using a toaster for the bread.)","secondary_message":"6 slices whole grain bread"},{"id":626508,"primary_message":"Meanwhile, peel and thinly slice bananas.","secondary_message":"3 bananas"},{"id":626509,"primary_message":"Spread peanut butter over each slice of toast, then top with banana slices.","secondary_message":"½ cup natural peanut butter"},{"id":626510,"primary_message":"To serve, divide grapefruit and peanut butter-banana toast between plates. Enjoy!","secondary_message":null}],"line_items":[{"id":681596,"quantity":"3","ingredient_name":"bananas"},{"id":681594,"quantity":"3","ingredient_name":"grapefruits"},{"id":681593,"quantity":"6 slices","ingredient_name":"whole grain bread"},{"id":681595,"quantity":"","ingredient_name":"brown sugar"},{"id":681592,"quantity":"","ingredient_name":"natural peanut butter"}],"nutrition":{"energy":356.95,"alcohol":0.0,"ash":2.6,"caffeine":0.0,"water":169.87,"carbs":52.91,"fiber":7.46,"starch":10.04,"sugars":25.22,"fructose":5.91,"galactose":0.0,"glucose":5.49,"lactose":0.0,"maltose":0.33,"sucrose":13.47,"sugar_alcohol":0.0,"fat":13.68,"monounsaturated":6.29,"polyunsaturated":4.45,"omega_3":0.06,"omega_6":4.35,"saturated":1.95,"transfats":0.01,"cholesterol":0.0,"protein":10.79,"alanine":0.26,"arginine":0.81,"aspartic_acid":0.89,"cystine":0.08,"glutamic_acid":1.47,"glycine":0.37,"histidine":0.16,"isoleucine":0.21,"leucine":0.4,"lysine":0.23,"methionine":0.08,"phenylalanine":0.32,"proline":0.34,"serine":0.32,"threonine":0.22,"tryptophan":0.07,"tyrosine":0.25,"valine":0.26,"b1_thiamine":0.29,"b2_riboflavin":0.12,"b3_niacin":5.01,"b5_pantothenic_acid":0.89,"b6_pyridoxine":0.2,"b12_cobalamin":0.0,"choline":34.18,"folate":65.73,"vitamin_a":2.24,"vitamin_c":39.94,"vitamin_d":0.0,"vitamin_e":3.25,"vitamin_k":2.64,"calcium":98.72,"copper":0.28,"iron":1.5,"magnesium":79.33,"manganese":1.24,"phosphorus":179.0,"potassium":424.8,"selenium":10.28,"sodium":149.02,"zinc":1.47}}
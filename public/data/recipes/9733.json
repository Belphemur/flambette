{"id":9733,"recipe_id":1140,"serving_count":6,"cooking_minutes":40,"name":"Creamy Tuscan Soup with Potatoes, Pork \u0026 Kale","slug":"creamy-tuscan-soup-potatoes-pork-kale","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1140/thumbnail_44586a2b-6902-46da-9a88-03a13ecf0507.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1140/presentation_44586a2b-6902-46da-9a88-03a13ecf0507.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":155545,"primary_message":"Preheat a large pot over medium heat.","secondary_message":null},{"id":155546,"primary_message":"Use the tip of a knife to slice down the length of the sausages. Peel off the casing and discard.","secondary_message":"6 pork sausages"},{"id":155547,"primary_message":"Once the pot is hot, add oil and swirl to coat the bottom. Add pork and break apart with a spoon. Cook, stirring occasionally, until browned and crumbly, 7-9 minutes.","secondary_message":"1 tbsp extra virgin olive oil"},{"id":155548,"primary_message":"Meanwhile, peel and mince garlic. Peel and small dice onions.","secondary_message":"6 cloves garlic\n1 ½ medium yellow onions"},{"id":155549,"primary_message":"Add garlic and onion to the pot and cook, stirring frequently, until softened, 5-6 minutes.","secondary_message":null},{"id":155550,"primary_message":"Drain and rinse beans.","secondary_message":"1 ½ (398 ml) cans cannellini (white kidney) beans"},{"id":155551,"primary_message":"Add beans, b
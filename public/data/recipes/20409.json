{"id":20409,"recipe_id":2326,"serving_count":6,"cooking_minutes":20,"name":"\"Mango Lassi\" Granita (Shaved Fruit Ice) with Pistachios","slug":"mango-lassi-granita-shaved-fruit-ice-pistachios","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2326/thumbnail_428fac87-d3c8-4c95-a295-0685883f6920.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2326/presentation_428fac87-d3c8-4c95-a295-0685883f6920.jpeg","cookwares":[{"id":83,"name":"baking dish","slug":"baking-dish"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":74,"name":"hand or regular blender","slug":"hand-or-regular-blender"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":127,"name":"plastic wrap","slug":"plastic-wrap"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"}],"instructions":[{"id":340761,"primary_message":"This recipe will make about 6 cups mango purée. Work in batches to best fit your blender.","secondary_message":null},{"id":340762,"primary_message":"Wash, dry, peel, and slice mango flesh away from the pits, starting with the flat sides; roughly chop and place in a blender. ","secondary_message":"3 mangoes"},{"id":340763,"primary_message":"Wash, dry, and juice limes into the blender. ","secondary_message":"3 limes"},{"id":340764,"primary_message":"Add almond milk, sugar, vanilla, and spices to the blender; blend on high for several minutes until smooth. ","secondary_message":"710 ml almond milk, unsweetened\n1 cup granulated sugar\n1 ½ tsp vanilla extract\n½ tsp cardamom, ground\n½ tsp cinnamon, ground\n½ tsp salt"},{"id":340765,"primary_message":"Transfer mango purée to a large baking dish. Cover with plastic wrap and place in the freezer. Let chill until completely frozen, about 8 hours (or overnight).","secondary_message":null},{"id":340766,"primary_message":"Once the purée is completely frozen, remove from the freezer. Using a fork, scrape the ice from end to end, to form shards. Re-cover with plastic wrap and return to the freezer until ready to serve.","secondary_message":null},{"id":340767,"primary_message":"Just before serving, roughly chop pistachios. ","secondary_message":"¾ cup pistachios, unsalted"},{"id":340768,"primary_message":"To serve, divide granita between bowls and top with pistachios. Enjoy!","secondary_message":null}],"line_items":[{"id":363686,"quantity":"710 ml","ingredient_name":"almond milk, unsweetened"},{"id":363683,"quantity":"3","ingredient_name":"limes"},{"id":363684,"quantity":"3","ingredient_name":"mangoes"},{"id":363685,"quantity":"¾ cup","ingredient_name":"pistachios, unsalted"},{"id":363688,"quantity":"","ingredient_name":"cardamom, ground"},{"id":363681,"quantity":"","ingredient_name":"cinnamon, ground"},{"id":363687,"quantity":"","ingredient_name":"granulated sugar"},{"id":363682,"quantity":"","ingredient_name":"salt"},{"id":363689,"quantity":"","ingredient_name":"vanilla extract"}],"nutrition":{"energy":343.02,"alcohol":0.38,"ash":2.71,"caffeine":0.0,"water":287.91,"carbs":66.13,"fiber":4.74,"starch":0.75,"sugars":58.05,"fructose":8.03,"galactose":0.0,"glucose":3.55,"lactose":0.0,"maltose":0.02,"sucrose":46.31,"sugar_alcohol":0.0,"fat":8.83,"monounsaturated":4.65,"polyunsaturated":2.51,"omega_3":0.13,"omega_6":2.4,"saturated":1.1,"transfats":0.0,"cholesterol":0.0,"protein":5.25,"alanine":0.29,"arginine":0.39,"aspartic_acid":0.43,"cystine":0.06,"glutamic_acid":0.8,"glycine":0.21,"histidine":0.11,"isoleucine":0.19,"leucine":0.33,"lysine":0.3,"methionine":0.07,"phenylalanine":0.22,"proline":0.19,"serine":0.26,"threonine":0.16,"tryptophan":0.07,"tyrosine":0.11,"valine":0.27,"b1_thiamine":0.16,"b2_riboflavin":0.12,"b3_niacin":1.47,"b5_pantothenic_acid":0.45,"b6_pyridoxine":0.38,"b12_cobalamin":0.0,"choline":28.96,"folate":83.61,"vitamin_a":53.15,"vitamin_c":68.27,"vitamin_d":53.85,"vitamin_e":10.25,"vitamin_k":9.29,"calcium":281.18,"copper":0.42,"iron":1.35,"magnesium":44.01,"manganese":0.46,"phosphorus":111.16,"potassium":402.06,"selenium":2.9,"sodium":98.3,"zinc":0.63},"cooking_tip":"This granita takes only 20 minutes to prepare, but will require a minimum of 8 hours in the freezer. For best results, prepare this recipe 1 day before you plan to eat it!"}
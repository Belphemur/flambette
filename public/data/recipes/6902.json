il.","secondary_message":null},{"id":92188,"primary_message":"Grate the mozzarella.","secondary_message":"1 ½ (227 g) blocks mozzarella cheese"},{"id":92189,"primary_message":"To assemble, top the pitas with a thin layer of tomato sauce, cheese, red onion, pineapple, and black beans. Place on a baking sheet and cook in the oven for 2-3 minutes, until the cheese melts. Cook in batches if necessary.","secondary_message":"12 whole grain pitas"},{"id":92190,"primary_message":"Wash and dry cilantro. Shave leaves off the stems; discard the stems.","secondary_message":"1 ½ small bunches cilantro"},{"id":92191,"primary_message":"Remove from oven and top with cilantro leaves. Enjoy!","secondary_message":null}],"line_items":[{"id":95806,"quantity":"1 ½ (398 ml) cans","ingredient_name":"black beans"},{"id":95807,"quantity":"1 ½ small bunches","ingredient_name":"cilantro"},{"id":95799,"quantity":"3 cloves","ingredient_name":"garlic"},{"id":95800,"quantity":"1 ½ (227 g) blocks","ingredient_name":"mozzarella cheese"},{"id":95809,"quantity":"1 ½ small","ingredient_name":"pineapples"},{"id":95805,"quantity":"1 ½ medium","ingredient_name":"red onions"},{"id":95804,"quantity":"3 (213 ml) cans","ingredient_name":"tomato sauce"},{"id":95810,"quantity":"12","ingredient_name":"whole grain pitas"},{"id":95801,"quantity":"","ingredient_name":"black pepper"},{"id":95803,"quantity":"","ingredient_name":"crushed red pepper"},{"id":95808,"quantity":"","ingredient_name":"onion powder"},{"id":95802,"quantity":"","ingredient_name":"paprika"}],"nutrition":{"energy":705.38,"alcohol":0.0,"ash":8.09,"caffeine":0.0,"water":352.81,"carbs":113.75,"fiber":20.76,"starch":65.15,"sugars":18.6,"fructose":4.88,"galactose":0.09,"glucose":6.0,"lactose":0.04,"maltose":0.14,"sucrose":7.89,"sugar_alcohol":0.0,"fat":17.08,"monounsaturated":4.4,"polyunsaturated":2.33,"omega_3":0.42,"omega_6":1.79,"saturated":8.14,"transfats":0.3,"cholesterol":44.83,"protein":33.29,"alanine":1.17,"arginine":1.24,"aspartic_acid":2.63,
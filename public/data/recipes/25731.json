s, being careful to not cut completely through to the bottom. Season with salt.","secondary_message":"½ tsp salt"},{"id":419182,"primary_message":"Add cheese to the skillet with the chicken and stir to combine.","secondary_message":"2 cups shredded cheese, Mexican blend"},{"id":419183,"primary_message":"To serve, divide tomatoes between plates. Stuff with cheesy chicken, then top with lettuce, avocado, and yogurt. Enjoy!","secondary_message":"¾ cup plain Greek yogurt"}],"line_items":[{"id":448833,"quantity":"1 ½","ingredient_name":"avocados"},{"id":448835,"quantity":"1 ½ heads","ingredient_name":"butter (Boston) lettuce"},{"id":448838,"quantity":"0.68 kg","ingredient_name":"ground chicken"},{"id":448832,"quantity":"¾ cup","ingredient_name":"plain Greek yogurt"},{"id":448837,"quantity":"2 cups","ingredient_name":"shredded cheese, Mexican blend"},{"id":448836,"quantity":"67 ½ ml","ingredient_name":"taco seasoning"},{"id":448834,"quantity":"12","ingredient_name":"tomatoes"},{"id":448830,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":448831,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":557.39,"alcohol":0.0,"ash":7.72,"caffeine":0.0,"water":424.06,"carbs":20.5,"fiber":7.68,"starch":0.06,"sugars":9.38,"fructose":3.64,"galactose":0.26,"glucose":3.44,"lactose":0.78,"maltose":0.0,"sucrose":0.03,"sugar_alcohol":0.01,"fat":35.58,"monounsaturated":16.8,"polyunsaturated":4.33,"omega_3":0.38,"omega_6":3.77,"saturated":11.65,"transfats":0.11,"cholesterol":158.01,"protein":42.26,"alanine":1.77,"arginine":1.91,"aspartic_acid":3.25,"cystine":0.37,"glutamic_acid":5.83,"glycine":1.44,"histidine":0.94,"isoleucine":1.46,"leucine":2.52,"lysine":2.7,"methionine":0.78,"phenylalanine":1.29,"proline":1.31,"serine":1.4,"threonine":1.37,"tryptophan":0.31,"tyrosine":1.08,"valine":1.53,"b1_thiamine":0.3,"b2_riboflavin":0.68,"b3_niacin":10.64,"b5_pantothenic_acid":2.58,"b6_pyridoxine":1.01,"b12_cobalamin":1.26,"choline":104.36,"folate":116.58,"vitamin_a":2381.92,"
{"id":4788,"recipe_id":50,"serving_count":6,"cooking_minutes":45,"name":"Cauliflower \u0026 Chickpea Coconut Curry with Couscous","slug":"cauliflower-chickpea-coconut-curry-couscous","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/50/thumbnail_dc32970f-2e38-49ea-ba2c-caa419503132.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/50/presentation_dc32970f-2e38-49ea-ba2c-caa419503132.jpg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":36,"name":"salad spinner (optional)","slug":"salad-spinner"},{"id":14,"name":"small saucepan","slug":"small-saucepan"},{"id":68,"name":"stainless steel sauté pan","slug":"stainless-steel-saute-pan"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":58476,"primary_message":"Wash cauliflower and tomatoes. Cut the cauliflower into bite-sized florets. Medium dice the tomatoes.","secondary_message":"3 medium heads cauliflower\n6 tomatoes"},{"id":58482,"primary_message":"Heat a sauté pan over medium-high heat.","secondary_message":""},{"id":58477,"primary_message":"Peel and mince onion and garlic.","secondary_message":"1 ½ medium yellow onion\n6 cloves garlic"},{"id":58483,"primary_message":"Coat bottom of pan with oil. Add onion and cook, stirring frequently, until softened, 3-4 minutes.","secondary_message":"3 tbsp virgin coconut oil"},{"id":58473,"primary_message":"Drain and rinse chickpeas.","secondary_message":"3 (398 ml) cans garbanzo beans (chickpeas)"},{"id":58478,"primary_message":"Add garlic and curry powder to pan and stir with onion until fragrant, 15-30 seconds.","secondary_message":"3 tbsp curry powder"},{"id":58484,"primary_message":"Add cauliflower and chickpeas and stir until heated through, 1-2 minutes.","secondary_message":""},{"id":58479,"primary_message":"Add tomatoes, coconut milk, salt, and pepper; bring to a boil. Reduce heat to a simmer and cover. Cook until cauliflower is tender and liquid thickens, about 10 minutes.","secondary_message":"1 ½ (398 ml) can coconut milk\n¾ tsp salt\n⅜ tsp black pepper"},{"id":58480,"primary_message":"In a small saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes.","secondary_message":"708 ml (3 cups) chicken or vegetable broth\n2 cups whole wheat couscous"},{"id":58481,"primary_message":"Wash and dry cilantro. Shave the leaves off the stems; discard the stems and mince the leaves. Stir ½ into the curry (save the rest for garnishing).","secondary_message":"1 ½ small bunches cilantro"},{"id":58474,"primary_message":"Uncover couscous and fluff with a fork.","secondary_message":""},{"id":58475,"primary_message":"To serve, place couscous in a bowl, top with curry and garnish with remaining cilantro. Enjoy!","secondary_message":""}],"line_items":[{"id":61746,"quantity":"3 medium heads","ingredient_name":"cauliflower"},{"id":61741,"quantity":"708 ml","ingredient_name":"chicken or vegetable broth"},{"id":61747,"quantity":"1 ½ small bunches","ingredient_name":"cilantro"},{"id":61750,"quantity":"1 ½ (398 ml) cans","ingredient_name":"coconut milk"},{"id":61749,"quantity":"3 (398 ml) cans","ingredient_name":"garbanzo beans (chickpeas)"},{"id":61751,"quantity":"6 cloves","ingredient_name":"garlic"},{"id":61752,"quantity":"6","ingredient_name":"tomatoes"},{"id":61753,"quantity":"2 cups","ingredient_name":"whole wheat couscous"},{"id":61748,"quantity":"1 ½ medium","ingredient_name":"yellow onions"},{"id":61745,"quantity":"","ingredient_name":"black pepper"},{"id":61744,"quantity":"","ingredient_name":"curry powder"},{"id":61742,"quantity"
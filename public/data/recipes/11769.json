{"id":11769,"recipe_id":1373,"serving_count":6,"cooking_minutes":35,"name":"Two Cheese Spinach \u0026 Mushroom Baked Quesadillas","slug":"two-cheese-spinach-mushroom-baked-quesadillas","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1373/thumbnail_a6aae943-19f2-4e4e-bd25-55afa348e053.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1373/presentation_a6aae943-19f2-4e4e-bd25-55afa348e053.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":125,"name":"parchment paper","slug":"parchment-paper"},{"id":18,"name":"spatula","slug":"spatula"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":203646,"primary_message":"Preheat oven to 205°C (400°F). Line two baking sheet pans with parchment paper.","secondary_message":null},{"id":203647,"primary_message":"Wash, dry, and slice mushrooms.","secondary_message":"0.68 kg cremini mushrooms"},{"id":203648,"primary_message":"Preheat a large pot over medium heat.","secondary_message":null},{"id":203649,"primary_message":"Peel and mince garlic.","secondary_message":"6 cloves garlic"},{"id":203650,"primary_message":"Once the pot is hot, add oil and swirl to coat the bottom.","secondary_message":"2 tbsp extra virgin olive oil"},{"id":203651,"primary_message":"Add mushrooms and garlic to the pot; season with salt and pepper. Cook, stirring frequently, until the mushrooms are soft, 6-7 minutes.","secondary_message":"¾ tsp salt\n½ tsp black pepper"},{"id":203652,"primary_message
{"id":4786,"recipe_id":38,"serving_count":6,"cooking_minutes":40,"name":"Broccoli, Bell Pepper \u0026 Chickpea Salad with Feta \u0026 Zesty Lemon Dressing","slug":"broccoli-bell-pepper-chickpea-salad-feta-zesty-lemon-dressing","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/38/thumbnail_9d9cdd61-cdf8-47c4-94df-d83c7c326364.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/38/presentation_9d9cdd61-cdf8-47c4-94df-d83c7c326364.jpg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":48,"name":"medium saucepan","slug":"medium-saucepan"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":36,"name":"salad spinner (optional)","slug":"salad-spinner"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":58461,"primary_message":"Fill a medium saucepan about halfway with water, cover, and bring to a boil.","secondary_message":""},{"id":58460,"primary_message":"Wash broccoli, separate into bite-sized florets, and cut thick stems into smaller pieces.","secondary_message":"3 crowns broccoli"},{"id":58458,"primary_message":"Once water is boiling, add broccoli to saucepan and cook until bright green and tender-crisp, 1-2 minutes. Drain and run under cold water. Set aside to drain excess water.","secondary_message":""},{"id":58457,"primary_message":"Peel and mince garlic. Wash lemons and grate 3 tsp of zest. In a large bowl, prepare dressing by whisking together garlic, lemon zest and juice, oil, Dijon, honey, salt, and pepper.","secondary_message":"3 cloves garlic\n3 lemons\n9 tbsp extra virgin olive oil\n
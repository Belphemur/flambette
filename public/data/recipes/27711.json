{"id":27711,"recipe_id":3124,"serving_count":6,"cooking_minutes":40,"name":"Cherry Clafoutis (Crustless Fruit Tart) with Almonds \u0026 Ice Cream","slug":"cherry-clafoutis-crustless-fruit-tart-almonds-ice-cream","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3124/thumbnail_f25303ef-5349-406b-8d4b-cde53fa44bc8.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3124/presentation_f25303ef-5349-406b-8d4b-cde53fa44bc8.jpeg","cookwares":[{"id":133,"name":"ice cream scoop (optional)","slug":"ice-cream-scoop"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":124,"name":"muffin pan","slug":"muffin-pan"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":14,"name":"small saucepan","slug":"small-saucepan"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":444641,"primary_message":"Preheat oven to 190°C (375°F). Coat 6 muffin cups with butter and set aside.","secondary_message":"1 tbsp butter, unsalted"},{"id":444642,"primary_message":"Melt additional butter in a small saucepan set over medium heat. Remove from heat.","secondary_message":"3 tbsp butter, unsalted"},{"id":444643,"primary_message":"Meanwhile, place milk, eggs, sugar, and vanilla in a medium bowl, then whisk until sugar has dissolved. ","secondary_message":"133 ml whole milk\n3 eggs\n⅓ cup granulated sugar\n¾ tsp vanilla extract"},{"id":444644,"primary_message":"Add melted butter, flour, and salt to the bowl with the milk mixture. Whisk until batter is just combined (take care not to over-mix it). ","secondary_message":"½ cup all-purpose flour\n3 pinch salt"},{"id":444645,"primary_message":"Divide batter and frozen cherries between muffin cups.","secondary_message":"1 ½ cup frozen cherries"},{"id":444646,"prima
{"id":12819,"recipe_id":1494,"serving_count":6,"cooking_minutes":40,"name":"Warm Cinnamon-Apple Dessert Naan with Brown Sugar Glaze \u0026 Pecans","slug":"warm-cinnamon-apple-dessert-naan-brown-sugar-glaze-pecans","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1494/thumbnail_af8f2ab8-f7bf-40cf-8730-d1e9f8f81893.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1494/presentation_af8f2ab8-f7bf-40cf-8730-d1e9f8f81893.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":15,"name":"grater","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":48,"name":"medium saucepan","slug":"medium-saucepan"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":18,"name":"spatula","slug":"spatula"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":216161,"primary_message":"Preheat the oven to 230°C (450°F) and position racks in the upper and lower thirds of the oven.","secondary_message":null},{"id":216162,"primary_message":"Transfer naan to a large baking sheet pan. Place on the upper rack of the oven (it doesn't have to be fully heated) and bake until slightly crispy, about 10 minutes. Remove from oven.","secondary_message":"3 flatbreads or naan"},{"id":216163,"primary_message":"Meanwhile, wash and dry apples. Peel, quarter, core, and small dice; transfer to a another large baking sheet and spread out in an even layer.","secondary_message":"6 Gala apples"},{"id":216164,"primary_message":"Using a box grater, coarsely grate cold butter. Sprinkle butter, sugar, and cinnamon over the apples.","secondary_message":"3 tbsp butter, unsalted\n3 tbsp brown sugar\n¾ tsp cinnamon"},{"id":216165,"primary_message":"Place apples on the lower rack of the oven and bake until fork-tender, 15-20 minutes. Remove from oven.","secondary_message":null},{"id":216166,"primary_message":"Meanwhile, melt additional butter in a medium saucepan over low heat.","secondary_message":"¼ cup butter, unsalted"},{"id":216167,"primary_message":"Once butter is melted, whisk in cream, sugar, honey, and salt. Increase heat to medium and simmer, whisking frequently, until glaze is slightly thickened and glossy, about 3 minutes. Remove from heat, and let cool slightly to further thicken the sauce.","secondary_message":"89 ml (⅜ cup) heavy cream\n⅓ cup brown sugar\n3 tbsp honey\n3 pinch salt"},{"id":216168,"primary_message":"Roughly chop pecans.","secondary_message":"⅓ cup pecans, dry roasted"},{"id":216169,"primary_message":"To assemble, spoon baked apples over the surface of each crispy naan. Drizzle with brown sugar glaze and sprinkle with pecans. ","secondary_message":null},{"id":216170,"primary_message":"Cut naan into pieces.","secondary_message":null},{"id":216171,"primary_message":"To serve, divide naan pieces between plates and enjoy!","secondary_message":null}],"line_items":[{"id":226709,"quantity":"3","ingredient_name":"flatbreads or naan"},{"id":226711,"quantity":"6","ingredient_name":"Gala apples"},{"id":226712,"quantity":"89 ml","ingredient_name":"heavy whipping cream"},{"id":226713,"quantity":"⅓ cup","ingredient_name":"pecan halves"},{"id":226710,"quantity":"","ingredient_name":"brown sugar"},{"id":226708,"quantity":"","ingredient_name":"butter, unsalted"},{"id":226705,"quantity":"","ingredient_name":"cinnamon, ground"},{"id":226707,"quantity":"","ingredient_name":"honey"},{"id":226706,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":625.86,"alcohol":0.0,"ash":1.75,"caffeine":0.0,"water":197.49,"carbs":82.74,"fiber":6.15,"starch":33.5,"sugars":49.92,"f
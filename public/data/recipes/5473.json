{"id":5473,"recipe_id":271,"serving_count":6,"cooking_minutes":45,"name":"Turkey \u0026 Vegetable Chili with Avocado, Cheddar \u0026 Cilantro","slug":"turkey-vegetable-chili-avocado-cheddar-cilantro","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/271/thumbnail_d74ed5fa-d03e-4547-aaef-8a07ce583edd.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/271/presentation_d74ed5fa-d03e-4547-aaef-8a07ce583edd.jpg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":48,"name":"medium saucepan","slug":"medium-saucepan"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":36,"name":"salad spinner (optional)","slug":"salad-spinner"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":65666,"primary_message":"Peel and small dice onion; transfer to a medium bowl. Peel and mince garlic; add to bowl.","secondary_message":"1 ½ medium yellow onion\n9 cloves garlic"},{"id":65665,"primary_message":"Wash bell peppers, celery, and jalapeños. Seed and small dice bell peppers. Trim ends and small dice celery. Seed and mince jalapeños.","secondary_message":"3 red bell peppers\n3 sticks celery\n3 jalapeño peppers"},{"id":65664,"primary_message":"Heat a medium saucepan over medium-high heat.","secondary_message":""},{"id":65663,"primary_message":"Add oil to saucepan and swirl to coat bottom. Add onion, garlic, bell pepper, celery, and jalapeño. Cook, stirring frequently, until vegetables have softened, 3-4 minutes.","secondary_message":"3 tbsp virgin coconut oil"},{"id":65655,"primary_message":"Add ground turkey to the vegetables and cook, breaking apart with a spoon, until browned and 
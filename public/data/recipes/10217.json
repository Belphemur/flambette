{"id":10217,"recipe_id":1183,"serving_count":6,"cooking_minutes":35,"name":"Italian Tuna Salad Lettuce Wraps with Cannellini Beans \u0026 Olives","slug":"italian-tuna-salad-lettuce-wraps-cannellini-beans-olives","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1183/thumbnail_c7eeb52c-8bcf-432f-8ca2-24ada6a228ad.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1183/presentation_c7eeb52c-8bcf-432f-8ca2-24ada6a228ad.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":15,"name":"grater","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":163008,"primary_message":"Wash and dry the fresh produce.","secondary_message":"1 ½ lemons\n6 sticks celery\n1 small bunch Italian (flat-leaf) parsley\n1 ½ heads butter (Boston) lettuce"},{"id":163009,"primary_message":"Drain and rinse the beans in a colander; set aside to drain further.","secondary_message":"3 (398 ml) cans cannellini (white kidney) beans"},{"id":163010,"primary_message":"Zest and juice lemons into a large bowl.","secondary_message":null},{"id":163011,"primary_message":"Peel and mince shallots; add to the bowl with the lemon and stir to combine.","secondary_message":"3 shallots"},{"id":163012,"primary_message":"Trim celery and thinly slice crosswise at an angle; add to the bowl.","secondary_message":null},{"id":163013,"primary_message":"Thinly slice sun-dried tomatoes and add to the bowl.","secondary_message":"15 sun-dried tomatoes, oil-packed"},{"id":163014,"primary_message":"D
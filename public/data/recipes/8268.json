{"id":8268,"recipe_id":906,"serving_count":6,"cooking_minutes":35,"name":"Spicy Sweet Potato \u0026 Black Bean Burrito","slug":"spicy-sweet-potato-black-bean-burrito","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/906/thumbnail_5982a55c-7dd5-4e2a-b9bd-6f11dbad6bcc.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/906/presentation_5982a55c-7dd5-4e2a-b9bd-6f11dbad6bcc.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":15,"name":"grater","slug":"grater"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"}],"instructions":[{"id":157446,"primary_message":"Wash and dry the fresh produce.","secondary_message":"3 red bell peppers\n0.68 kg sweet potato\n1 ½ small bunches cilantro"},{"id":157447,"primary_message":"Peel and small dice onions. Small dice bell peppers. ","secondary_message":"1 ½ medium yellow onions"},{"id":157448,"primary_message":"Heat a large pot over medium heat. Once the pot is hot, add oil and swirl to coat the bottom.","secondary_message":"3 tbsp extra virgin olive oil"},{"id":157449,"primary_message":"Add onions and bell peppers to the pot; cook, stirring frequently, until softened, 3-4 minutes.","secondary_message":null},{"id":157450,"primary_message":"Peel and small dice sweet potatoes.","secondary_message":null},{"id":157451,"primary_message":"Add sweet potatoes and broth to the pot and bring to a boil; reduce heat and simmer, 10-12 minutes, until potatoes are fork-tender.","secondary_message":"1420 ml chicken or vegetable broth"},{"id":157452,"primary_message":"Drain and rinse beans in a colander; set aside to drain further.","secondary_message":"1 ½ (398 ml) cans black beans"},{"id":157453,"primary_message":"Grate cheddar. Shave cilantro leaves off the stems; discard stems and mince leaves.","secondary_message":"¾ (227 g) block cheddar cheese"},{"id":157454,"primary_message":"Once potatoes are tender, drain vegetables; return them to the pot and place on low heat.","secondary_message":null},{"id":157455,"primary_message":"Add beans, cheddar, cilantro, yogurt, and spices to the pot. Stir to combine and remove from the heat.","secondary_message":"¾ cup plain Greek yogurt\n1 ½ tbsp chili powder\n1 tsp salt\n¾ tsp onion powder\n¾ tsp garlic powder\n¾ tsp cumin\n¾ tsp cayenne pepper"},{"id":157456,"primary_message":"Lay tortillas on a flat surface. Divide vegetable mixture evenly and place in the middle of each tortilla. Fold in sides of the tortilla and roll tightly.","secondary_message":"6 large flour tortillas"},{"id":157457,"primary_message":"Heat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.","secondary_message":"2 tbsp extra virgin olive oil"},{"id":157458,"primary_message":"Lay burritos seam side down and cook for 2-3 minutes on each side, until golden brown and crispy. Work in batches if necessary.","secondary_message":null},{"id":157459,"primary_message":"Remove burritos from heat, cut in half, and enjoy!","secondary_message":null}],"line_items":[{"id":163641,"quantity":"1 ½ (398 ml) cans","ingredient_name":"black beans"},{"id":163631,"quantity":"¾ (227 g) block","ingredient_name":"cheddar cheese"},{"id":163646,"quantity":"1420 ml","ingredient_name":"chicken or vegetable broth"},{"id":163644,"quantity":"1 ½ small bunches","ingredient_name":"cilantro"},{"id":163643,"quantity":"6","ingredient_name":"large flour tortillas"},{"id":163637,"quantity":"¾ cup","ingredient_name":"plain Greek yogurt"},{"id":163639,"qu
{"id":5934,"recipe_id":414,"serving_count":6,"cooking_minutes":40,"name":"Spaghetti with Turkey Bolognese","slug":"spaghetti-turkey-bolognese","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/414/thumbnail_a4810da0-8fa4-421a-bc15-c0b27abeae07.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/414/presentation_a4810da0-8fa4-421a-bc15-c0b27abeae07.jpg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":48,"name":"medium saucepan","slug":"medium-saucepan"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":68,"name":"stainless steel sauté pan","slug":"stainless-steel-saute-pan"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"}],"instructions":[{"id":71476,"primary_message":"Fill a medium saucepan about halfway with water, cover, and bring to a boil.","secondary_message":""},{"id":71475,"primary_message":"Wash and dry the fresh produce.","secondary_message":"3 sticks celery\n1 ½ small pkg fresh basil"},{"id":71474,"primary_message":"Trim and discard the ends of the celery; small dice the celery and transfer to a medium bowl.","secondary_message":""},{"id":71473,"primary_message":"Peel and small dice the onion; add to the celery.","secondary_message":"1 ½ medium yellow onion"},{"id":71472,"primary_message":"Preheat a sauté pan over medium heat.","secondary_message":""},{"id":71471,"primary_message":"Peel and mince the garlic; transfer to a small bowl.","secondary_message":"6 cloves garlic"},{"id":71470,"primary_message":"Add olive oil to the pan and swirl to coat the bottom.","secondary_message":"3 tbsp extra virgin olive oil"},{"id":71469,"primary_message":"Add the celery and onion to the pan; cook, stirring occasionally, until they begin to soften, 2 to 4 minutes.","secondary_message":""},{"id":71468,"primary_message":"While the vegetables cook, pick the basil leaves off the stems; discard the stems and mince the leaves.","secondary_message":""},{"id":71467,"primary_message":"Add the garlic to the pan; cook until fragrant, 15 to 30 seconds.","secondary_message":""},{"id":71466,"primary_message":"Once the water is boiling, season with salt and add the pasta. Cook the pasta until desired firmness, 8 to 10 minutes. Once done, drain in a colander.","secondary_message":"3 tbsp salt\n426 g spaghetti pasta"},{"id":71465,"primary_message":"Add the ground turkey to the pan; cook, breaking apart with a spoon, until browned and crumbly, 2 to 4 minutes.","secondary_message":"1.02 kg ground turkey"},{"id":71462,"primary_message":"Add the diced tomatoes and tomato sauce to the pan; season with salt, pepper, and crushed red pepper. Increase the heat to medium-high and let the sauce simmer until thickened, 4 to 6 minutes.","secondary_message":"3 (398 ml) cans diced tomatoes\n3 (213 ml) cans tomato sauce\n1 ½ tsp salt\n¾ tsp black pepper\n⅜ tsp crushed red pepper"},{"id":71464,"primary_message":"Stir the basil and spaghetti into the sauce.","secondary_message":""},{"id":71463,"primary_message":"To serve, place the pasta into a bowl. Enjoy!","secondary_message":""}],"line_items":[{"id":75663,"quantity":"3 sticks","ingredient_name":"celery"},{"id":75661,"quantity":"3 (398 ml) cans","ingredient_name":"diced tomatoes"},{"id":75660,"quantity":"1 ½ small pkgs","ingredient_name":"fresh basil"},{"id":75664,"quantity":"6 cloves","ingredient_name":"garlic"},{"id":75662,"quantity":"1.02 kg","ingredient_name":"ground turkey"},{"id":75666,"quantity":"426 g","ingredient_name":"spaghetti pasta"},{"id":75657,"quantity":"3 (213 ml) cans","ingredient_name":"tomato sauce"},{"id":75665,"quantity":"1 ½ medium","ingredient_name":"yellow onions"},{"id":75655,"quantity":"","ingredient_name":"black pepper"},{"id":75659,"quantity":"","ingredient_name":"crushed red pepper"},{"id":75658,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":75656,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":655.38,"alcohol":0.0,"ash":8.65,"caffeine":0.0,"water":477.26,"carbs":70.59,"fiber":8.9,"starch":45.54,"sugars":12.56,"fructose":5.06,"galactose":0.12,"glucose":5.28,"lactose":0.0,"maltose":1.39,"sucrose":0.72,"sugar_alcohol":0.0,"fat":21.84,"monounsaturated":9.68,"polyunsaturated":5.27,"omega_3":0.33,"omega_6":4.94,"saturated":4.72,"transfats":0.19,"cholesterol":117.3,"protein":46.52,"alanine":2.52,"arginine":2.9,"aspartic_acid":4.27,"cystine":0.57,"glutamic_acid":10.32,"glycine":2.24,"histidine":1.27,"isoleucine":1.95,"leucine":3.59,"lysine":3.33,"methionine":1.12,"phenylalanine":1.9,"proline":2.67,"serine":1.97,"threonine":2.01,"tryptophan":0.55,"tyrosine":1.43,"valine":2.06,"b1_thiamine":1.98,"b2_riboflavin":0.76,"b3_niacin":19.29,"b5_pantothenic_acid":2.7,"b6_pyridoxine":1.5,"b12_cobalamin":1.7,"choline":126.89,"folate":223.98,"vitamin_a":1590.79,"vitamin_c":38.55,"vitamin_d":23.8,"vitamin_e":4.15,"vitamin_k":48.8,"calcium":164.66,"copper":0.66,"iron":6.88,"magnesium":124.69,"manganese":1.16,"phosphorus":560.97,"potassium":1406.37,"selenium":84.89,"sodium":154.52,"zinc":5.66}}
 until sprouts are browned, 4-5 minutes.","secondary_message":"6 tbsp butter, unsalted"},{"id":65130,"primary_message":"Add 1½ cup water to sprouts and bring to a simmer. Cook, stirring occasionally, until the sprouts are tender and liquid has evaporated, 4-5 minutes.","secondary_message":""},{"id":65129,"primary_message":"Drizzle with vinegar and season with salt and pepper. Cook, stirring occasionally, for another 1-2 minutes.","secondary_message":"6 tbsp balsamic vinegar\n1 ½ tsp salt\n¾ tsp black pepper"},{"id":65128,"primary_message":"Serve steak with brussels sprouts on a plate. Enjoy!","secondary_message":""}],"line_items":[{"id":69670,"quantity":"1.362 kg","ingredient_name":"Brussels sprouts"},{"id":69669,"quantity":"6 cloves","ingredient_name":"garlic"},{"id":69668,"quantity":"1.02 kg","ingredient_name":"ribeye steak"},{"id":69667,"quantity":"3","ingredient_name":"shallots"},{"id":69663,"quantity":"","ingredient_name":"balsamic vinegar"},{"id":69666,"quantity":"","ingredient_name":"black pepper"},{"id":69665,"quantity":"","ingredient_name":"butter, unsalted"},{"id":69662,"quantity":"","ingredient_name":"salt"},{"id":69664,"quantity":"","ingredient_name":"virgin coconut oil"}],"nutrition":{"energy":720.71,"alcohol":0.0,"ash":7.15,"caffeine":0.0,"water":326.7,"carbs":26.8,"fiber":9.28,"starch":8.24,"sugars":8.56,"fructose":3.32,"galactose":0.0,"glucose":3.21,"lactose":0.09,"maltose":0.0,"sucrose":1.92,"sugar_alcohol":0.0,"fat":53.23,"monounsaturated":19.33,"polyunsaturated":2.51,"omega_3":0.34,"omega_6":2.16,"saturated":28.38,"transfats":2.59,"cholesterol":146.54,"protein":39.74,"alanine":1.98,"arginine":2.63,"aspartic_acid":3.09,"cystine":0.37,"glutamic_acid":5.24,"glycine":1.57,"histidine":1.34,"isoleucine":1.78,"leucine":3.07,"lysine":3.34,"methionine":0.93,"phenylalanine":1.5,"proline":1.44,"serine":1.31,"threonine":1.77,"tryptophan":0.44,"tyrosine":1.18,"valine":1.95,"b1_thiamine":0.51,"b2_riboflavin":0.63,"b3_niacin":9.62,"b5_pantothenic_acid":1.59,"b6_
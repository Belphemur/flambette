{"id":29346,"recipe_id":3305,"serving_count":6,"cooking_minutes":35,"name":"Ribeye with Lemony Arugula, Sun-Dried Tomato \u0026 Shaved Parmesan Salad","slug":"ribeye-lemony-arugula-sun-dried-tomato-shaved-parmesan-salad","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3305/thumbnail_1962ea7c-b4ef-47e0-9255-05f00cc5f116.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3305/presentation_1962ea7c-b4ef-47e0-9255-05f00cc5f116.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":52,"name":"grater (optional)","slug":"grater"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":35,"name":"tongs","slug":"tongs"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":467599,"primary_message":"Preheat a large skillet over medium-high heat.","secondary_message":null},{"id":467600,"primary_message":"While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.","secondary_message":"1.02 kg ribeye steak\n1 ½ tsp salt\n¾ tsp black pepper"},{"id":467601,"primary_message":"Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.","secondary_message":"1 tbsp extra virgin olive oil"},{"id":467602,"primary_message":"Meanwhile wash, dry, zest, and juice half of the lemons into a large bowl. Cut remaining lemons into wedges and set aside for serving.","secondary_message":"3 lemons"},{"id":467603,"primary_message":"Peel and mince shallots. Add to the bowl with the lemon along with oil, salt, and pepper. Whisk to combine the dressing.","secondary_message":"2 shallots\n3 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"},{"id":467604,"primary_message":"Roughly chop sun-dried tomatoes. Add to the bowl with the dressing.","secondary_message":"12 sun-dried tomatoes, oil-packed"},{"id":467605,"primary_message":"Wash and dry arugula (skip this step if it came pre-washed). Add to the bowl.","secondary_message":"1 ½ (142 g) pkgs baby arugula"},{"id":467606,"primary_message":"Using a peeler, shave Parmesan into curls. Add to the bowl and gently toss to combine the salad.","secondary_message":"85 g Parmesan cheese"},{"id":467607,"primary_message":"Thinly slice steak against the grain.","secondary_message":null},{"id":467608,"primary_message":"Divide steak and salad between plates or bowls. Serve with lemon wedges for squeezing over the steak. Enjoy!","secondary_message":null}],"line_items":[{"id":501508,"quantity":"1 ½ (142 g) pkgs","ingredient_name":"baby arugula"},{"id":501511,"quantity":"3","ingredient_name":"lemons"},{"id":501507,"quantity":"85 g","ingredient_name":"Parmesan cheese"},{"id":501512,"quantity":"1.02 kg","ingredient_name":"ribeye steak"},{"id":501509,"quantity":"2","ingredient_name":"shallots"},{"id":501510,"quantity":"12","ingredient_name":"sun-dried tomatoes, oil-packed"},{"id":501505,"quantity":"","ingredient_name":"black pepper"},{"id":501504,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":501506,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":601.22,"alcohol":0.0,"ash":5.25,"caffeine":0.0,"water":173.11,"carbs":6.69,"fiber":1.41,"starch":0.2,"sugars":3.02,"fructose":1.22,"galactose":0.0,"glucose":0.89,"lactose":0.11,"maltose":0.0,"sucrose":0.72,"sugar_alcohol":0.0,"fat":47.87,"monounsaturated":24.12,"polyunsaturated":2.88,"omega_3":0.25,"omega_6":2.63,"saturated":18.61,"trans
{"id":21897,"recipe_id":2494,"serving_count":6,"cooking_minutes":40,"name":"Crispy Pork Schnitzel with Ranch-Dressed Apple \u0026 Broccoli Slaw","slug":"crispy-pork-schnitzel-ranch-dressed-apple-broccoli-slaw","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2494/thumbnail_63f40fec-8b12-4818-a134-506b6bde4c23.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2494/presentation_63f40fec-8b12-4818-a134-506b6bde4c23.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":52,"name":"grater (optional)","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":367898,"primary_message":"Wash and dry the fresh produce.","secondary_message":"1 small pkg chives\n1 ½ limes\n6 Granny Smith apples"},{"id":367899,"primary_message":"Mince chives and place in a large bowl.","secondary_message":null},{"id":367900,"primary_message":"Juice limes into the bowl with the chives.","secondary_message":null},{"id":367901,"primary_message":"Add yogurt, mayo, and spices to the bowl. Whisk to combine the dressing.","secondary_message":"¾ cup plain Greek yogurt\n¼ cup mayonnaise\n1 ½ tsp parsley flakes\n¾ tsp dill, dried\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"},{"id":367902,"primary_message":"Quarter and core apples; cut into matchsticks or coarsely grate. Add to the bowl with the dressing, along with the broccoli slaw, and stir to combine. Set aside.","secondary_message":"1 ½ (340 g) pkgs broccoli slaw"},{"id":367903,"primary_message":"Crack eggs into a medium bowl and beat with a whisk or fork.","secondary_message":"3 eggs"},{"id":367904,"primary_message":"Place bread crumbs on a large plate.","secondary_message":"2 ¼ cup panko bread crumbs"},{"id":367905,"primary_message":"Holding a knife parallel to the cutting board, cut the chops in half horizontally to form thin cutlets. Season cutlets with salt and pepper on both sides.","secondary_message":"6 pork chops, boneless\n1 ½ tsp salt\n¾ tsp black pepper"},{"id":367906,"primary_message":"Dip the seasoned cutlets into the beaten egg (letting the excess drip off), then into the bread crumbs, pressing to adhere. Transfer to another large plate.","secondary_message":null},{"id":367907,"primary_message":"Preheat a large skillet over medium-high heat.","secondary_message":null},{"id":367908,"primary_message":"Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add the breaded cutlets and cook until golden brown and cooked through, 2-3 minutes per side. Remove from heat.","secondary_message":"3 tbsp extra virgin olive oil"},{"id":367909,"primary_message":"To serve, divide pork schnitzel and slaw between plates. Enjoy!","secondary_message":null}],"line_items":[{"id":392445,"quantity":"1 ½ (340 g) pkgs","ingredient_name":"broccoli slaw"},{"id":392447,"quantity":"1 small pkg","ingredient_name":"chives"},{"id":392441,"quantity":"3","ingredient_name":"eggs"},{"id":392439,"quantity":"6","ingredient_name":"Granny Smith apples"},{"id":392444,"quantity":"1 ½","ingredient_name":"limes"},{"id":392442,"quantity":"¾ cup","ingredient_name":"plain Greek yogurt"},{"id":392443,"quantity":"6","ingredient_name":"pork chops, boneless"},{"id":392434,"quantity":"","ingredient_name":"black pepper"},{"id":392435,"quantity":"","ingredient_name":"dill, dried"},{"id":392433,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":392436,"quantity":"","
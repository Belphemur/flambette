{"id":10539,"recipe_id":1240,"serving_count":6,"cooking_minutes":35,"name":"Lemony White Bean Spinach Salad Topped with Feta \u0026 Pistachios","slug":"lemony-white-bean-spinach-salad-topped-feta-pistachios","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1240/thumbnail_f5021d3a-855b-4b3d-9d14-c831c07553ba.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1240/presentation_f5021d3a-855b-4b3d-9d14-c831c07553ba.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":48,"name":"medium saucepan","slug":"medium-saucepan"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":169134,"primary_message":"Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.","secondary_message":null},{"id":169135,"primary_message":"Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)","secondary_message":"6 medium carrots\n3 lemons\n3 avocados\n3 (142 g) pkg baby spinach"},{"id":169136,"primary_message":"Peel and thinly slice the carrots at an angle.","secondary_message":null},{"id":169137,"primary_message":"Once the water in the saucepan is boiling, add the carrots and cook until fork-tender, about 5 minutes. Drain and rinse under cold water and set aside.","secondary_message":null},{"id":169138,"primary_message":"Meanwhile, zest half the lemons into a large bowl, then juice all the lemons into the same bowl.","secondary_message":null},{"id":169139,"primary_message":"Peel and mince garlic; add to the bowl.","secondary_message":"3 cloves garlic"},{"id":169140,"primary_message":"Add oil and spices to the bowl; whisk to combine the dressing.","secondary_message":"⅓ cup extra virgin olive oil\n1 ½ tsp oregano\n¾ tsp salt\n¾ tsp black pepper"},{"id":169141,"primary_message":"Peel and mince the shallots; add to the bowl, stirring to combine.","secondary_message":"1 ½ shallots"},{"id":169142,"primary_message":"Halve and pit the avocados; cut the flesh into cubes while still in the skin and scoop out into the bowl. ","secondary_message":null},{"id":169143,"primary_message":"Roughly chop the pistachios and add to the bowl.","secondary_message":"¾ cup pistachios, unsalted"},{"id":169144,"primary_message":"Drain and rinse the beans in the colander with the carrots, then add both to the bowl and toss to combine the salad.","secondary_message":"3 (398 ml) cans cannellini (white kidney) beans"},{"id":169145,"primary_message":"To serve, divide spinach between plates, layer with vegetable-bean salad and top with feta cheese and pistachios. Enjoy!","secondary_message":"1 ½ (113 g) pkg crumbled feta cheese"}],"line_items":[{"id":175985,"quantity":"3","ingredient_name":"avocados"},{"id":175977,"quantity":"3 (142 g) pkg","ingredient_name":"baby spinach"},{"id":175982,"quantity":"3 (398 ml) cans","ingredient_name":"cannellini (white kidney) beans"},{"id":175984,"quantity":"6 medium","ingredient_name":"carrots"},{"id":175976,"quantity":"1 ½ (113 g) pkg","ingredient_name":"crumbled feta cheese"},{"id":175975,"quantity":"3 cloves","ingredient_name":"garlic"},{"id":175986,"quantity":"3","ingredient_name":"lemons"},{"id":175987,"quantity":"¾ cup","ingredient_name":"pistachios, unsalted"},{"id":175983,"q
er. Bring to a boil. Reduce heat to a simmer and cook until chili thickens, about 10 minutes.","secondary_message":"3 (398 ml) cans diced tomatoes\n¾ tsp salt\n¾ tsp black pepper"},{"id":61854,"primary_message":"Halve and pit avocado; scoop out and medium dice the flesh.","secondary_message":"1 ½ avocados"},{"id":61853,"primary_message":"Toast bread if desired.","secondary_message":"3 whole grain buns or rolls"},{"id":61852,"primary_message":"To serve, place chili in a bowl and garnish with avocado. Enjoy with bread!","secondary_message":""}],"line_items":[{"id":65837,"quantity":"1 ½","ingredient_name":"avocados"},{"id":65843,"quantity":"3 (398 ml) cans","ingredient_name":"diced tomatoes"},{"id":65842,"quantity":"6 cloves","ingredient_name":"garlic"},{"id":65841,"quantity":"3","ingredient_name":"jalapeño peppers"},{"id":65835,"quantity":"3 (398 ml) cans","ingredient_name":"kidney beans"},{"id":65836,"quantity":"1.02 kg","ingredient_name":"lean ground beef"},{"id":65831,"quantity":"1 ½ medium","ingredient_name":"red onions"},{"id":65840,"quantity":"3","ingredient_name":"whole grain buns or rolls"},{"id":65834,"quantity":"","ingredient_name":"black pepper"},{"id":65833,"quantity":"","ingredient_name":"chili powder"},{"id":65832,"quantity":"","ingredient_name":"cumin, ground"},{"id":65839,"quantity":"","ingredient_name":"salt"},{"id":65838,"quantity":"","ingredient_name":"virgin coconut oil"}],"nutrition":{"energy":759.46,"alcohol":0.0,"ash":8.01,"caffeine":0.0,"water":475.25,"carbs":55.55,"fiber":18.35,"starch":22.62,"sugars":14.59,"fructose":4.43,"galactose":0.05,"glucose":4.4,"lactose":0.0,"maltose":0.73,"sucrose":4.96,"sugar_alcohol":0.0,"fat":39.79,"monounsaturated":16.87,"polyunsaturated":3.02,"omega_3":0.4,"omega_6":2.38,"saturated":14.34,"transfats":1.64,"cholesterol":115.6,"protein":48.94,"alanine":2.66,"arginine":2.86,"aspartic_acid":4.8,"cystine":0.5,"glutamic_acid":8.1,"glycine":2.76,"histidine":1.42,"isoleucine":2.07,"leucine":3.64,"lysine":3.56,"methionin
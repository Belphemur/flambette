{"id":9052,"recipe_id":1041,"serving_count":6,"cooking_minutes":40,"name":"Cheesy Garlic Chicken with Broccoli \u0026 Spinach","slug":"cheesy-garlic-chicken-broccoli-spinach","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1041/thumbnail_821a09e1-96a7-432c-9470-0748e9495c22.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1041/presentation_821a09e1-96a7-432c-9470-0748e9495c22.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":126,"name":"slotted spoon","slug":"slotted-spoon"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":177387,"primary_message":"Fill a large pot about halfway with hot water (from the tap); cover and place over high heat.","secondary_message":null},{"id":177388,"primary_message":"Wash and dry the spinach. (Skip this step if it came pre-washed.)","secondary_message":"3 (142 g) pkg baby spinach"},{"id":177389,"primary_message":"Wash and separate broccoli into bite-sized florets and cut stems into smaller pieces.","secondary_message":"3 crowns broccoli"},{"id":177390,"primary_message":"Once the water in the pot is boiling, add the spinach, and stir. Cook 30-60 seconds, then remove to a colander with a slotted spoon. Rinse spinach under cold water, then press out excess water with the back of a spoon or your hands; transfer to a medium bowl.","secondary_message":null},{"id":177391,"primary_message":"When the water in the pot returns to a boil, add the broccoli, cover, and reduce heat to medium. Cook until broccoli is fork-tender, about 4 minutes. Drain and set aside.","secondary_message":null},{"id":177392,"primary_message":"Coarsely grate the mozzarella.","secondary_message":"1 ½ (227 g) blocks mozzarella cheese"},{"id":177393,"primary_message":"Preheat another large pot over medium-high heat.","secondary_message":null},{"id":177394,"primary_message":"Pat chicken dry with paper towels and cut into 1-inch pieces.","secondary_message":"1.02 kg chicken breasts, boneless skinless"},{"id":177395,"primary_message":"Once the pot is hot, add butter and swirl to coat the bottom.","secondary_message":"3 tbsp butter, unsalted"},{"id":177396,"primary_message":"Add chicken and spices to the pot. Cook, stirring occasionally, until golden and cooked through, 4-5 minutes.","secondary_message":"1 tbsp Italian seasoning\n¾ tsp crushed red pepper\n1 ½ tsp salt\n¾ tsp black pepper"},{"id":177397,"primary_message":"Meanwhile, peel and mince the garlic. When the chicken is done, add the garlic to the skillet and cook 1 minute more.","secondary_message":"9 cloves garlic"},{"id":177398,"primary_message":"Add spinach, broccoli, mozzarella, and ricotta to the pot; continue to cook, stirring frequently, until cheese is melted and starting to bubble.","secondary_message":"1 ½ (425 g) pkgs ricotta cheese"},{"id":177399,"primary_message":"To serve, divide chicken sauté between plates, sprinkle with crushed red pepper, and enjoy!","secondary_message":"3 pinch crushed red pepper"}],"line_items":[{"id":184936,"quantity":"3 (142 g) pkg","ingredient_name":"baby spinach"},{"id":184944,"quantity":"3 crowns","ingredient_name":"broccoli"},{"id":184938,"quantity":"1.02 kg","ingredient_name":"chicken breasts, boneless skinless"},{"id":184935,"quantity":"9 cloves","ingredient_name":"garlic"},{"id":184939,"quantity":"1 ½ (227 g) blocks","ingredient_name":"mozzarella cheese"},{"id":184937,"quantity":"1 ½ (425 g) pkgs","ingredient_name":"ricotta cheese"},{"id":184940,"quantity":"","ingredient_name":"black pepper"},{"id":184945,"quantity":"","ingr
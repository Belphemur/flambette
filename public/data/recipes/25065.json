{"id":25065,"recipe_id":2811,"serving_count":6,"cooking_minutes":35,"name":"Lemon-Ricotta Flatbread with Crisp Asparagus and Prosciutto","slug":"lemon-ricotta-flatbread-crisp-asparagus-prosciutto","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2811/thumbnail_d89f0e4d-5e31-4f02-8246-512e69c27f49.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2811/presentation_d89f0e4d-5e31-4f02-8246-512e69c27f49.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":52,"name":"grater (optional)","slug":"grater"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":402644,"primary_message":"Preheat oven to 230°C (450°F).","secondary_message":null},{"id":402645,"primary_message":"Wash, dry, and zest lemons into a medium bowl (reserve lemons for later use).","secondary_message":"1 ½ lemons"},{"id":402646,"primary_message":"Add ricotta, salt, and pepper to the bowl with the lemon zest. Stir to combine and set aside.","secondary_message":"1 ½ (425 g) pkgs ricotta cheese\n¾ tsp salt\n¾ tsp black pepper"},{"id":402647,"primary_message":"Divide flatbreads between two large baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until flatbreads are slightly crispy, 8-10 minutes. Remove from oven and set aside.","secondary_message":"6 flatbreads or naan"},{"id":402648,"primary_message":"Meanwhile, peel and mince shallot. Place in a large bowl.","secondary_message":"1 shallot"},{"id":402649,"primary_message":"Juice reserved lemons into the bowl with the shallot. Add oil, salt, and pepper, then whisk to combine the dressing.","secondary_message":"2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"},{"id":402650,"primary_message":"Wash, dry, and snap (or cut) off woody ends of the asparagus; cut spears crosswise into thin coins. Add to the bowl with the dressing.","secondary_message":"3 small bunches asparagus"},{"id":402651,"primary_message":"Chop (or tear) prosciutto into bite-sized pieces. Add to the bowl and stir to combine the salad. ","secondary_message":"12 slices prosciutto"},{"id":402652,"primary_message":"Spread the lemon ricotta over each flatbread, then top with asparagus-prosciutto salad.","secondary_message":null},{"id":402653,"primary_message":"To serve, cut flatbreads into wedges and divide between plates. Enjoy!","secondary_message":null}],"line_items":[{"id":430509,"quantity":"3 small bunches","ingredient_name":"asparagus"},{"id":430516,"quantity":"6","ingredient_name":"flatbreads or naan"},{"id":430515,"quantity":"1 ½","ingredient_name":"lemons"},{"id":430517,"quantity":"12 slices","ingredient_name":"prosciutto"},{"id":430510,"quantity":"1 ½ (425 g) pkgs","ingredient_name":"ricotta cheese"},{"id":430514,"quantity":"1","ingredient_name":"shallot"},{"id":430512,"quantity":"","ingredient_name":"black pepper"},{"id":430511,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":430513,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":705.36,"alcohol":0.0,"ash":5.23,"caffeine":0.0,"water":258.35,"carbs":64.28,"fiber":4.88,"starch":49.3,"sugars":8.55,"fructose":1.33,"galactose":0.61,"glucose":0.95,"lactose":3.79,"maltose":0.0,"sucrose":0.8,"sugar_alcohol":0.0,"fat":36.58,"monounsaturated":10.8,"polyunsaturated":1.95,"omega_3":0.26,"omega_6":1.69,"saturated":19.61,"transfats":0.93,"cholesterol":111.29,"protein":32.46,"alanine":1.04,"argin
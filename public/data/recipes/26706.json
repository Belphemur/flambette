{"id":26706,"recipe_id":3020,"serving_count":6,"cooking_minutes":40,"name":"Lemony Peach Cobbler with Vanilla Ice Cream","slug":"lemony-peach-cobbler-vanilla-ice-cream","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3020/thumbnail_09cf4537-810b-42e1-8d76-b45e74f42410.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3020/presentation_09cf4537-810b-42e1-8d76-b45e74f42410.jpeg","cookwares":[{"id":83,"name":"baking dish","slug":"baking-dish"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":52,"name":"grater (optional)","slug":"grater"},{"id":133,"name":"ice cream scoop (optional)","slug":"ice-cream-scoop"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":48,"name":"medium saucepan","slug":"medium-saucepan"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":431801,"primary_message":"Preheat oven to 230°C (450°F). Coat a large baking dish with butter. ","secondary_message":"1 ½ tsp butter, unsalted"},{"id":431802,"primary_message":"Wash, dry, and quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into ½-inch thick wedges. Transfer to the baking dish and spread out in an even layer.","secondary_message":"6 peaches"},{"id":431803,"primary_message":"Wash, dry, zest, and juice lemons over peaches in the baking dish; set aside. ","secondary_message":"1 ½ lemons"},{"id":431804,"primary_message":"Place flour, milk, sugar, baking powder, and salt in a medium bowl. Stir to combine.","secondary_message":"1 ½ cup all-purpose flour\n266 ml whole milk\n½ cup brown sugar\n2 ½ tsp baking powder\n¼ tsp salt"},{"id":431805,"primary_message":"Place butter in a small saucepan set over medium-low and heat. Once the butter is melted, add to the bowl with the flour and stir to combine the topping (being careful not to over-mix).","secondary_message":"½ cup butter, unsalted"},{"id":431806,"primary_message":"Spoon topping over the peaches, then spread out evenly. Sprinkle additional sugar on top. ","secondary_message":"1 tbsp brown sugar"},{"id":431807,"primary_message":"Place cobbler in the oven and bake until topping is golden brown and peaches are tender, about 20 minutes. Remove from oven. ","secondary_message":null},{"id":431808,"primary_message":"To serve, divide peach cobbler and ice cream between bowls. Enjoy!","secondary_message":"1065 ml vanilla ice cream"}],"line_items":[{"id":463018,"quantity":"1 ½","ingredient_name":"lemons"},{"id":463019,"quantity":"6","ingredient_name":"peaches"},{"id":463022,"quantity":"1065 ml","ingredient_name":"vanilla ice cream"},{"id":463017,"quantity":"266 ml","ingredient_name":"whole milk"},{"id":463016,"quantity":"","ingredient_name":"all-purpose flour"},{"id":463021,"quantity":"","ingredient_name":"baking powder"},{"id":463020,"quantity":"","ingredient_name":"brown sugar"},{"id":463015,"quantity":"","ingredient_name":"butter, unsalted"},{"id":463014,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":666.61,"alcohol":0.0,"ash":3.71,"caffeine":0.0,"water":254.67,"carbs":88.75,"fiber":3.96,"starch":23.14,"sugars":59.32,"fructose":2.69,"galactose":0.09,"glucose":3.36,"lactose":2.45,"maltose":0.15,"sucrose":29.24,"sugar_alcohol":0.0,"fat":31.81,"monounsaturated":8.29,"polyunsaturated":1.5,"omega_3":0.29,"omega_6":1.21,"saturated":19.51,"transfats":0.8,"cholesterol":98.08,"protein":9.88,"alanine":0.33,"arginine":0.33,"aspartic_acid":1.16,"cystine":0.13,"glutamic_acid":2.24,"glycine":0.28,"histidine":0.23,"isoleucine":0.42,"leucine":0.74,"lysine":0.51,"methionine":0.21,"phenylalanine":0.44,"proline":0.9,"serine":0.49,"thre
{"id":24333,"recipe_id":2715,"serving_count":6,"cooking_minutes":35,"name":"Tortilla Chip-Crusted Chicken Salad with Tomatoes, Cheese \u0026 Ranch","slug":"tortilla-chip-crusted-chicken-salad-tomatoes-cheese-ranch","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2715/thumbnail_0e3ecb6c-4a11-4d69-a5e2-9dcc4ba50290.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2715/presentation_0e3ecb6c-4a11-4d69-a5e2-9dcc4ba50290.jpeg","cookwares":[{"id":90,"name":"aluminum foil","slug":"aluminum-foil"},{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"}],"instructions":[{"id":419391,"primary_message":"Preheat oven to 220°C (425°F). Line a large baking sheet pan with aluminum foil and coat with a thin layer of oil; set aside. ","secondary_message":"1 tbsp extra virgin olive oil"},{"id":419392,"primary_message":"Place tortilla chips in a medium bowl and crush with the back of a spoon to create coarse crumbs. Add spices and stir to combine the coating.","secondary_message":"170 g tortilla chips\n¼ cup taco seasoning\n¾ tsp salt\n½ tsp black pepper"},{"id":419393,"primary_message":"Pat chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets.","secondary_message":"1.02 kg chicken breasts, boneless skinless"},{"id":419394,"primary_message":"Spread mayo over both sides of the cutlets, then dredge in the coating, pressing gently to adhere. Transfer cutlets to the baking sheet.","secondary_message":"3 tbsp mayonnaise"},{"id":419395,"primary_message":"Place baking sheet in the oven (it doesn't have to be fully heated) and bake, flipping chicken halfway through, until golden and cooked through, 15-18 minutes. Remove from oven.","secondary_message":null},{"id":419396,"primary_message":"Meanwhile, wash and dry tomatoes. Using a clean cutting board, medium dice, and place in a large bowl.","secondary_message":"3 tomatoes"},{"id":419397,"primary_message":"Wash, dry, and chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the tomato, toss to combine the salad, and set aside.","secondary_message":"6 hearts romaine hearts"},{"id":419398,"primary_message":"When the chicken is done, slice into strips.","secondary_message":null},{"id":419399,"primary_message":"To serve, divide salad between plates or bowls, then top with cheese and chicken. Drizzle with dressing. Enjoy!","secondary_message":"1 ½ cups shredded cheese, Mexican blend\n¾ cup ranch dressing"}],"line_items":[{"id":449098,"quantity":"1.02 kg","ingredient_name":"chicken breasts, boneless skinless"},{"id":449104,"quantity":"¾ cup","ingredient_name":"ranch dressing"},{"id":449107,"quantity":"6 hearts","ingredient_name":"romaine hearts"},{"id":449106,"quantity":"1 ½ cups","ingredient_name":"shredded cheese, Mexican blend"},{"id":449105,"quantity":"67 ½ ml","ingredient_name":"taco seasoning"},{"id":449102,"quantity":"3","ingredient_name":"tomatoes"},{"id":449108,"quantity":"170 g","ingredient_name":"tortilla chips"},{"id":449100,"quantity":"","ingredient_name":"black pepper"},{"id":449099,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":449103,"quantity":"","ingredient_name":"mayonnaise"},{"id":449101,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":698.75,"alcohol":0.0,"ash":7.16,"caffeine":0.0,"water":318.53,"carbs":31.77,"fiber":5.42,"starch":17.41,"sugars":5.94,"fructose":2.01,"galactose"
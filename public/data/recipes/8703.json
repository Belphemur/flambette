{"id":8703,"recipe_id":980,"serving_count":6,"cooking_minutes":40,"name":"Creamy Herbed Pumpkin Pasta with Garlic Green Beans","slug":"creamy-herbed-pumpkin-pasta-garlic-green-beans","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/980/thumbnail_19457e33-3da5-4edf-a8d3-172d60fe695c.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/980/presentation_19457e33-3da5-4edf-a8d3-172d60fe695c.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":14,"name":"small saucepan","slug":"small-saucepan"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":133708,"primary_message":"Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.","secondary_message":"1 tbsp salt\n425 g rotini pasta"},{"id":133709,"primary_message":"Peel and mince the garlic. ","secondary_message":"12 cloves garlic"},{"id":133710,"primary_message":"Wash the green beans and trim ends. ","secondary_message":"1.36 kg green beans"},{"id":133711,"primary_message":"Add water to a large skillet and bring to a boil, covered, over high heat.","secondary_message":"¾ cup water"},{"id":133712,"primary_message":"Once the water is boiling, uncover and stir in the beans, oil, butter, and half the garlic. Simmer until beans are tender and water has evaporated, 4-5 minutes. Season with salt, then remove from heat and set aside. ","secondary_message":"1 tbsp extra virgin olive oil\n2 tbsp butter, unsalted\n¾ tsp salt"},{"id":133713,"primary_message":"Preheat a medium saucepan over medium heat.","secondary_message":null},{"id":133714,"primary_message":"Once the saucepan is hot, add oil and swirl to coat the bottom.","secondary_message":"3 tbsp extra virgin olive oil"},{"id":133715,"primary_message":"Add remaining garlic to the saucepan and cook for 1 minute, then add the tomato paste and cook for an additional 30 seconds, stirring frequently.","secondary_message":"3 tbsp tomato paste"},{"id":133716,"primary_message":"Add the pumpkin, milk, and spices to the saucepan. Whisk to combine and let simmer for 5-6 minutes. ","secondary_message":"1 ½ (398 ml) cans pure pumpkin purée\n710 ml whole milk\n11 ¼ ml onion powder\n1 ½ tsp garlic powder\n11 ¼ ml basil\n¾ tsp salt"},{"id":133717,"primary_message":"Grate the parmesan. ","secondary_message":"85 g Parmesan cheese"},{"id":133718,"primary_message":"Add the parmesan cheese (reserving a small amount for garnish) and red pepper flakes to the saucepan; stir to combine. Remove from the heat and set aside.","secondary_message":"¾ tsp crushed red pepper"},{"id":133719,"primary_message":"Once the pasta is done, drain and return to the large pot. Pour the sauce into the pot with the pasta and stir to combine. ","secondary_message":null},{"id":133720,"primary_message":"To serve, divide the pasta and green beans between plates. Top pasta with remaining Parmesan and enjoy! ","secondary_message":null}],"line_items":[{"id":138850,"quantity":"12 cloves","ingredient_name":"garlic"},{"id":138858,"quantity":"1.36 kg","ingredient_name":"green beans"},{"id":138861,"quantity":"85 g","ingredient_name":"Parmesan cheese"},{"id":138857,"quantity":"1 ½ (398 ml) cans","ingredient_name":"pure pumpkin purée"},{"id":138852,"quantity":"425 g","ingredient_name":"rotini pasta"},{"id"
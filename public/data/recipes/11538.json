{"id":11538,"recipe_id":1352,"serving_count":6,"cooking_minutes":40,"name":"Chopped Veggie Salad with Sun-Dried Tomato Dressing \u0026 Breadsticks ","slug":"chopped-veggie-salad-sun-dried-tomato-dressing-breadsticks","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1352/thumbnail_ff58522d-8278-4114-811b-83be0518b919.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1352/presentation_ff58522d-8278-4114-811b-83be0518b919.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":35,"name":"tongs","slug":"tongs"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":221646,"primary_message":"Preheat oven to 220°C (425°F).","secondary_message":null},{"id":221647,"primary_message":"Wash and dry the fresh produce.","secondary_message":"2 lemons\n3 medium carrots\n6 sticks celery\n1 ½ English cucumbers\n3 tomatoes\n1 ½ heads romaine lettuce\n1 small bunch Italian (flat-leaf) parsley"},{"id":221648,"primary_message":"Peel and mince garlic. Mince the sun-dried tomatoes. Add both to a large salad bowl.","secondary_message":"6 cloves garlic\n27 sun-dried tomatoes, oil-packed"},{"id":221649,"primary_message":"Zest and juice 1½ lemons into the salad bowl. Thinly slice remaining lemon into rounds and set aside for garnish.","secondary_message":null},{"id":221650,"primary_message":"Add oil, honey, Dijon, and spices to the bowl; whisk to combine the dressing. ","secondary_message":"½ cup extra virgin olive oil\n2 ½ tsp honey\n2 ½ tsp Dijon mustard\n2 ½ tsp salt\n¾ tsp oregano\n¾ tsp black pepper"},{"id":221651,"primary_message":"Drizzle 1 tbsp dressing over each flatbread, then cut into 1½-inch wide strips and place on a large baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake until crispy, 8-10 minutes. Remove from the oven.","secondary_message":"3 flatbreads or naan"},{"id":221652,"primary_message":"Meanwhile, peel, halve, and thinly slice the onion. Peel and thinly slice carrots into rounds. Add both to the bowl with the dressing.","secondary_message":"1 medium red onion"},{"id":221653,"primary_message":"Trim celery, then cut crosswise into ¼-inch pieces. Add to the bowl.","secondary_message":null},{"id":221654,"primary_message":"Trim and medium dice cucumbers. Medium dice tomatoes; add both to the bowl.","secondary_message":null},{"id":221655,"primary_message":"Halve romaine leaves lengthwise, then thinly slice crosswise into shreds; add to the bowl.","secondary_message":null},{"id":221656,"primary_message":"Shave parsley leaves off the stems; discard stems and add leaves to the bowl.","secondary_message":null},{"id":221657,"primary_message":"Drain and rinse the beans; add to the bowl.","secondary_message":"1 ½ (398 ml) cans garbanzo beans (chickpeas)"},{"id":221658,"primary_message":"Drain and thinly slice artichokes; add to the bowl and toss to combine the salad.","secondary_message":"3 (170 ml) jars artichoke hearts, marinated"},{"id":221659,"primary_message":"To serve, divide salad between plates and top with feta. Serve with breadsticks and lemon slices. Enjoy! ","secondary_message":"1 ½ (113 g) pkg crumbled feta cheese"}],"line_items":[{"id":232530,"quantity":"3 (170 ml) jars","ingredient_name":"artichoke hearts, ma
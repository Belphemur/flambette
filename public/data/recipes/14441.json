{"id":14441,"recipe_id":1688,"serving_count":6,"cooking_minutes":45,"name":"Curried Coconut-Red Lentil Soup with Veggies, Cilantro \u0026 Yogurt","slug":"curried-coconut-red-lentil-soup-veggies-cilantro-yogurt","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1688/thumbnail_dea0c16c-2b1d-4640-8754-0d2872873e65.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1688/presentation_dea0c16c-2b1d-4640-8754-0d2872873e65.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":57,"name":"ladle","slug":"ladle"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"}],"instructions":[{"id":256390,"primary_message":"Wash and dry the fresh produce.","secondary_message":"6 medium carrots\n3 medium zucchini squash\n1 small bunch cilantro"},{"id":256391,"primary_message":"Peel and small dice onions; transfer to a large bowl.","secondary_message":"1 ½ medium red onions"},{"id":256392,"primary_message":"Peel, trim, and small dice carrots; add to the bowl with the onion.","secondary_message":null},{"id":256393,"primary_message":"Trim and small dice zucchini; add to the bowl.","secondary_message":null},{"id":256394,"primary_message":"Preheat a large pot over medium-high heat.","secondary_message":null},{"id":256395,"primary_message":"While the pot heats up, peel and mince garlic.","secondary_message":"6 cloves garlic"},{"id":256396,"primary_message":"Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, garlic, curry powder, and salt to the pot; cook, stirring often, until starting to soften, about 5 minutes.","secondary_message":"¼ cup virgin coconut oil\n¼ cup curry powder\n1 tbsp salt"},{"id":256397,"primary_message":"Add broth, coconut milk, tomatoes, and lentils to the pot; stir to combine, cover, and bring to a boil. ","secondary_message":"2129 ml chicken or vegetable broth\n1 ½ (398 ml) cans coconut milk\n1 ½ (398 ml) cans diced tomatoes\n2 ¼ cup red lentils, dried"},{"id":256398,"primary_message":"Once the soup is boiling, reduce heat to medium-low; simmer, stirring occasionally, until lentils and veggies are tender, 15-20 minutes. Remove from heat.","secondary_message":null},{"id":256399,"primary_message":"Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.","secondary_message":null},{"id":256400,"primary_message":"When the soup is done, add cilantro and stir to combine.","secondary_message":null},{"id":256401,"primary_message":"To serve, divide soup between bowls, top with yogurt, and enjoy!","secondary_message":"¾ cup plain Greek yogurt"}],"line_items":[{"id":269827,"quantity":"6 medium","ingredient_name":"carrots"},{"id":269830,"quantity":"2129 ml","ingredient_name":"chicken or vegetable broth"},{"id":269829,"quantity":"1 small bunch","ingredient_name":"cilantro"},{"id":269820,"quantity":"1 ½ (398 ml) cans","ingredient_name":"coconut milk"},{"id":269823,"quantity":"1 ½ (398 ml) cans","ingredient_name":"diced tomatoes"},{"id":269819,"quantity":"6 cloves","ingredient_name":"garlic"},{"id":269824,"quantity":"¾ cup","ingredient_name":"plain Greek yogurt"},{"id":269828,"quantity":"1 ½ medium","ingredient_name":"red onions"},{"id":269826,"quantity":"3 medium","ingredient_name":"zucchini squash"},{"id":269821,"quantity":"","ingredient_name":"curry powder"},{"id":269831,"quantity":"","ingredient_name":"red lentils, dried"},{"id":269822,"quantity":"","ingredient_name":"salt"},{"id":269825,"quantity":"","ingredient_name":"virgin coconut oil"}],"nutrit
{"id":7188,"recipe_id":712,"serving_count":6,"cooking_minutes":30,"name":"Bean \u0026 Pasta Fagioli Soup","slug":"bean-pasta-fagioli-soup","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/712/thumbnail_519d6bf2-5d1b-4223-9fdb-65e17ac95059.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/712/presentation_519d6bf2-5d1b-4223-9fdb-65e17ac95059.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":48,"name":"medium saucepan","slug":"medium-saucepan"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"}],"instructions":[{"id":100349,"primary_message":"Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, about 8-10 minutes (or according to package directions). When done, drain pasta; set aside.","secondary_message":"340 g macaroni (elbow) pasta\n1 ½ tsp salt"},{"id":100350,"primary_message":"Wash and dry the fresh produce.","secondary_message":"3 medium carrots\n1 ½ medium zucchini squash\n3 sticks celery"},{"id":100351,"primary_message":"Peel and mince the garlic.","secondary_message":"3 cloves garlic"},{"id":100352,"primary_message":"Peel and small dice the carrot. Small dice the zucchini and celery.","secondary_message":null},{"id":100353,"primary_message":"Heat a large pot over medium-low heat. Add oil and swirl to coat the bottom.","secondary_message":"3 tbsp extra virgin olive oil"},{"id":100354,"primary_message":"Add the minced garlic, carrots, zucchini, celery, and onion powder.","secondary_message":"1 tbsp onion powder"},{"id":1003
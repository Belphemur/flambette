{"id":21012,"recipe_id":2402,"serving_count":6,"cooking_minutes":30,"name":"Indian Egg, Tomato \u0026 Spinach Curry with Toasted Naan Bread","slug":"indian-egg-tomato-spinach-curry-toasted-naan-bread","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2402/thumbnail_8a160cd1-aa98-422a-b6f3-12d16523ad22.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2402/presentation_8a160cd1-aa98-422a-b6f3-12d16523ad22.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":77,"name":"toaster (optional)","slug":"toaster"}],"instructions":[{"id":360323,"primary_message":"Preheat a large pot over medium heat.","secondary_message":null},{"id":360324,"primary_message":"While the pot heats up, peel, halve, and small dice onions. ","secondary_message":"1 ½ medium yellow onions"},{"id":360325,"primary_message":"Once the pot is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until softened, 3-4 minutes. ","secondary_message":"2 tbsp extra virgin olive oil"},{"id":360326,"primary_message":"Add marinara, water, spices, and sugar to the pot. Stir to combine the curry and bring to a simmer. Once simmering, reduce heat to low and cook, stirring occasionally, until slightly thickened, 8-10 minutes. ","secondary_message":"1 ½ (680 g) jars marinara sauce\n1 ½ cup water\n2 tbsp garam masala\n1 ½ tsp garlic powder\n1 ½ tsp salt\n1 ½ tsp brown sugar"},{"id":360327,"primary_message":"Meanwhile, halve eggs and place in a medium bowl; set aside. ","secondary_message":"12 hard-cooked eggs, peeled"},{"id":360328,"primary_message":"Wash and dry spinach (skip this step if it came pre-washed).","secondary_message":"1 ½ (142 g) pkg baby spinach"},{"id":360329,"primary_message":"Wash and dry cilantro. Shave leaves off the stems; discard stems and mince the leaves. ","secondary_message":"1 small bunch cilantro"},{"id":360330,"primary_message":"Once the curry has thickened, add spinach and cilantro to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.","secondary_message":null},{"id":360331,"primary_message":"Add eggs to the curry, gently stir to combine, and continue to cook until warmed through, 3-4 minutes more. Remove from heat.","secondary_message":null},{"id":360332,"primary_message":"Meanwhile, toast naan if desired, then cut into wedges. ","secondary_message":"6 flatbreads or naan"},{"id":360333,"primary_message":"Divide curry between bowls and serve with naan on the side. Enjoy!","secondary_message":null}],"line_items":[{"id":384934,"quantity":"1 ½ (142 g) pkg","ingredient_name":"baby spinach"},{"id":384939,"quantity":"1 small bunch","ingredient_name":"cilantro"},{"id":384940,"quantity":"6","ingredient_name":"flatbreads or naan"},{"id":384942,"quantity":"12","ingredient_name":"hard-cooked eggs, peeled"},{"id":384943,"quantity":"1 ½ (680 g) jars","ingredient_name":"marinara sauce"},{"id":384938,"quantity":"1 ½ medium","ingredient_name":"yellow onions"},{"id":384941,"quantity":"","ingredient_name":"brown sugar"},{"id":384935,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":384944,"quantity":"","ingredient_name":"garam masala"},{"id":384936,"quantity":"","ingredient_name":"garlic powder"},{"id":384937,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":673.85,"alcohol":0.0,"ash":8.07,"caffeine":0.0,"water":338.24,"carbs":75.25,"fiber":6.81,"starch":49.44,"sugars":5.94,"fructose":4.5,"galactose":0.64,"glucose":4.6,"lactose":1.59,"maltose":0.0,"sucrose":3.06,"sugar_alcohol":0.0,"fat":
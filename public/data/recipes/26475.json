{"id":26475,"recipe_id":3000,"serving_count":6,"cooking_minutes":35,"name":"Hawaiian-Style Ham \u0026 Pineapple Pita Pizza with Spinach Salad","slug":"hawaiian-style-ham-pineapple-pita-pizza-spinach-salad","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3000/thumbnail_a7bfa19c-1ad1-4819-be32-74f32d3751eb.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3000/presentation_a7bfa19c-1ad1-4819-be32-74f32d3751eb.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"}],"instructions":[{"id":429742,"primary_message":"Preheat oven to 220°C (425°F).","secondary_message":null},{"id":429743,"primary_message":"Wash, dry, and cut off skin from each pineapple; quarter, core, and small dice. Divide pineapple between one medium bowl and one large bowl. (Set the large bowl aside for the salad.)","secondary_message":"1 ½ small pineapples"},{"id":429744,"primary_message":"Small dice ham. Add to the medium bowl with the pineapple, stir to combine the pizza toppings, and set aside. ","secondary_message":"680 g ham steak, boneless"},{"id":429745,"primary_message":"Place tomato sauce and spices in another medium bowl. Stir to combine.","secondary_message":"3 (213 ml) cans tomato sauce\n1 tbsp Italian seasoning\n¾ tsp salt\n3 pinch black pepper"},{"id":429746,"primary_message":"Divide pitas between two baking sheet pans; evenly spread with tomato sauce, then top w
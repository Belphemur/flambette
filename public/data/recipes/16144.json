{"id":16144,"recipe_id":1900,"serving_count":6,"cooking_minutes":30,"name":"Pasta Salad with Peaches, White Beans, Radish, Arugula \u0026 Goat Cheese","slug":"pasta-salad-peaches-white-beans-radish-arugula-goat-cheese","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1900/thumbnail_4d7c9d9d-b093-4fc3-9a0a-1005025985db.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1900/presentation_4d7c9d9d-b093-4fc3-9a0a-1005025985db.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":52,"name":"grater (optional)","slug":"grater"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":264735,"primary_message":"Fill a large pot halfway with water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.","secondary_message":"1 ½ tsp salt\n425 g penne pasta"},{"id":264736,"primary_message":"Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)","secondary_message":"1 ½ lemons\n1 ½ bunches radish\n6 peaches\n1 small pkg fresh basil\n1 ½ (142 g) pkg baby arugula"},{"id":264737,"primary_message":"Drain and rinse the beans in a colander; set aside to drain further.","secondary_message":"3 (398 ml) cans cannellini (white kidney) beans"},{"id":264738,"primary_message":"Zest and juice lemons into a large bowl. Add oil, Dijon, honey, salt, and pepper; whisk to combine the dressing.","secondary_message":"¼ cup extra virgin olive oil\n1 ½ tbsp Dijon mustard\n1 tbsp honey\n1 ½ tsp salt\n½ tsp black pepper"},{"id":264739,"primary_message":"Peel, halve, and slice shallots lengthwise into very thin strips; add to the bowl with the dressing and stir to combine.","secondary_message":"2 shallots"},{"id":264740,"primary_message":"Add beans to the bowl.","secondary_message":null},{"id":264741,"primary_message":"Trim and thinly slice radishes; add to the bowl.","secondary_message":null},{"id":264742,"primary_message":"Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice and add to the bowl.","secondary_message":null},{"id":264743,"primary_message":"Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.","secondary_message":null},{"id":264744,"primary_message":"When the pasta is done, drain and rinse under cold water to cool.","secondary_message":null},{"id":264745,"primary_message":"Add pasta and arugula to the bowl; toss to combine the pasta salad.","secondary_message":null},{"id":264746,"primary_message":"To serve, divide pasta salad between plates or bowls. Crumble goat cheese over top and enjoy!","secondary_message":"1 ½ (113 g) logs goat cheese"}],"line_items":[{"id":279246,"quantity":"1 ½ (142 g) pkg","ingredient_name":"baby arugula"},{"id":279242,"quantity":"3 (398 ml) cans","ingredient_name":"cannellini (white kidney) beans"},{"id":279237,"quantity":"1 small pkg","ingredient_name":"fresh basil"},{"id":279245,"quantity":"1 ½ (113 g) logs","ingredient_name":"goat cheese"},{"id":279248,"quantity":"1 ½","ingredient_name":"lemons"},{"id":279249,"quantity":"6","ingredient_name":"peaches"},{"id":279239,"quantity":"425 g","ingredient_name":"penne pasta"},{"id":279250,"quantity":"1 ½ bunches","ingredient_name":"radish"},{"id":279247,"quantity":"2","ingredient_name":"shallots"},{"id
{"id":14486,"recipe_id":1694,"serving_count":6,"cooking_minutes":30,"name":"Smoked Salmon Salad with Edamame, Mango, Pear, Avocado \u0026 Pecans","slug":"smoked-salmon-salad-edamame-mango-pear-avocado-pecans","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1694/thumbnail_884d850f-bc95-48c9-92f3-98ddeb04c65c.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1694/presentation_884d850f-bc95-48c9-92f3-98ddeb04c65c.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":35,"name":"tongs","slug":"tongs"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":240103,"primary_message":"Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)","secondary_message":"1 ½ lemons\n3 mangoes\n3 avocados\n3 pears\n3 (142 g) pkg spring mix (mixed greens)"},{"id":240104,"primary_message":"Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.","secondary_message":"3 cups edamame"},{"id":240105,"primary_message":"Juice lemons into a large bowl. Add oil, vinegar, Dijon, maple syrup, salt, and pepper; whisk to combine the dressing.","secondary_message":"3 tbsp extra virgin olive oil\n2 tbsp white wine vinegar\n1 tbsp Dijon mustard\n1 tbsp pure maple syrup\n1 ½ tsp salt\n¾ tsp black pepper"},{"id":240106,"primary_message":"Peel mangoes and slice flesh away from the pit, starting with the flat sides; medium dice and add to the bowl with the dressing.","secondary_message":null},{"id":240107,"primary_message":"Halve and pit avocados; slice crosswise while still in the skin and scoop out with a spoon. Add to the bowl.","secondary_message":null},{"id":240108,"primary_message":"Quarter, core, and medium dice pears; add to the bowl.","secondary_message":null},{"id":240109,"primary_message":"Roughly chop pecans and add to the bowl.","secondary_message":"¾ cup pecans, dry roasted"},{"id":240110,"primary_message":"Chop or tear salmon into bite-sized pieces and add to the bowl.","secondary_message":"3 (113 g) pkg smoked salmon"},{"id":240111,"primary_message":"Add mixed greens and edamame to the bowl; toss to combine the salad.","secondary_message":null},{"id":240112,"primary_message":"To serve, divide salad between plates or bowls and enjoy!","secondary_message":null}],"line_items":[{"id":252396,"quantity":"3","ingredient_name":"avocados"},{"id":252401,"quantity":"3 cups","ingredient_name":"edamame"},{"id":252397,"quantity":"1 ½","ingredient_name":"lemons"},{"id":252398,"quantity":"3","ingredient_name":"mangoes"},{"id":252399,"quantity":"3","ingredient_name":"pears"},{"id":252400,"quantity":"¾ cup","ingredient_name":"pecan halves"},{"id":252402,"quantity":"3 (113 g) pkg","ingredient_name":"smoked salmon"},{"id":252395,"quantity":"3 (142 g) pkg","ingredient_name":"spring mix (mixed greens)"},{"id":252390,"quantity":"","ingredient_name":"black pepper"},{"id":252393,"quantity":"","ingredient_name":"Dijon mustard"},{"id":252389,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":252392,"quantity":"","ingredient_name":"pure maple syrup"},{"id":252391,"quantity":"","ingredient_name":"salt"},{"id":252394,"quantity":"","ingredient_name":"white wine vinegar"}],"nutrition":{"energy":658.25,"alcohol":0.0,"ash":7.56,"caffeine":0.0,"water":471.42,"carbs":61.77,"fiber":19.1,"starch":4.01,"sugars":37.53,"fructose":14.31,"galactose":0.12,"glucose":6.51,"lactose":0.0,"maltose":0.74,"sucrose":15.84,"sugar_alcohol":0.0,"fat":39.39,"monounsaturated":23.44,"pol
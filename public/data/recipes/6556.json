{"id":6556,"recipe_id":681,"serving_count":6,"cooking_minutes":50,"name":"Carrot Ginger Soup with Cranberry-Almond Salad","slug":"carrot-ginger-soup-cranberry-almond-salad","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/681/thumbnail_7e349e18-661d-4904-8707-8d6acbe48576.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/681/presentation_7e349e18-661d-4904-8707-8d6acbe48576.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":52,"name":"grater (optional)","slug":"grater"},{"id":74,"name":"hand or regular blender","slug":"hand-or-regular-blender"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":48,"name":"medium saucepan","slug":"medium-saucepan"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":89724,"primary_message":"Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)","secondary_message":"9 medium carrots\n0.68 kg sweet potato\n3 (2 ½ cm) pieces ginger root\n3 (142 g) pkg baby spinach\n1 ½ small bunches Italian (flat-leaf) parsley"},{"id":89725,"primary_message":"Peel and roughly chop the carrots and potatoes.","secondary_message":null},{"id":89726,"primary_message":"Preheat a large pot over medium-high heat.","secondary_message":null},{"id":89727,"primary_message":"Peel and mince shallot; add to a large salad bowl.","secondary_message":"3 shallots"},{"id":89728,"primary_message":"Once the pot is hot, add butter and swirl to coat the bottom.","secondary_message":"3 tbsp butter, unsalted"},{"id":89729,"primary_message":"Combine the chopped carrots and potatoes, honey, and salt in the pot.","secondary_message":"1 tbsp honey\n1 ½ tsp salt"},{"id":89730,"primary_message":"Peel and mince or grate ginger; add to the pot. Reduce to medium heat, cover, and stew for 10 minutes; stirring occasionally.","secondary_message":null},{"id":89731,"primary_message":"Add broth to the pot, bring to a boil; cover and simmer until vegetables are tender, about 12 minutes.","secondary_message":"2129 ml chicken or vegetable broth"},{"id":89732,"primary_message":"In the salad bowl, whisk together olive oil, vinegar, honey, sesame seeds, salt, and pepper.","secondary_message":"⅓ cup extra virgin olive oil\n¼ cup apple cider vinegar\n1 tbsp honey\n2 tbsp sesame seeds\n¾ tsp salt\n3 pinch black pepper"},{"id":89733,"primary_message":"Using an immersion (hand) blender, purée the soup until smooth.","secondary_message":null},{"id":89734,"primary_message":"Measure out cranberries and almonds.","secondary_message":"¾ cup dried cranberries\n¾ cup almonds"},{"id":89735,"primary_message":"Shave the parsley leaves off the stems; discard the stems and mince the leaves.","secondary_message":null},{"id":89736,"primary_message":"Add the spinach to the bowl with the dressing. Add ¾ of the parsley, the cranberries, and almonds; toss to combine.","secondary_message":null},{"id":89737,"primary_message":"To serve, pour soup into a bowl, garnish with remaining parsley and arrange salad on the side. Enjoy!","secondary_message":null}],"line_items":[{"id":93224,"quantity":"¾ cup","ingredient_name":"almonds"},{"id":93226,"quantity":"3 (142 g) pkg","ingredient_name":"baby spinach"},{"id":93236,"quantity":"9 medium","ingredient_name":"carrots"},{"id":93238,"quantity":"2129 ml","ingredient_name":"chicken or vegetable broth"},{"id":93225,"quantity":"¾ cup","ingredient_name":"dried cranberries"},{"id":93239,"quantity":"3 (2 ½ cm) pieces","ingredient_name":"ginger root"},{"id":93231,"quantity":"1 ½ small bunches","ingredient_name":"Italian (flat-leaf) parsley"},{"id":93235,"quantity":"3","ingredient_name":"shallots"},{"id":93234,"quantity":"0.68 kg","ingredient_name":"sweet p
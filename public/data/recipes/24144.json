{"id":24144,"recipe_id":2701,"serving_count":6,"cooking_minutes":20,"name":"Avocado Toast with Crispy Prosciutto","slug":"avocado-toast-crispy-prosciutto","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2701/thumbnail_5a7aa8cf-a973-470c-9639-755c157856ea.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2701/presentation_5a7aa8cf-a973-470c-9639-755c157856ea.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":16,"name":"potato masher","slug":"potato-masher"},{"id":77,"name":"toaster (optional)","slug":"toaster"},{"id":35,"name":"tongs","slug":"tongs"}],"instructions":[{"id":392184,"primary_message":"Preheat a large skillet over medium heat. ","secondary_message":null},{"id":392185,"primary_message":"Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, lay prosciutto in the skillet and cook until it browns slightly, about 1 minute per side. Remove to a plate and set aside.","secondary_message":"1 ½ tsp extra virgin olive oil\n6 slices prosciutto"},{"id":392186,"primary_message":"Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)","secondary_message":null},{"id":392187,"primary_message":"Arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)","secondary_message":"6 slices whole grain bread"},{"id":392188,"primary_me
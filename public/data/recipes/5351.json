{"id":5351,"recipe_id":244,"serving_count":6,"cooking_minutes":45,"name":"Lemon Garlic Chicken Drumsticks with Potatoes \u0026 Tomatoes","slug":"lemon-garlic-chicken-drumsticks-potatoes-tomatoes","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/244/thumbnail_2578f394-f9fc-49d1-9fe7-b36e9b5f3ea0.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/244/presentation_2578f394-f9fc-49d1-9fe7-b36e9b5f3ea0.jpg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":36,"name":"salad spinner (optional)","slug":"salad-spinner"},{"id":18,"name":"spatula","slug":"spatula"}],"instructions":[{"id":64306,"primary_message":"Preheat oven to 260°C (500°F) and position rack in the center.","secondary_message":""},{"id":64305,"primary_message":"Make a few slits in the chicken drumsticks, then place on a baking sheet pan.","secondary_message":"1.02 kg chicken drumsticks"},{"id":64304,"primary_message":"Wash and dry potatoes; medium dice and add to pan with chicken. Peel, cut into thin wedges, and add onion to pan.","secondary_message":"6 medium yellow potatoes\n1 ½ medium red onion"},{"id":64303,"primary_message":"Place pan in the oven and roast while you prepare the sauce and tomatoes, about 5 minutes.","secondary_message":""},{"id":64302,"primary_message":"Grate zest from 1 ½ lemons into a small bowl, then juice into the same bowl. Slice other 1 ½ lemons into rounds. Peel, mince, and add garlic to bowl.","secondary_message":"3 lemons\n6 cloves garlic"},{"id":64301,"primary_message":"Add olive oil, Italian seasoning, salt, and pepper to bowl and mix.","secondary_message":"6 tbsp extra virgin olive oil\n3 tsp Italian seasoning\n¾ tsp salt\n⅜ tsp black pepper"},{"id":64300,"primary_message":"Wash tomatoes.","secondary_message":"3 small pkg grape tomatoes"},{"id":64299,"primary_message":"Remove pan from oven. Pour sauce over top chicken and potatoes; toss to coat. Add tomatoes and lemon slices to pan. Return to oven and roast until chicken is cooked through and potatoes are tender, about 25 minutes.","secondary_message":""},{"id":64298,"primary_message":"Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.","secondary_message":"1 ½ small bunch Italian (flat-leaf) parsley"},{"id":64297,"primary_message":"Once chicken is cooked through, remove dish from oven. Garnish with parsley and toss.","secondary_message":""},{"id":64296,"primary_message":"Place chicken and vegetables on a plate and enjoy!","secondary_message":""}],"line_items":[{"id":68786,"quantity":"1.02 kg","ingredient_name":"chicken drumsticks"},{"id":68796,"quantity":"6 cloves","ingredient_name":"garlic"},{"id":68795,"quantity":"3 small pkgs","ingredient_name":"grape tomatoes"},{"id":68793,"quantity":"1 ½ small bunches","ingredient_name":"Italian (flat-leaf) parsley"},{"id":68792,"quantity":"3","ingredient_name":"lemons"},{"id":68791,"quantity":"1 ½ medium","ingredient_name":"red onions"},{"id":68790,"quantity":"6 medium","ingredient_name":"yellow potatoes"},{"id":68789,"quantity":"","ingredient_name":"black pepper"},{"id":68788,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":68794,"quantity":"","ingredient_name":"Italian seasoning"},{"id":68787,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":595.08,"alcohol":0.0,"ash":5.52,"caffeine":0.0,"water":492.33,"carbs":45.71,"fiber":8.14,"starch":29.64,"sugars":8.11,"fructose":3.34,"galactose":0.0,"glucose":3.7,"lactose":0.0,"maltose":0.0,"sucrose":1.01,"sugar_alcohol":0.0,"fat":30.09,"monounsaturat
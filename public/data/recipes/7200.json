{"id":7200,"recipe_id":826,"serving_count":6,"cooking_minutes":15,"name":"Lemony Arugula \u0026 Egg Wrap with Zesty Aioli","slug":"lemony-arugula-egg-wrap-zesty-aioli","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/826/thumbnail_34f67753-c775-4daa-91de-a19f4564d60d.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/826/presentation_34f67753-c775-4daa-91de-a19f4564d60d.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":15,"name":"grater","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":18,"name":"spatula","slug":"spatula"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":173202,"primary_message":"Wash and dry the arugula. (Skip this step if it came pre-washed.)","secondary_message":"1 ½ (142 g) pkg baby arugula"},{"id":173203,"primary_message":"Wash, dry, and zest the lemons into a small bowl, then juice the lemon into a medium bowl.","secondary_message":"1 ½ lemons"},{"id":173204,"primary_message":"Add mayonnaise, garlic powder, and paprika to the medium bowl with the lemon zest; stir to make the aioli.","secondary_message":"⅓ cup mayonnaise\n¾ tsp garlic powder\n⅜ tsp paprika"},{"id":173205,"primary_message":"Add oil, maple syrup, Dijon, salt, and pepper to the large bowl with the lemon juice; whisk to combine the dressing.","secondary_message":"2 tbsp extra virgin olive oil\n2 tbsp pure maple syrup\n1 tbsp Dijon mustard\n3 pinch salt\n3 pinch black pepper"
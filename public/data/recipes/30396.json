{"id":30396,"recipe_id":3388,"serving_count":6,"cooking_minutes":30,"name":"Strawberry, Banana \u0026 Lemon Oatmeal Protein Bites","slug":"strawberry-banana-lemon-oatmeal-protein-bites","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3388/thumbnail_a84b5238-6251-437b-b8bd-d20171cdbc10.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3388/presentation_a84b5238-6251-437b-b8bd-d20171cdbc10.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":52,"name":"grater (optional)","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":125,"name":"parchment paper","slug":"parchment-paper"},{"id":16,"name":"potato masher","slug":"potato-masher"},{"id":18,"name":"spatula","slug":"spatula"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":483655,"primary_message":"Preheat oven to 175°C (350°F). Line two large baking sheet pans with parchment paper.","secondary_message":null},{"id":483656,"primary_message":"Peel bananas, break into chunks, and place in a large bowl. Mash with a fork or potato masher until smooth.","secondary_message":"3 bananas"},{"id":483657,"primary_message":"Wash, dry, zest, and juice lemons into the bowl with the banana. Add eggs and maple syrup, then stir to combine.","secondary_message":"1 ½ lemons\n3 eggs\n3 tbsp pure maple syrup"},{"id":483658,"primary_message":"Wash, dry, trim, and roughly chop strawberries. Add to the bowl along with oats, protein powder, and almond flour. Stir once more to combine the batter.","secondary_message":"1 (454 g) pkg strawberries\n3 cup oats, quick cooking\n3 servings vanilla whey-based protein powder (containing 20 grams protein/serving)\n⅓ cup almond meal/flour"},{"id":483659,"primary_message":"Using a ¼-cup measure, scoop batter onto the baking sheets, leaving some space between. Use the back of a spoon to spread each \"bite\" into a 3-inch circle. Place in the oven and bake until just firm to the touch, about 15 minutes. Remove from oven.","secondary_message":null},{"id":483660,"primary_message":"Allow to cool for a few minutes before transferring to plates. Enjoy!","secondary_message":null}],"line_items":[{"id":519774,"quantity":"3","ingredient_name":"bananas"},{"id":519770,"quantity":"3","ingredient_name":"eggs"},{"id":519771,"quantity":"1 ½","ingredient_name":"lemons"},{"id":519772,"quantity":"1 (454 g) pkg","ingredient_name":"strawberries"},{"id":519773,"quantity":"","ingredient_name":"almond meal/flour"},{"id":519775,"quantity":"","ingredient_name":"oats, quick cooking"},{"id":519769,"quantity":"","ingredient_name":"pure maple syrup"},{"id":519776,"quantity":"","ingredient_name":"vanilla whey-based protein powder (containing 20 grams protein/serving)"}],"nutrition":{"energy":372.8,"alcohol":0.0,"ash":3.36,"caffeine":0.0,"water":149.22,"carbs":56.53,"fiber":8.2,"starch":23.72,"sugars":18.02,"fructose":4.89,"galactose":0.01,"glucose":4.81,"lactose":0.0,"maltose":0.01,"sucrose":8.31,"sugar_alcohol":0.0,"fat":8.58,"monounsaturated":3.7,"polyunsaturated":2.31,"omega_3":0.12,"omega_6":2.15,"saturated":1.5,"transfats":0.01,"cholesterol":83.92,"protein":20.13,"alanine":0.48,"arginine":0.7,"aspartic_acid":1.07,"cystine":0.27,"glutamic_acid":1.91,"glycine":0.47,"histidine":0.23,"isoleucine":0.41,"leucine":0.75,"lysine":0.52,"methionine":0.18,"phenylalanine":0.51,"proline":0.37,"serine":0.58,"threonine":0.33,"tryptophan":0.13,"tyrosine":0.32,"valine":0.53,"b1_thiamine":0.31,"b2_riboflavin":0.61,"b3_niacin":1.15,"b5_pantothenic_acid":1.
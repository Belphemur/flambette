{"id":16909,"recipe_id":1991,"serving_count":6,"cooking_minutes":40,"name":"Spiced Chicken Kale Salad with Pear, Pecans, Parmesan \u0026 Cranberries","slug":"spiced-chicken-kale-salad-pear-pecans-parmesan-cranberries","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1991/thumbnail_d1d1f0fe-3ff3-4ba5-aa02-8f1cf4be5f7c.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1991/presentation_d1d1f0fe-3ff3-4ba5-aa02-8f1cf4be5f7c.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":15,"name":"grater","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":321613,"primary_message":"Wash and dry the fresh produce.","secondary_message":"3 lemons\n3 bunches kale\n3 pears"},{"id":321614,"primary_message":"Juice lemons into a large bowl.","secondary_message":null},{"id":321615,"primary_message":"Finely grate Parmesan; add ⅔ to the bowl with the lemon juice (reserving the rest for serving).","secondary_message":"128 g Parmesan cheese"},{"id":321616,"primary_message":"Add oil and spices to the bowl; whisk to combine the dressing. ","secondary_message":"⅓ cup extra virgin olive oil\n1 tbsp garlic powder\n¾ tsp salt\n½ tsp crushed red pepper\n½ tsp black pepper\n3 pinch cinnamon, ground"},{"id":321617,"primary_message":"Fold kale leaves in half lengthwise and slice off the stems. Finely chop leaves and add to the bowl with the dressing; using your hands, massage kale with the dressing until wilted, 2-3 minutes. Set aside.","secondary_message":null},{"id":321618,"primary_message":"Place additional spices in a small bowl and stir to combine.","secondary_message":"1 ½ tsp paprika\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp cinnamon, ground\n¾ tsp cardamom, ground\n3 pinch coriander, ground"},{"id":321619,"primary_message":"Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Place on a plate and season with the spice mixture on both sides.","secondary_message":"1.02 kg chicken breasts, boneless skinless"},{"id":321620,"primary_message":"Preheat a large skillet over medium-high heat.","secondary_message":null},{"id":321621,"primary_message":"Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove to a plate.","secondary_message":"2 tbsp extra virgin olive oil"},{"id":321622,"primary_message":"Meanwhile, using a clean cutting board, quarter, core, and thinly slice pears; add to the bowl with the kale. ","secondary_message":null},{"id":321623,"primary_message":"Roughly chop pecans and add to the bowl; toss to combine the salad.","secondary_message":"¾ cup pecans, dry roasted"},{"id":321624,"primary_message":"Thinly slice chicken into strips.","secondary_message":null},{"id":321625,"primary_message":"To serve, divide the salad between plates or bowls and top with sliced chicken, cranberries, and reserved Parmesan. Enjoy!","secondary_message":"¾ cup dried cranberries"}],"line_items":[{"id":342309,"quantity":"1.02 kg","ingredient_name":"chicken breasts, boneless skinless"},{"id":342308,"quantity":"¾ cup","ingredient_name":"dried cranberries"},{"id":342320,"quantity":"3 bunches","ingredient_name":"kale"},{"id":342319,"quantity":"3","ingredient_name":"lemons"},{"id":342318,"quantity":"128 g","ingredient_name":"Parme
{"id":17209,"recipe_id":2017,"serving_count":6,"cooking_minutes":35,"name":"Soba Noodle Soup with Tofu, Edamame, Mushroom, Green Onion \u0026 Ginger","slug":"soba-noodle-soup-tofu-edamame-mushroom-green-onion-ginger","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2017/thumbnail_36852233-d7e7-440a-8025-b85df800d632.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2017/presentation_36852233-d7e7-440a-8025-b85df800d632.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":52,"name":"grater (optional)","slug":"grater"},{"id":57,"name":"ladle","slug":"ladle"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":279581,"primary_message":"Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.","secondary_message":"3 (340 g) pkgs extra firm tofu"},{"id":279582,"primary_message":"Wash and dry the fresh produce.","secondary_message":"1.02 kg cremini mushrooms\n3 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)"},{"id":279583,"primary_message":"Thinly slice mushrooms and place in a large bowl.","secondary_message":null},{"id":279584,"primary_message":"Peel and mince ginger and garlic; add both to the bowl with the mushrooms.","secondary_message":"3 cloves garlic"},{"id":279585,"primary_message":"Preheat a large pot over medium heat.","secondary_message":null},{"id":279586,"primary_message":"Once the pot is hot, add oil and swirl to coat the bottom. Add mushrooms, ginger, and garlic; cook, stirring occasionally, until mushrooms are lightly browned, 6-7 minutes.","secondary_message":"3 tbsp toasted sesame oil"},{"id":279587,"primary_message":"Meanwhile, cut tofu into ½-inch cubes.","secondary_message":null},{"id":279588,"primary_message":"When the mushrooms are done, add broth to the pot and bring to a boil over medium-high heat.","secondary_message":"2839 ml chicken or vegetable broth"},{"id":279589,"primary_message":"Once the broth is boiling, add tofu, noodles, edamame, and soy sauce; stir to combine the soup. Bring to a simmer over medium heat and continue to cook until noodles are tender and tofu is warmed through, 5 minutes more. Remove from heat.","secondary_message":"425 g soba (buckwheat) noodles\n2 cups edamame\n⅓ cup soy sauce"},{"id":279590,"primary_message":"Meanwhile, trim green onions and cut crosswise into thin pieces; add to the soup and stir to combine.","secondary_message":null},{"id":279591,"primary_message":"To serve, divide soup between bowls and enjoy!","secondary_message":null}],"line_items":[{"id":295664,"quantity":"2839 ml","ingredient_name":"chicken or vegetable broth"},{"id":295666,"quantity":"1.02 kg","ingredient_name":"cremini mushrooms"},{"id":295668,"quantity":"2 cups","ingredient_name":"edamame"},{"id":295662,"quantity":"3 (340 g) pkgs","ingredient_name":"extra firm tofu"},{"id":295659,"quantity":"3 cloves","ingredient_name":"garlic"},{"id":295665,"quantity":"3 (2 ½ cm) pieces","ingredient_name":"ginger root"},{"id":295663,"quantity":"1 small bunch","ingredient_name":"green onions (scallions)"},{"id":295667,"quantity":"425 g","ingredient_name":"soba (buckwheat) noodles"},{"id":295661,"quantity":"","ingredient_name":"soy sauce"},{"id":295660,"quantity":"","ingredient_name":"toasted sesame oil"}],"nutrition":{"energy":655.82,"alcohol":0.0,"ash":10.39,"caffe
{"id":5191,"recipe_id":94,"serving_count":6,"cooking_minutes":35,"name":"Roasted Chickpea \u0026 Tomato Salad with Arugula \u0026 Feta","slug":"roasted-chickpea-tomato-salad-arugula-feta","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/94/thumbnail_8974c5eb-d69d-4009-808c-f0bb8e796ce2.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/94/presentation_8974c5eb-d69d-4009-808c-f0bb8e796ce2.jpg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":36,"name":"salad spinner (optional)","slug":"salad-spinner"},{"id":18,"name":"spatula","slug":"spatula"}],"instructions":[{"id":62522,"primary_message":"Preheat oven to 230°C (450°F).","secondary_message":""},{"id":62521,"primary_message":"Drain and rinse chickpeas. Place on paper towels and pat dry.","secondary_message":"3 (398 ml) cans garbanzo beans (chickpeas)"},{"id":62520,"primary_message":"Peel and thinly slice onion into half rings. Wash and halve tomatoes.","secondary_message":"1 ½ medium red onion\n1 ½ small pkg grape tomatoes"},{"id":62519,"primary_message":"Place chickpeas, onion, and tomatoes on a baking sheet pan. Drizzle with olive oil and season with salt and pepper. Toss to coat.","secondary_message":"3 tbsp extra virgin olive oil\n¾ tsp salt\n⅜ tsp black pepper"},{"id":62518,"primary_message":"Place in the oven and roast until chickpeas are golden and tomatoes begin to collapse, 10-15 minutes.","secondary_message":""},{"id":62517,"primary_message":"Peel and mince garlic. In a small bowl, prepare dressing by whisking to
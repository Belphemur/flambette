{"id":6245,"recipe_id":602,"serving_count":6,"cooking_minutes":35,"name":"Chickpea Waldorf Salad with Apples, Celery, Grapes \u0026 Walnuts","slug":"chickpea-waldorf-salad-apples-celery-grapes-walnuts","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/602/thumbnail_2e9f2e5a-3eb9-4438-906a-2917b5c14b8d.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/602/presentation_2e9f2e5a-3eb9-4438-906a-2917b5c14b8d.jpg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":76004,"primary_message":"Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)","secondary_message":"1 ½ (142 g) pkg baby spinach\n3 Gala apples\n6 sticks celery\n0.341 kg red grapes"},{"id":76003,"primary_message":"Drain and rinse the chickpeas, then set aside to drain further.","secondary_message":"3 (398 ml) cans garbanzo beans (chickpeas)"},{"id":76002,"primary_message":"In a large salad bowl, combine and whisk together yogurt, apple cider vinegar, Dijon, honey, salt, and pepper.","secondary_message":"1 ½ cup plain Greek yogurt\n3 tbsp apple cider vinegar\n3 tsp Dijon mustard\n3 tsp honey\n1 ½ tsp salt\n¾ tsp black pepper"},{"id":76001,"primary_message":"Quarter the apples lengthwise, then cut out the core and stem from each section; medium dice the apples (cut into 1 ¼-cm cubes) and add to the salad bowl.","secondary_message":""},{"id":76000,"primary_message":"Trim off and discard the ends of the celery; medium dice the celery (cut into 1 ¼-cm cubes) and add to the salad bowl.","secondary_messa
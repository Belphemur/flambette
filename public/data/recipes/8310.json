{"id":8310,"recipe_id":909,"serving_count":6,"cooking_minutes":30,"name":"Mashed Peas on Toast with Fried Egg \u0026 Bacon","slug":"mashed-peas-on-toast-fried-egg-bacon","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/909/thumbnail_6a026d5f-22db-4ff5-b472-471fcc7b0e37.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/909/presentation_6a026d5f-22db-4ff5-b472-471fcc7b0e37.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":16,"name":"potato masher","slug":"potato-masher"},{"id":18,"name":"spatula","slug":"spatula"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":77,"name":"toaster (optional)","slug":"toaster"},{"id":35,"name":"tongs","slug":"tongs"}],"instructions":[{"id":173970,"primary_message":"Preheat a large skillet over medium-high heat; add bacon and cook until crisp, 5-7 minutes. ","secondary_message":"12 slices bacon"},{"id":173971,"primary_message":"Meanwhile, peel and mince shallots and garlic.","secondary_message":"3 shallots\n3 cloves garlic"},{"id":173972,"primary_message":"When the bacon is done, remove and set aside on a paper towel-lined plate. Transfer the bacon fat to a small bowl and set aside, leaving about 3 tbsp of fat in the skillet.","secondary_message":null},{"id":173973,"primary_message":"Return the skillet to medium-high heat; add shallots and garlic and cook, stirring occasionally, until softened, about 2 minutes.","secondary_message":null},{"id":173974,"primary_message":"Add peas, water, and goat cheese to the skillet with the shallots; cook, stirring occasionally, until almost no liquid remains, about 5 minutes.","secondary_message":"3 cups frozen peas\n⅓ cup water\n¾ (113 g) log goat cheese"},{"id":173975,"primary_message":"Roughly chop the bacon and return to the plate.","secondary_message":null},{"id":173976,"primary_message":"Wash and juice lemons into a medium bowl.","secondary_message":"1 ½ lemons"},{"id":173977,"primary_message":"Add pea mixture to the bowl with the lemon juice and season with salt and pepper; mash until almost smooth.","secondary_message":"⅜ tsp salt\n3 pinch black pepper"},{"id":173978,"primary_message":"Wipe out skillet and put back on stove over medium heat.","secondary_message":null},{"id":173979,"primary_message":"Add 3 tbsp of reserved bacon fat to the skillet and swirl to coat the bottom; gently crack eggs into skillet and cook until whites are set but yolks are still runny, about 3 minutes.","secondary_message":"6 eggs"},{"id":173980,"primary_message":"Toast bread if desired.","secondary_message":"6 slices whole grain bread"},{"id":173981,"primary_message":"To serve, spread mashed peas over toast, top with bacon, egg, salt, and pepper. Enjoy!","secondary_message":"3 pinch salt\n3 pinch black pepper"}],"line_items":[{"id":181147,"quantity":"12 slices","ingredient_name":"bacon"},{"id":181141,"quantity":"6","ingredient_name":"eggs"},{"id":181146,"quantity":"3 cups","ingredient_name":"frozen peas"},{"id":181138,"quantity":"3 cloves","ingredient_name":"garlic"},{"id":181142,"quantity":"¾ (113 g) log","ingredient_name":"goat cheese"},{"id":181145,"quantity":"1 ½","ingredient_name":"lemons"},{"id":181143,"quantity":"3","ingredient_name":"shallots"},{"id":181144,"quantity":"6 slices","ingredient_name":"whole grain bread"},{"id":181139,"quantity":"","ingredient_name":"black pepper"},{"id":181140,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":481.28,"alcohol":0.0,"ash":3.91,"caffeine":0.0,"water":156.08,"carbs":27.6,"fiber":5.49,"starch":12.42,"sugars":7.04,"fructose":1.01
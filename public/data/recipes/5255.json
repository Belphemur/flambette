{"id":5255,"recipe_id":146,"serving_count":6,"cooking_minutes":40,"name":"Skillet Broccoli Mac 'n' Cheese","slug":"skillet-broccoli-mac-n-cheese","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/146/thumbnail_b064fe4e-cfb1-4dba-83fe-36bc0b7e0c59.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/146/presentation_b064fe4e-cfb1-4dba-83fe-36bc0b7e0c59.jpg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":15,"name":"grater","slug":"grater"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":68,"name":"stainless steel sauté pan","slug":"stainless-steel-saute-pan"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":63210,"primary_message":"Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 6-8 minutes. Drain.","secondary_message":"about 21 cups water\n3 tbsp salt\n510 g (4 ½ cups) macaroni (elbow) pasta"},{"id":63209,"primary_message":"Wash broccoli and cut into bite-sized florets. Add to pot with pasta during the last 2-3 minutes of cooking time.","secondary_message":"6 crowns broccoli"},{"id":63208,"primary_message":"Heat a sauté pan over medium heat.","secondary_message":""},{"id":63207,"primary_message":"Peel and mince garlic.","secondary_message":"3 cloves garlic"},{"id":63206,"primary_message":"Melt butter in pan. Add garlic and cook until fragrant, 15-30 seconds. Add flour and whisk until smooth.","secondary_message":"3 tbsp butter, unsalted\n3 tbsp all-purpose flour"},{"id":63205,"primary_message":"A
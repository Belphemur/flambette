{"id":40595,"recipe_id":4378,"serving_count":6,"cooking_minutes":30,"name":"Cheesy Mango, Bell Pepper \u0026 Prosciutto Flatbread with Balsamic Arugula","slug":"cheesy-mango-bell-pepper-prosciutto-flatbread-balsamic-arugula","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/4378/thumbnail_2a34f9d9-e2e5-4860-8bfa-c4a238327f08.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/4378/presentation_2a34f9d9-e2e5-4860-8bfa-c4a238327f08.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":15,"name":"grater","slug":"grater"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":35,"name":"tongs","slug":"tongs"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":627649,"primary_message":"Preheat oven to 220°C (425°F).","secondary_message":null},{"id":627650,"primary_message":"Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)","secondary_message":"1 ½ mangoes\n3 red bell peppers\n1 ½ (142 g) pkgs baby arugula"},{"id":627651,"primary_message":"Divide flatbreads between two large baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until flatbreads are slightly crispy, about 10 minutes. Remove from oven.","secondary_message":"6 flatbreads or naan"},{"id":627652,"primary_message":"Meanwhile, peel mangoes and slice flesh away from the pit, starting with the flat sides; medium dice the flesh. Transfer to a plate.","secondary_message":null},{"id":627653,"primary_message":"Trim, seed, and medium dice bell peppers. Add to the plate with the mango.","secondary_message":null},{"id":627654,"primary_message":"Chop or tear prosciutto into bite-sized pieces. Add to the plate and set aside.","secondary_message":"12 slices prosciutto"},{"id":627655,"primary_message":"Coarsely grate cheese.","secondary_message":"1 (227 g) block mozzarella cheese"},{"id":627656,"primary_message":"Divide cheese between flatbreads, then top with mango, bell pepper, and prosciutto. Return prepared flatbreads to the oven and bake until warmed through and cheese is melted, 7-8 minutes. Remove from the oven.","secondary_message":null},{"id":627657,"primary_message":"Meanwhile, place oil, vinegar, and spices in a large bowl. Whisk to combine the dressing.","secondary_message":"2 tbsp extra virgin olive oil\n1 tbsp balsamic vinegar\n½ tsp basil, dried\n½ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"},{"id":627658,"primary_message":"When the flatbreads are almost done, add arugula to the bowl with the dressing and toss to coat.","secondary_message":null},{"id":627659,"primary_message":"Cut each flatbread into wedges.","secondary_message":null},{"id":627660,"primary_message":"To serve, divide flatbreads between plates and top with a small handful of arugula. Serve remaining arugula on the side and enjoy!","secondary_message":null}],"line_items":[{"id":682900,"quantity":"1 ½ (142 g) pkgs","ingredient_name":"baby arugula"},{"id":682902,"quantity":"6","ingredient_name":"flatbreads or naan"},{"id":682903,"quantity":"1 ½","ingredient_name":"mangoes"},{"id":682894,"quantity":"1 (227 g) block","ingredient_name":"mozzarella cheese"},{"id":682904,"quantity":"12 slices","ingredient_name":"prosciutto"},{"id":682901,"quantity":"3","ingredient_name":"red bell peppers"},{"id":682899,"quantity":"","ingredient_name":"balsamic vinegar"},{"id":682895,"quantity":"","ingredient_name":"basil, dried"},{"id":682896,"quantity":"","ingredient_name":"black pepper"},{"id":682893,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":682897,"quantity":"","ingredient_name":"garlic powder"},{"id":682898,"qua
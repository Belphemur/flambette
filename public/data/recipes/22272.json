{"id":22272,"recipe_id":1772,"serving_count":6,"cooking_minutes":30,"name":"Grilled Chicken Salad with Goat Cheese, Fresh Raspberries \u0026 Pecans","slug":"grilled-chicken-salad-goat-cheese-fresh-raspberries-pecans","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1772/thumbnail_3d24e360-c3dd-452b-8833-c73473d8df3d.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1772/presentation_3d24e360-c3dd-452b-8833-c73473d8df3d.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":45,"name":"grill pan, outdoor grill, or skillet","slug":"grill-pan-outdoor-grill-or-skillet"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":35,"name":"tongs","slug":"tongs"}],"instructions":[{"id":372816,"primary_message":"Pat chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut chicken in half horizontally to form thin cutlets. Season chicken with salt and pepper on both sides.","secondary_message":"1.02 kg chicken breasts, boneless skinless\n¾ tsp salt\n½ tsp black pepper"},{"id":372817,"primary_message":"Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.","secondary_message":null},{"id":372818,"primary_message":"Once the pan is hot, coat with oil. Working in batches if necessary, add chicken to the pan and grill, turning once, until cooked through, 3-4 minutes per side.","secondary_message":"2 tbsp extra virgin olive oil"},{"id":372819,"primary_message":"Meanwhile, wash and dry mixed greens (skip if they came pre-washed). Place in a large bowl.","secondary_message":"3 (142 g) pkg spring mix (mixed greens)"},{"id":372820,"primary_message":"Wash and dry raspberries. Add to the bowl with the mixed greens.","secondary_message":"3 (170 g) pkg raspberries"},{"id":372821,"primary_message":"Using a clean cutting board, roughly chop pecans. Add to the bowl.","secondary_message":"¾ cup pecan halves"},{"id":372822,"primary_message":"When the chicken is done, transfer to a cutting board and cut into thin strips.","secondary_message":null},{"id":372823,"primary_message":"Add chicken and vinaigrette to the bowl, then toss to combine the salad.","secondary_message":"½ cup French vinaigrette"},{"id":372824,"primary_message":"To serve, divide salad between plates or bowls, crumble goat cheese over top, and enjoy!","secondary_message":"1 ½ (113 g) logs goat cheese"}],"line_items":[{"id":397614,"quantity":"1.02 kg","ingredient_name":"chicken breasts, boneless skinless"},{"id":397622,"quantity":"135 ml","ingredient_name":"French vinaigrette"},{"id":397618,"quantity":"1 ½ (113 g) logs","ingredient_name":"goat cheese"},{"id":397621,"quantity":"¾ cup","ingredient_name":"pecan halves"},{"id":397620,"quantity":"3 (170 g) pkg","ingredient_name":"raspberries"},{"id":397619,"quantity":"3 (142 g) pkg","ingredient_name":"spring mix (mixed greens)"},{"id":397616,"quantity":"","ingredient_name":"black pepper"},{"id":397615,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":397617,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":572.24,"alcohol":0.0,"ash":4.42,"caffeine":0.0,"water":282.66,"carbs":14.42,"fiber":8.27,"starch":0.13,"sugars":4.97,"fructose":2.36,"galactose":0.02,"glucose":1.85,"lactose":0.0,"maltose":0.0,"sucrose":0.74,"sugar_alcohol":0.0,"fat":36.56,"monounsaturated":11.97,"polyunsaturated":4.57,"omega_3":0.38,"omega_6":4.2,"saturated":7.38,"transfats":0.22,"cholesterol":137.09,"protein":46.91,"alanine":2.43,"arginine":2.96,"aspartic_acid":4.11,"cystine":0.45,"glutamic_acid":7.05,"glycine":1.86,"histidine":1.63,"isoleucine":2.19,"leucine":3.77,"lysine":4.15,"methionine":1.17,"phenylalanine":1.86,"proline":1.95,"serine":1.76,"
{"id":24999,"recipe_id":2804,"serving_count":6,"cooking_minutes":30,"name":"Creamy Ham \u0026 Lentil Soup with Carrot, Celery \u0026 Parsley","slug":"creamy-ham-lentil-soup-carrot-celery-parsley","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2804/thumbnail_9f7381e5-d9fc-40c4-b9f8-5c3ac459811d.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2804/presentation_9f7381e5-d9fc-40c4-b9f8-5c3ac459811d.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":57,"name":"ladle","slug":"ladle"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":402075,"primary_message":"Wash, dry, trim, and small dice celery. Place in a medium bowl along with the carrots.","secondary_message":"6 sticks celery\n1 ½ (283 g) bags shredded carrots"},{"id":402076,"primary_message":"Small dice ham. Add to the bowl with the celery and carrots. ","secondary_message":"680 g ham steak, boneless"},{"id":402077,"primary_message":"Preheat a large pot over medium heat.","secondary_message":null},{"id":402078,"primary_message":"Once the pot is hot, add oil and swirl to coat the bottom. Add celery, carrots, ham, and spices; cook, stirring occasionally, until veggies start to soften, 4-5 minutes. ","secondary_message":"2 tbsp extra virgin olive oil\n1 ½ tsp onion powder\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"},{"id":402079,"primary_message":"While the veggies are cooking, drain and rinse lentils. ","secondary_message":"3 (255 g) cans lentils"},{"id":402080,"primary_message":"Once the veggies are soft, add lentils, broth, and cream to the pot; stir to combine the soup and bring to a boil. Once boiling, reduce heat to low and simmer until veggies and lentils are tender, about 5 minutes. ","secondary_message":"2129 ml chicken or vegetable broth\n355 ml heavy whipping cream"},{"id":402081,"primary_message":"Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves.","secondary_message":"1 small bunch Italian (flat-leaf) parsley"},{"id":402082,"primary_message":"When the soup is done, remove from heat, add parsley, and stir to combine. ","secondary_message":null},{"id":402083,"primary_message":"To serve, divide soup between bowls. Enjoy!","secondary_message":null}],"line_items":[{"id":429797,"quantity":"6 sticks","ingredient_name":"celery"},{"id":429799,"quantity":"2129 ml","ingredient_name":"chicken or vegetable broth"},{"id":429801,"quantity":"680 g","ingredient_name":"ham steak, boneless"},{"id":429800,"quantity":"355 ml","ingredient_name":"heavy whipping cream"},{"id":429796,"quantity":"1 small bunch","ingredient_name":"Italian (flat-leaf) parsley"},{"id":429802,"quantity":"3 (255 g) cans","ingredient_name":"lentils"},{"id":429803,"quantity":"1 ½ (283 g) bags","ingredient_name":"shredded carrots"},{"id":429793,"quantity":"","ingredient_name":"black pepper"},{"id":429792,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":429794,"quantity":"","ingredient_name":"garlic powder"},{"id":429798,"quantity":"","ingredient_name":"onion powder"},{"id":429795,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":634.78,"alcohol":0.0,"ash":8.3,"caffeine":0.0,"water":672.53,"carbs":41.5,"fiber":13.26,"starch":1.97,"sugars":8.46,"fructose":0.62,"galactose":0.19,"glucose":0.97,"lactose":1.66,"maltose":0.0,"sucrose":2.67,"sugar_alcohol":0.0,"fat":34.47,"monounsaturated":13.07,"polyunsaturated":2.65,"omega_3":0.49,"omega_6":2.16,"saturated":16.77,"transfats":0.87,"cholesterol":132.54,"protein":43.75,"alanine
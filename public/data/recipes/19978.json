{"id":19978,"recipe_id":2299,"serving_count":6,"cooking_minutes":35,"name":"Bacon, Lettuce, Avocado \u0026 Tomato Sandwich with Mixed Salad","slug":"bacon-lettuce-avocado-tomato-sandwich-mixed-salad","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2299/thumbnail_1f44f694-7c3d-441b-a631-7f7a7261aeb0.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2299/presentation_1f44f694-7c3d-441b-a631-7f7a7261aeb0.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":15,"name":"grater","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":77,"name":"toaster (optional)","slug":"toaster"},{"id":35,"name":"tongs","slug":"tongs"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":335098,"primary_message":"Wash and dry the fresh produce.","secondary_message":"1 ½ lemons\n3 medium carrots\n1 ½ heads romaine lettuce\n3 tomatoes\n1 ½ avocados"},{"id":335099,"primary_message":"Preheat a large skillet over medium heat.","secondary_message":null},{"id":335100,"primary_message":"Once the skillet is hot, working in batches if necessary, add bacon and cook, turning occasionally, until crispy, 6-8 minutes. Using tongs, transfer bacon to a paper towel-lined plate.","secondary_message":"12 slices bacon"},{"id":335101,"primary_message":"Meanwhile, juice lemons into a large bowl; add oil, Dijon, honey, salt, and pepper. Whisk to combine the dressing. ","secondary_message":"2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp honey\n¾ tsp salt\n½ tsp black pepper"},{"id":335102,"primary_me
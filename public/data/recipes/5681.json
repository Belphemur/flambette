{"id":5681,"recipe_id":327,"serving_count":6,"cooking_minutes":40,"name":"Mediterranean Tuna Stuffed Bell Peppers with Baby Spinach Salad","slug":"mediterranean-tuna-stuffed-bell-peppers-baby-spinach-salad","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/327/thumbnail_480e8c31-8fa5-4d3f-9bcd-3027da8bacd3.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/327/presentation_480e8c31-8fa5-4d3f-9bcd-3027da8bacd3.jpg","cookwares":[{"id":90,"name":"aluminum foil","slug":"aluminum-foil"},{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":36,"name":"salad spinner (optional)","slug":"salad-spinner"},{"id":35,"name":"tongs","slug":"tongs"}],"instructions":[{"id":67764,"primary_message":"Preheat the broiler. Line a baking sheet with foil.","secondary_message":""},{"id":67763,"primary_message":"Wash, halve lengthwise, and seed the bell peppers.","secondary_message":"3 red bell peppers\n3 orange bell peppers"},{"id":67762,"primary_message":"Place the peppers cut-side down on the baking sheet. Place in the oven and broil until the peppers start to soften and brown, 3-4 minutes.","secondary_message":""},{"id":67761,"primary_message":"Drain the tuna and transfer to a large bowl.","secondary_message":"3 (170 g) cans chunk light tuna in water"},{"id":67752,"primary_message":"Wash and halve the tomatoes; add to the tuna bowl.","secondary_message":"1 ½ small pkg grape tomatoes"},{"id":67760,"primary_message":"Wash and dry the parsley. Shave the leaves off the stems; discard the stems and mince the leaves. Add to the bowl.","secondary_message":"1 ½ small bunch Italian (flat-leaf) parsley"},{"id":67759,"primary_message":"Peel and mince the shallots; add to the bowl.","secondary_message":"3 shallots"},{"id":67758,"primary_message":"Halves the olives and add to the bowl.","secondary_message":"¾ cup Kalamata olives, pitted"},{"id":67757,"primary_message":"Add the capers, feta, lemon juice, olive oil, Dijon, and pepper to tuna mixture. Mix until well combined.","secondary_message":"3 tbsp capers\n1 ½ (113 g) pkg crumbled feta cheese\n¾ lemon\n3 tbsp extra virgin olive oil\n3 tsp Dijon mustard\n¾ tsp black pepper"},{"id":67756,"primary_message":"Remove the peppers from the oven and carefully flip them over. Fill the peppers with the tuna mixture. Return to the oven and broil for another 3-4 minutes.","secondary_message":""},{"id":67755,"primary_message":"Wash and dry the spinach.","secondary_message":"1 ½ (142 g) pkg baby spinach"},{"id":67754,"primary_message":"Cut the remaining piece of lemon into wedges.","secondary_message":"¾ lemon"},{"id":67753,"primary_message":"Place the stuffed peppers on a plate. Arrange a bed of greens on the side; drizzle with olive oil and squeeze lemon juice over top. Enjoy!","secondary_message":"3 tbsp extra virgin olive oil"}],"line_items":[{"id":72730,"quantity":"1 ½ (142 g) pkg","ingredient_name":"baby spinach"},{"id":72739,"quantity":"3 tbsp","ingredient_name":"capers"},{"id":72738,"quantity":"3 (170 g) cans","ingredient_name":"chunk light tuna in water"},{"id":72737,"quantity":"3 (113 g) pkg","ingredient_name":"crumbled feta cheese"},{"id":72726,"quantity":"1 ½ small pkgs","ingredient_name":"grape tomatoes"},{"id":72735,"quantity":"1 ½ small bunches","ingredient_name":"Italian (flat-leaf) parsley"},{"id":72736,"quantity":"¾ cup","ingredient_name":"Kalamata olives, pitte
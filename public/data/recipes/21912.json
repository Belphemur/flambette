{"id":21912,"recipe_id":2496,"serving_count":6,"cooking_minutes":35,"name":"Thai Red Curry Lentil Stew with Sweet Potato, Green Beans \u0026 Yogurt","slug":"thai-red-curry-lentil-stew-sweet-potato-green-beans-yogurt","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2496/thumbnail_9f93ed6c-6f0b-4f74-8633-4c96a9dc29f5.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2496/presentation_9f93ed6c-6f0b-4f74-8633-4c96a9dc29f5.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"}],"instructions":[{"id":368052,"primary_message":"Wash and dry the fresh produce.","secondary_message":"1.02 kg sweet potatoes\n0.68 kg green beans\n3 medium zucchini squash\n1 ½ limes"},{"id":368053,"primary_message":"Peel and medium dice sweet potatoes.","secondary_message":null},{"id":368054,"primary_message":"Place water, coconut milk, and curry paste in a large pot. Stir to combine the broth and bring to a simmer over medium-high heat. ","secondary_message":"3 cup water\n1 ½ (398 ml) cans coconut milk\n⅓ cup Thai curry paste, red"},{"id":368055,"primary_message":"Once the broth is simmering, add sweet potato and cook, stirring occasionally, until softened, 8-10 minutes. ","secondary_message":null},{"id":368056,"primary_message":"Meanwhile, trim and cut green beans crosswise into 1-inch pieces. Place in a large bowl. ","secondary_message":null},{"id":368057,"primary_message":"Trim and halve zucchini lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the green beans. ","secondary_message":null},{"id":368058,"primary_message":"Drain and rinse lentils; add to the bowl with the veggies. ","secondary_message":"3 (255 g) cans lentils"},{"id":368059,"primary_message":"When the sweet potato is tender, add veggies, lentils, salt, and pepper to the pot. Stir to combine the stew and return to a simmer.","secondary_message":"1 ½ tsp salt\n¾ tsp black pepper"},{"id":368060,"primary_message":"Once simmering, cover the stew with a lid and continue to cook, stirring occasionally, until veggies are fork-tender, 4-5 minutes more. Remove from heat. ","secondary_message":null},{"id":368061,"primary_message":"Meanwhile, cut limes into wedges. ","secondary_message":null},{"id":368062,"primary_message":"Divide stew between bowls and top with yogurt. Serve with lime wedges on the side. Enjoy!","secondary_message":"1 ½ cups plain Greek yogurt"}],"line_items":[{"id":392585,"quantity":"1 ½ (398 ml) cans","ingredient_name":"coconut milk"},{"id":392588,"quantity":"0.68 kg","ingredient_name":"green beans"},{"id":392594,"quantity":"3 (255 g) cans","ingredient_name":"lentils"},{"id":392592,"quantity":"1 ½","ingredient_name":"limes"},{"id":392589,"quantity":"1 ½ cups","ingredient_name":"plain Greek yogurt"},{"id":392591,"quantity":"1.02 kg","ingredient_name":"sweet potatoes"},{"id":392593,"quantity":"90 ml","ingredient_name":"Thai curry paste, red"},{"id":392590,"quantity":"3 medium","ingredient_name":"zucchini squash"},{"id":392586,"quantity":"","ingredient_name":"black pepper"},{"id":392587,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":597.44,"alcohol":0.0,"ash":5.59,"caffeine":0.0,"water":544.9,"carbs":83.54,"fiber":20.19,"starch":22.62,"sugars":21.93,"fructose":4.19,"galactose":0.43,"glucose":4.73,"lactose":1.56,"maltose":0.0,"sucrose":8.75,"sugar_alcohol":0.09,"fat":21.15,"monounsaturated":0.99,"polyunsaturated":0.69,"omega_3":0.19,"omega_6":0.5,"saturated"
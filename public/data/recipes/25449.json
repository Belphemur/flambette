{"id":25449,"recipe_id":2877,"serving_count":6,"cooking_minutes":25,"name":"Tuna Salad Stuffed Tomatoes with Cheesy Rosemary Breadsticks","slug":"tuna-salad-stuffed-tomatoes-cheesy-rosemary-breadsticks","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2877/thumbnail_a8ff8861-e9de-4e3d-8749-c4e63b0c2e0f.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2877/presentation_a8ff8861-e9de-4e3d-8749-c4e63b0c2e0f.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":456022,"primary_message":"Preheat oven to 220°C (425°F).","secondary_message":null},{"id":456023,"primary_message":"Place flatbreads on a large baking sheet pan; drizzle with oil, season with spices, and sprinkle with cheese. Place flatbreads in the oven (it doesn't have to be fully heated) and bake until crispy, 8-10 minutes.","secondary_message":"3 flatbreads or naan\n2 tbsp extra virgin olive oil\n¾ tsp rosemary, dried\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper\n1 ½ cups shredded cheese, Italian blend"},{"id":456024,"primary_message":"Meanwhile, wash, dry, trim, and small dice celery. Place in a medium bowl.","secondary_message":"3 sticks celery"},{"id":456025,"primary_message":"Drain tuna and flake with a fork. Add to the bowl with the celery along with mayo, dressing, and salt. Stir to combine the tuna salad.","secondary_message":"6 (170 g) cans chunk light tuna in water\n⅓ cup mayonnaise\n3 tbsp Caesar dressing\n½ tsp salt"},{"id":456026,"primary_message":"Wash, dry, and trim tomatoes. Slicing from the top down, cut tomatoes into wedges, being careful to not cut completely through to the bottom; sprinkle with salt.","secondary_message":"12 tomatoes\n½ tsp salt"},{"id":456027,"primary_message":"When the flatbreads are done, remove from oven and slice crosswise into 2-inch wide strips.","secondary_message":null},{"id":456028,"primary_message":"Divide tomatoes between plates and stuff with tuna salad. Serve with cheesy breadsticks on the side and enjoy!","secondary_message":null}],"line_items":[{"id":488656,"quantity":"45 ml","ingredient_name":"Caesar dressing"},{"id":488652,"quantity":"3 sticks","ingredient_name":"celery"},{"id":488646,"quantity":"6 (170 g) cans","ingredient_name":"chunk light tuna in water"},{"id":488653,"quantity":"3","ingredient_name":"flatbreads or naan"},{"id":488657,"quantity":"1 ½ cups","ingredient_name":"shredded cheese, Italian blend"},{"id":488654,"quantity":"12","ingredient_name":"tomatoes"},{"id":488648,"quantity":"","ingredient_name":"black pepper"},{"id":488647,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":488649,"quantity":"","ingredient_name":"garlic powder"},{"id":488655,"quantity":"","ingredient_name":"mayonnaise"},{"id":488650,"quantity":"","ingredient_name":"rosemary, dried"},{"id":488651,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":615.32,"alcohol":0.0,"ash":6.41,"caffeine":0.0,"water":390.08,"carbs":40.23,"fiber":4.48,"starch":24.77,"sugars":9.05,"fructose":3.46,"galactose":0.6,"glucose":3.17,"lactose":1.2,"maltose":0.0,"sucrose":0.34,"sugar_alcohol":0.0,"fat":34.72,"monounsaturated":10.44,"polyunsaturated":10.69,"omega_3":1.44,"omega_6":9.23,"saturated":10.94,"transfats":0.52,"cholesterol":91.97,"protein":37.94,"alanine":1.84,"arginine":1.9,"aspartic_acid":3.47,"cystine":0.41,"glutamic_acid":7.67,"glycine":1.44,"histidine":1.01,"isoleucine":1.65,"leucine":2.96,"lysine":2.87,"methionine":0.94,"phenylalanine":1.56,"prolin
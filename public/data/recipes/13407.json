{"id":13407,"recipe_id":1579,"serving_count":6,"cooking_minutes":45,"name":"Spicy Tomato-Rice Coconut Cream Soup with Zucchini, Beans \u0026 Cilantro","slug":"spicy-tomato-rice-coconut-cream-soup-zucchini-beans-cilantro","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1579/thumbnail_8c6d49c9-cd7e-406f-9f7a-1166281a8e14.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1579/presentation_8c6d49c9-cd7e-406f-9f7a-1166281a8e14.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":52,"name":"grater (optional)","slug":"grater"},{"id":74,"name":"hand or regular blender","slug":"hand-or-regular-blender"},{"id":57,"name":"ladle","slug":"ladle"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":223962,"primary_message":"Wash and dry the fresh produce.","secondary_message":"3 (2 ½ cm) pieces ginger root\n3 medium zucchini squash\n1 small bunch cilantro"},{"id":223963,"primary_message":"Peel and mince garlic and ginger.","secondary_message":"6 cloves garlic"},{"id":223964,"primary_message":"Peel and small dice onions.","secondary_message":"1 ½ medium yellow onions"},{"id":223965,"primary_message":"Preheat a large pot over medium heat.","secondary_message":null},{"id":223966,"primary_message":"Once the pot is hot, add oil and swirl to coat the bottom. Add garlic, ginger, onion, chili-garlic sauce, and salt; cook, stirring occasionally, until onion begins to soften, 4-5 minutes.","secondary_message":"3 tbsp virgin coconut oil\n1 tbsp chili-garlic sauce\n1 ½ tsp salt"},{"id":223967,"primary_message":"Add broth, tomatoes, and coconut milk to the pot. Bring to a boil over high heat, then reduce heat to low and simmer, stirring occasionally, for 5 minutes.","secondary_message":"1420 ml chicken or vegetable broth\n3 (398 ml) cans diced tomatoes\n1 ½ (398 ml) cans coconut milk"},{"id":223968,"primary_message":"Meanwhile, trim and halve zucchini lengthwise, then slice crosswise into half rounds.","secondary_message":null},{"id":223969,"primary_message":"Drain and rinse beans.","secondary_message":"3 (398 ml) cans cannellini (white kidney) beans"},{"id":223970,"primary_message":"Purée the soup with an immersion (hand) blender or regular blender. Return puréed soup to the pot and stir in zucchini, beans, and rice.","secondary_message":"1 ½ cups basmati rice"},{"id":223971,"primary_message":"Bring to a boil over high heat, then reduce heat to low. Cover and simmer, stirring occasionally, until rice is tender, about 15-18 minutes.","secondary_message":null},{"id":223972,"primary_message":"Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.","secondary_message":null},{"id":223973,"primary_message":"To serve, divide soup between bowls and top with cilantro. Enjoy!","secondary_message":null}],"line_items":[{"id":234923,"quantity":"1 ½ cups","ingredient_name":"basmati rice"},{"id":234915,"quantity":"3 (398 ml) cans","ingredient_name":"cannellini (white kidney) beans"},{"id":234921,"quantity":"1420 ml","ingredient_name":"chicken or vegetable broth"},{"id":234920,"quantity":"1 small bunch","ingredient_name":"cilantro"},{"id":234913,"quantity":"1 ½ (398 ml) cans","ingredient_name":"coconut milk"},{"id":234916,"quantity":"3 (398 ml) cans","ingredient_name":"diced tomatoes"},{"id":234912,"quantity":"6 cloves","ingredient_name":"garlic"},{"id":234922,"quantity":"3 (2 ½ cm) pieces","ingredient_name":"ginger root"},{"id":234919,"quantity":"1 ½ medium","ingredient_name":"yellow onions"},{"id":234918,"quantity":"3 mediu
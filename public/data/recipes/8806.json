{"id":8806,"recipe_id":1016,"serving_count":6,"cooking_minutes":25,"name":"Mozzarella, Tomato \u0026 Basil Omelet","slug":"mozzarella-tomato-basil-omelet","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1016/thumbnail_bc72505c-d025-4745-9afc-f8ccf4214a0b.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1016/presentation_bc72505c-d025-4745-9afc-f8ccf4214a0b.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":15,"name":"grater","slug":"grater"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":18,"name":"spatula","slug":"spatula"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":136645,"primary_message":"Wash and thinly slice the tomatoes. Set half aside for garnish.","secondary_message":"6 tomatoes"},{"id":136646,"primary_message":"Wash and pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.","secondary_message":"1 ½ small pkgs fresh basil"},{"id":136647,"primary_message":"Coarsely grate cheese.","secondary_message":"¾ (227 g) block mozzarella cheese"},{"id":136648,"primary_message":"Preheat a nonstick skillet over medium heat.","secondary_message":null},{"id":136649,"primary_message":"In a medium bowl, whisk together eggs, salt, and pepper.","secondary_message":"18 eggs\n¾ tsp salt\n3 pinch black pepper"},{"id":136650,"primary_message":"Once the skillet is hot, add butter and swirl to coat the bottom.","secondary_message":"1 tbsp butter, unsalted"},{"id":136651,"primary_message":"Add ⅓ of the eggs to the skillet and swirl to cover the bottom. As eggs begin to set, use a spatula to pull the cooked edges towards the center of the pan. Then tilt the pan, allowing the uncooked egg to move to the edges; cook until just set, pressing the eggs into a smooth layer on the bottom of the skillet.","secondary_message":null},{"id":136652,"primary_message":"Sprinkle ⅓ of the cheese over one side of the omelet; layer ⅓ of the reserved tomato slices and ⅓ the basil on top. Fold the omelet in half and cook until cheese is melted, about 1 minute.","secondary_message":null},{"id":136653,"primary_message":"Add more butter to the skillet (1 tbsp per omelet) and repeat twice more with remaining egg mixture, cheese, tomato, and basil.","secondary_message":"2 tbsp butter, unsalted"},{"id":136654,"primary_message":"To serve, cut omelets in half and divide between plates; enjoy with remaining tomato slices on the side!","secondary_message":null}],"line_items":[{"id":142045,"quantity":"18","ingredient_name":"eggs"},{"id":142040,"quantity":"1 ½ small pkgs","ingredient_name":"fresh basil"},{"id":142041,"quantity":"¾ (227 g) block","ingredient_name":"mozzarella cheese"},{"id":142046,"quantity":"6","ingredient_name":"tomatoes"},{"id":142042,"quantity":"","ingredient_name":"black pepper"},{"id":142044,"quantity":"","ingredient_name":"butter, unsalted"},{"id":142043,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":349.41,"alcohol":0.0,"ash":3.83,"caffeine":0.0,"water":238.71,"carbs":6.59,"fiber":1.61,"starch":0.08,"sugars":4.04,"fructose":1.73,"galactose":0.06,"glucose":2.19,"lactose":0.06,"maltose":0.02,"sucrose":0.01,"sugar_alcohol":0.0,"fat":25.02,"monounsaturated":8.25,"polyunsaturated":3.09,"omega_3":0.29,"omega_6":2.8,"saturated":11.59,"transfats":0.44,"cholesterol":528.93,"protein":24.24,"alanine":1.22,"arginine":1.27,"aspartic_acid":2.41,"cystine":0.41,"glutamic_acid":4.04,"glycine":0.75,"histidine":0.58,"isoleucine":1.24,"leucine":2.0,"lysine":1.52,"methionine":0.66,"phenylalanine":1.23,"proline":1.38,"serine":1.53,"threonine":1.06,"tryptophan":0.38,"tyrosine":0.98,"valine":1.54,"b1_thiamine":0.11,"b2_riboflavin":0.71,"b3_niacin":0.93
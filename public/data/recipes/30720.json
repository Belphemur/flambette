{"id":30720,"recipe_id":3442,"serving_count":6,"cooking_minutes":35,"name":"Sourdough Pizza Toasts with Prosciutto, Bell Pepper \u0026 Artichoke Greens","slug":"sourdough-pizza-toasts-prosciutto-bell-pepper-artichoke-greens","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3442/thumbnail_f4ee26e7-fc94-414f-bb77-9f02ddc1dc4b.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3442/presentation_f4ee26e7-fc94-414f-bb77-9f02ddc1dc4b.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":15,"name":"grater","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":18,"name":"spatula","slug":"spatula"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":487376,"primary_message":"Preheat oven to broil on high and position rack in the upper third of the oven.","secondary_message":null},{"id":487377,"primary_message":"Place oil, vinegar, mayo, salt, and pepper in a large bowl. Whisk to combine the dressing. ","secondary_message":"2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tbsp mayonnaise\n½ tsp salt\n¼ tsp black pepper"},{"id":487378,"primary_message":"Wash, dry, trim, and seed bell peppers; halve lengthwise, then slice into thin strips. Add half to the bowl with the dressing. (Reserve remaining bell pepper for the pizza toasts.)","secondary_message":"3 green bell peppers"},{"id":487379,"primary_message":"Drain and roughly chop artichoke hearts. Add to the bowl and set aside.","secondary_message":"3 (170 ml) jars artichoke hearts, marinated"},{"id":487380,"primary_message":"Divide bread between two large baking sheet pans. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven.","secondary_message":"12 slices sourdough bread"},{"id":487381,"primary_message":"Meanwhile, place tomato sauce and spices in a small bowl. Stir to combine the pizza sauce and set aside. ","secondary_message":"3 (213 ml) cans tomato sauce\n1 tbsp Italian seasoning\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"},{"id":487382,"primary_message":"Coarsely grate cheese. ","secondary_message":"1 (227 g) block mozzarella cheese"},{"id":487383,"primary_message":"Roughly chop olives.","secondary_message":"¾ cup Kalamata olives, pitted"},{"id":487384,"primary_message":"Chop or tear prosciutto into bite-sized pieces. ","secondary_message":"12 slices prosciutto"},{"id":487385,"primary_message":"Spread toasted bread with pizza sauce, then top with cheese, bell pepper, olives, and prosciutto. ","secondary_message":null},{"id":487386,"primary_message":"Working in batches, return baking sheets to the oven and broil until pizza toasts are warmed through and cheese is melted, 1-2 minutes. Remove from oven.","secondary_message":null},{"id":487387,"primary_message":"Meanwhile, wash and dry the mixed greens (skip this step if they came pre-washed). Add to the bowl with the dressing and veggies, then toss to combine the salad. ","secondary_message":"1 ½ (142 g) pkgs spring mix (mixed greens)"},{"id":487388,"primary_message":"To serve, divide pizza toasts and salad between plates. Enjoy!","secondary_message":null}],"line_items":[{"id":524050,"quantity":"3 (170 ml) jars","ingredient_name":"artichoke hearts, marinated"},{"id":524048,"quantity":"3","ingredient_name":"green bell peppers"},{"id":524046,"quantity":"¾ cup","ingredient_name":"Kalamata olives, pitted"},{"id":524038
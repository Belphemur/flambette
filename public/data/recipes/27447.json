{"id":27447,"recipe_id":3105,"serving_count":6,"cooking_minutes":25,"name":"Nutty Orange Dressed Apple, Pear \u0026 Grape Salad with Whipped Cream","slug":"nutty-orange-dressed-apple-pear-grape-salad-whipped-cream","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3105/thumbnail_70730893-4265-408c-b9ec-19810eca3b5d.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3105/presentation_70730893-4265-408c-b9ec-19810eca3b5d.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":52,"name":"grater (optional)","slug":"grater"},{"id":134,"name":"hand blender (optional)","slug":"hand-blender"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":441458,"primary_message":"Place a large bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)","secondary_message":null},{"id":441459,"primary_message":"Wash and dry the fresh produce.","secondary_message":"1 ½ oranges\n3 pears\n3 Gala apples\n0.68 kg red grapes"},{"id":441460,"primary_message":"Zest and juice oranges into another large bowl. Add maple syrup and spices, then stir to combine. ","secondary_message":"3 tbsp pure maple syrup\n¾ tsp cinnamon, ground\n¼ tsp cloves, ground\n3 pinch salt"},{"id":441461,"primary_message":"Quarter, core, and medium dice pears. Add to the bowl with the spiced dressing. ","secondary_message":null},{"id":441462,"primary_message":"Quarter, core, and medium dice apples. Add to the bowl. ","secondary_message":null},{"id":441463,"primary_message":"Halve grapes. Add to the bowl, stir to combine the fruit salad, and set aside. ","secondary_message":null},{"id":441464,"primary_message":"Roughly chop walnuts.","secondary_message":"⅓ cup walnuts"},{"id":441465,"primary_message":"Remove bowl from the freezer. Pour cold cream, maple syrup, and vanilla into the bowl.","secondary_message":"355 ml heavy whipping cream\n1 tbsp pure maple syrup\n¾ tsp vanilla extract"},{"id":441466,"primary_message":"Use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 4 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)","secondary_message":null},{"id":441467,"primary_message":"To serve, divide fruit salad between bowls, then top with whipped cream and walnuts. Enjoy!","secondary_message":null}],"line_items":[{"id":473081,"quantity":"3","ingredient_name":"Gala apples"},{"id":473082,"quantity":"355 ml","ingredient_name":"heavy whipping cream"},{"id":473078,"quantity":"1 ½","ingredient_name":"oranges"},{"id":473079,"quantity":"3","ingredient_name":"pears"},{"id":473077,"quantity":"0.68 kg","ingredient_name":"red grapes"},{"id":473080,"quantity":"⅓ cup","ingredient_name":"walnuts"},{"id":473074,"quantity":"","ingredient_name":"cinnamon, ground"},{"id":473083,"quantity":"","ingredient_name":"cloves, ground"},{"id":473076,"quantity":"","ingredient_name":"pure maple syrup"},{"id":473075,"quantity":"","ingredient_name":"salt"},{"id":473084,"quantity":"","ingredient_name":"vanilla extract"}],"nutrition":{"energy":470.57,"alcohol":0.19,"ash":1.79,"caffeine":0.0,"water":311.49,"carbs":62.22,"fiber":7.33,"starch":2.25,"sugars":48.67,"fructose":21.04,"galactose":0.0,"glucose":13.52,"lactose":1.66,"maltose":0.0,"sucrose":12.05,"sugar_alcohol":0.0,"fat":26.17,"monounsaturated":6.96,"polyunsaturated":3.64,"omega_3":0.85,"omega_6":2.79,"saturated":14.17,"transfats":0.79,"cholesterol":81.54,"protein":3.77,"alanine"
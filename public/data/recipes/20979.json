{"id":20979,"recipe_id":2399,"serving_count":6,"cooking_minutes":25,"name":"Crispy Prosciutto, Peach \u0026 Mozzarella Sandwich with Italian Salad","slug":"crispy-prosciutto-peach-mozzarella-sandwich-italian-salad","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2399/thumbnail_3d318c1c-1d7e-4abf-915c-a3c42d4ebe42.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2399/presentation_3d318c1c-1d7e-4abf-915c-a3c42d4ebe42.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":77,"name":"toaster (optional)","slug":"toaster"},{"id":35,"name":"tongs","slug":"tongs"}],"instructions":[{"id":350910,"primary_message":"Preheat oven to broil on high and position rack under the broiler.","secondary_message":null},{"id":350911,"primary_message":"Wash and dry the fresh produce.","secondary_message":"3 peaches\n3 tomatoes\n3 hearts romaine hearts"},{"id":350912,"primary_message":"Divide prosciutto between two large baking sheet pans and arrange in an single layer. Working in batches, place in the oven and broil until crispy, 2-3 minutes. Remove from oven.","secondary_message":"24 slices prosciutto"},{"id":350913,"primary_message":"Meanwhile, quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pit. Cut each quarter into thin wedges and place on a large plate.","secondary_message":null},{"id":350914,"primary_message":"Thinly slice tomatoes, then season with salt and pepper; add to the plate with the peach.","secondary_message":"3 pinch salt\n3 pinch black pepper"},{"id":350915,"primary_message":"Thinly slice mozzarella into rounds; add to the plate.","secondary_message":"1 ½ (227 g) pkg fresh mozzarella cheese"},{"id":350916,"primary_message":"Add one lettuce leaf per sandwich to the plate and set aside. Chop or tear remaining lettuce into bite-sized pieces and place in a large bowl.","secondary_message":null},{"id":350917,"primary_message":"Drain and thinly slice artichokes; add to the bowl with the lettuce and set aside.","secondary_message":"1 ½ (170 ml) jars artichoke hearts, marinated"},{"id":350918,"primary_message":"Toast bread if desired.","secondary_message":"12 slices whole grain bread"},{"id":350919,"primary_message":"Spread mayo over each bread slice. Layer half of the slices with lettuce, tomato, mozzarella, peach, and crispy prosciutto. Close with remaining bread slices.","secondary_message":"⅓ cup mayonnaise"},{"id":350920,"primary_message":"Add dressing to the bowl with the lettuce and artichokes; toss to combine the salad.","secondary_message":"⅓ cup Italian salad dressing"},{"id":350921,"primary_message":"To serve, divide salad and sandwiches between plates. Enjoy!","secondary_message":null}],"line_items":[{"id":374913,"quantity":"1 ½ (170 ml) jars","ingredient_name":"artichoke hearts, marinated"},{"id":374907,"quantity":"1 ½ (227 g) pkgs","ingredient_name":"fresh mozzarella cheese"},{"id":374914,"quantity":"90 ml","ingredient_name":"Italian salad dressing"},{"id":374909,"quantity":"3","ingredient_name":"peaches"},{"id":374912,"quantity":"24 slices","ingredient_name":"prosciutto"},{"id":374915,"quantity":"3 hearts","ingredient_name":"romaine hearts"},{"id":374910,"quantity":"3","ingredient_name":"tomatoes"},{"id":374908,"quantity":"12 slices","ingredient_name":"whole grain bread"},{"id":374905,"quantity":"","ingredient_name":"black pepper"},{"id":374911,"quantity":"","ingredient_name":"mayonnaise"},{"id":374906,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":653.42,"alcohol":0.0,"ash
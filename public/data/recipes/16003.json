{"id":16003,"recipe_id":1888,"serving_count":6,"cooking_minutes":40,"name":"Turkey \"Meatball\" Pita Pizza with Creamy Oregano \u0026 Olive Romaine Salad","slug":"turkey-meatball-pita-pizza-creamy-oregano-olive-romaine-salad","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1888/thumbnail_3a23810b-5e5b-4777-b96c-ec66625ae0a4.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1888/presentation_3a23810b-5e5b-4777-b96c-ec66625ae0a4.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":352218,"primary_message":"Preheat oven to 220°C (425°F).","secondary_message":null},{"id":352219,"primary_message":"Wash and dry the fresh produce.","secondary_message":"1 ½ red bell peppers\n1 ½ English cucumbers\n1 ½ heads romaine lettuce\n1 small bunch Italian (flat-leaf) parsley"},{"id":352220,"primary_message":"Place mayo, vinegar, and spices in a large bowl; whisk to combine the dressing.","secondary_message":"3 tbsp mayonnaise\n3 tbsp red wine vinegar\n1 ½ tsp oregano, dried\n½ tsp salt\n½ tsp black pepper"},{"id":352221,"primary_message":"Trim, seed, and small dice bell peppers; add to the bowl with the dressing.","secondary_message":null},{"id":352222,"primary_message":"Trim, halve lengthwise, and cut cucumbers crosswise into thin half-moons; add to the bowl.","secondary_message":null},{"id":352223,"primary_message":"Halve olives lengthwise and add to the bowl; set aside.","secondary_message":"⅓ cup Kalamata olives, pitted"},{"id":352224,"primary_message":"Peel and mince onion and garlic. ","secondary_message":"1 medium red onion\n3 cloves garlic"},{"id":352225,"primary_message":"Preheat a large skillet over medium heat.","secondary_message":null},{"id":352226,"primary_message":"Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, turkey, and spices; cook, breaking apart with a spoon, until browned and crumbly, 5-6 minutes.","secondary_message":"1 tbsp extra virgin olive oil\n1.02 kg ground turkey\n1 ½ tsp Italian seasoning\n¾ tsp crushed red pepper\n¾ tsp salt\n½ tsp black pepper"},{"id":352227,"primary_message":"Meanwhile, coarsely grate mozzarella and set aside.","secondary_message":"¾ (227 g) block mozzarella cheese"},{"id":352228,"primary_message":"Add tomato sauce to the skillet with the turkey and stir to combine. Remove from heat.","secondary_message":"3 (213 ml) cans tomato sauce"},{"id":352229,"primary_message":"Divide pitas between two baking sheet pans. Divide turkey mixture between the pitas and top with cheese. Place in the oven and bake until the cheese is melted, 5-6 minutes. Remove from oven and cut into wedges.","secondary_message":"6 whole grain pitas"},{"id":352230,"primary_message":"Meanwhile, chop or tear lettuce into bite-sized pieces and add to the bowl with the veggies.","secondary_message":null},{"id":352231,"primary_message":"Shave parsley leaves off the stems; discard the stems and mince the leaves. Add half to the bowl (reserving the rest for the pizzas) and toss to combine the salad.","secondary_message":null},{"id":352232,"primary_message":"To serve, divide pizzas and salad between plates. Sprinkle pizzas with reserved parsley and enjoy!","secondary_message":null}],"line_items":[{"id":376392,"quantity":"1 ½","ingredient_name":"English cucumbers"},{"id":376379,"quantity":"3 cloves","ingredient_name":"garlic"},{"id":376393,"quantity":"1.02 kg","ingredient_name":"ground turkey"},{"id":376389,"quantity":"1 small bunch","ingredient_name":"Italian (flat-leaf) parsley"},{"id":376395,"quantity":"⅓ cup","ingredient_name":"Kalamata olives, pitted"},{"id":376382,"quantity":"¾ (227 g) block","ingredient_name":"mozzarella cheese"},{"id":376391,"quantity":"1 ½","ingredient_name":"red bell peppers"},{"id":376394,"quantity":"1 medium","ingredient_name":"red onion"},{"id":376380,"quantity":"1 ½ heads","ingredient_name":"romaine lettuce"},{"id":376388,"quantity":"3 (213 ml) cans","ingredient_name":"tomato sauce"},{"id":376397,"quantity":"6","ingredient_name":"whole grain pitas"},{"id":376383,"quantity":"","ingredient_name":"black pepper"},{"id":376386,"quantity":"","ingredient_name":"crushed red pepper"},{"id":376381,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":376384,"quantity":"","ingredient_name":"Italian seasoning"},{"id":376396,"quantity":"","ingredient_name":"mayonnaise"},{"id":376385,"quantity":"","ingredient_name":"oregano, dried"},{"id":376390,"quantity":"","ingredient_name":"red wine vinegar"},{"id":376387,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":690.78,"alcohol":0.0,"ash":9.09,"caffeine":0.0,"water":538.81,"carbs":55.63,"fiber":12.21,"starch":28.78,"sugars":10.16,"fructose":4.79,"galactose":0.04,"glucose":4.84,"lactose":0.02,"maltose":0.08,"sucrose":0.59,"sugar_alcohol":0.0,"fat":32.26,"monounsaturated":9.67,"polyunsaturated":8.57,"omega_3":0.96,"omega_6":7.62,"saturated":8.84,"transfats":0.36,"cholesterol":144.28,"protein":50.82,"alanine":2.69,"arginine":3.07,"aspartic_acid":4.61,"cystine":0.57,"glutamic_acid":9.87,"glycine":2.39,"histidine":1.36,"isoleucine":2.2,"leucine":3.94,"lysine":3.64,"methionine":1.27,"phenylalanine":2.09,"proline":
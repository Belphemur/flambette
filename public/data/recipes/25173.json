ate.","secondary_message":null},{"id":404226,"primary_message":"Meanwhile, wash, dry, trim, and cut green onions crosswise into thin pieces. Place in a clean large bowl along with broccoli slaw and peanut sauce. Stir to combine.","secondary_message":"1 small bunch green onions (scallions)\n1 ½ (340 g) pkgs broccoli slaw\n½ cup peanut sauce"},{"id":404227,"primary_message":"To serve, divide chicken, mushrooms, and slaw between plates. Enjoy!","secondary_message":null}],"line_items":[{"id":432411,"quantity":"1 ½ (340 g) pkgs","ingredient_name":"broccoli slaw"},{"id":432409,"quantity":"1.36 kg","ingredient_name":"chicken thighs, boneless skinless"},{"id":432410,"quantity":"0.68 kg","ingredient_name":"cremini mushrooms"},{"id":432408,"quantity":"1 small bunch","ingredient_name":"green onions (scallions)"},{"id":432413,"quantity":"90 ml","ingredient_name":"miso paste, white"},{"id":432412,"quantity":"135 ml","ingredient_name":"peanut sauce"},{"id":432407,"quantity":"","ingredient_name":"black pepper"},{"id":432406,"quantity":"","ingredient_name":"soy sauce"},{"id":432405,"quantity":"","ingredient_name":"toasted sesame oil"}],"nutrition":{"energy":554.32,"alcohol":0.0,"ash":8.65,"caffeine":0.0,"water":395.92,"carbs":20.88,"fiber":4.3,"starch":2.87,"sugars":8.99,"fructose":2.26,"galactose":0.0,"glucose":3.05,"lactose":0.14,"maltose":0.17,"sucrose":3.43,"sugar_alcohol":0.0,"fat":28.83,"monounsaturated":10.94,"polyunsaturated":9.83,"omega_3":0.33,"omega_6":9.48,"saturated":5.45,"transfats":0.05,"cholesterol":213.07,"protein":54.62,"alanine":3.1,"arginine":3.56,"aspartic_acid":5.1,"cystine":0.56,"glutamic_acid":8.61,"glycine":2.36,"histidine":1.51,"isoleucine":2.45,"leucine":4.28,"lysine":4.73,"methionine":1.39,"phenylalanine":2.08,"proline":2.26,"serine":2.22,"threonine":2.42,"tryptophan":0.63,"tyrosine":1.88,"valine":2.53,"b1_thiamine":0.41,"b2_riboflavin":1.2,"b3_niacin":18.72,"b5_pantothenic_acid":2.33,"b6_pyridoxine":1.39,"b12_cobalamin":1.51,"choline":183.73,"folate":11
{"id":9442,"recipe_id":1083,"serving_count":6,"cooking_minutes":40,"name":"Pumpkin-Black Bean Soup with Sweet Potatoes \u0026 Tender Kale","slug":"pumpkin-black-bean-soup-sweet-potatoes-tender-kale","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1083/thumbnail_14e8bf36-ba9f-42ec-abc8-ee4af3649627.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1083/presentation_14e8bf36-ba9f-42ec-abc8-ee4af3649627.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"}],"instructions":[{"id":149993,"primary_message":"Wash and dry the fresh produce.","secondary_message":"3 (2 ½ cm) pieces ginger root\n3 jalapeño peppers\n0.68 kg sweet potato\n1 ½ bunches kale\n3 limes\n1 small bunch cilantro"},{"id":149994,"primary_message":"Peel and mince ginger and garlic. Peel and small dice onions.","secondary_message":"6 cloves garlic\n3 medium yellow onions"},{"id":149995,"primary_message":"Quarter the jalapeño peppers lengthwise; seed and remove ribs of the jalapeños with a spoon. Finely dice. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).","secondary_message":null},{"id":149996,"primary_message":"Heat a large pot over medium heat.","secondary_message":null},{"id":149997,"primary_message":"Once the pot is hot, add the oil and swirl to coat the bottom.","secondary_message":"3 tbsp extra virgin olive oil"},{"id":149998,"primary_message":"Add ginger, garlic, onion, and jalapeño to the pot; cook, stirring occasionally, 5-6 minutes.","secondary_message":null},{"id":149999,"primary_message":"Meanwhile, peel and dice sweet potatoes into ½-inch pieces.","secondary_message":null},{"id":150000,"primary_message":"Drain and rinse beans.","secondary_message":"1 ½ (398 ml) cans black beans"},{"id":150001,"primary_message":"Add sweet potato, beans, broth, tomatoes with their juices, pumpkin, coconut milk, and spices to the pot. Stir to combine.","secondary_message":"2129 ml chicken or vegetable broth\n3 (398 ml) cans diced tomatoes\n3 (398 ml) cans pure pumpkin purée\n1 ½ (398 ml) cans coconut milk\n1 tbsp salt\n1 tbsp chili powder\n1 ½ tsp cumin"},{"id":150002,"primary_message":"Bring to a boil over high heat, reduce heat to medium-low, and simmer until vegetables are tender, 15-20 minutes.","secondary_message":null},{"id":150003,"primary_message":"Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Set aside.","secondary_message":null},{"id":150004,"primary_message":"Fold kale leaves in half lengthwise and slice off stems. Chop or tear leaves into bite-sized pieces and add to pot during the last 5 minutes of cook time.","secondary_message":null},{"id":150005,"primary_message":"Juice limes into the pot and stir to combine.","secondary_message":null},{"id":150006,"primary_message":"Divide the soup between bowls and top with cilantro. Enjoy!","secondary_message":null}],"line_items":[{"id":156284,"quantity":"1 ½ (398 ml) cans","ingredient_name":"black beans"},{"id":156287,"quantity":"2129 ml","ingredient_name":"chicken or vegetable broth"},{"id":156286,"quantity":"1 small bunch","ingredient_name":"cilantro"},{"id":156275,"quantity":"1 ½ (398 ml) cans","ingredient_name":"coconut milk"},{"id":156279,"quantity":"3 (398 ml) cans","ingredient_name":"diced tomatoes"},{"id":156274,"quantity":"6 cloves
{"id":25359,"recipe_id":2868,"serving_count":6,"cooking_minutes":35,"name":"Black Bean-Ham Soup with Zucchini, Kale, Red Peppers \u0026 Tortilla Chips","slug":"black-bean-ham-soup-zucchini-kale-red-peppers-tortilla-chips","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2868/thumbnail_22ed3d9d-aca7-4ff8-9401-cac811fa118c.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2868/presentation_22ed3d9d-aca7-4ff8-9401-cac811fa118c.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":57,"name":"ladle","slug":"ladle"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":406928,"primary_message":"Wash, dry, trim, and small dice zucchini. Place in a medium bowl. ","secondary_message":"3 medium zucchini squash"},{"id":406929,"primary_message":"Drain and roughly chop roasted peppers. Add to the bowl with the zucchini. ","secondary_message":"1 ½ (340 g) jars roasted red bell peppers"},{"id":406930,"primary_message":"Small dice ham. Add to the bowl. ","secondary_message":"680 g ham steak, boneless"},{"id":406931,"primary_message":"Preheat a large pot over medium-high heat.","secondary_message":null},{"id":406932,"primary_message":"Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, ham, and spices; cook, stirring occasionally, until veggies start to soften, 3-4 minutes. ","secondary_message":"2 tbsp extra virgin olive oil\n2 tbsp chili powder\n¾ tsp salt\n½ tsp black pepper"},{"id":406933,"primary_message":"Meanwhile, drain and rinse beans. ","secondary_messa
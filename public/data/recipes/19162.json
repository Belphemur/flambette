{"id":19162,"recipe_id":2215,"serving_count":6,"cooking_minutes":40,"name":"Chicken, Bacon, Cabbage \u0026 Portobello Mushroom Stir-Up with Walnuts","slug":"chicken-bacon-cabbage-portobello-mushroom-stir-up-walnuts","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2215/thumbnail_765d50e8-38aa-4c13-94a1-c3ffe1bbc735.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2215/presentation_765d50e8-38aa-4c13-94a1-c3ffe1bbc735.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":126,"name":"slotted spoon","slug":"slotted-spoon"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":315553,"primary_message":"Medium dice bacon.","secondary_message":"12 slices bacon"},{"id":315554,"primary_message":"Preheat a large pot over medium-high heat.","secondary_message":null},{"id":315555,"primary_message":"Once the pot is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate. (Reserve pot with drippings for later use.)","secondary_message":null},{"id":315556,"primary_message":"While the bacon is cooking, pat chicken dry with paper towels and cut into bite-sized pieces.","secondary_message":"1.02 kg chicken thighs, boneless skinless"},{"id":315557,"primary_message":"Return pot with drippings to medium-high heat; add chicken and spices. Cook, stirring occasionally, until chicken is golden and cooked through, 6-7 minutes.","secondary_message":"1 ½ tsp thyme, dried\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"},{"id":315558,"primary_message":"Meanwhile, using a clean cutting board, peel and mince garlic; place in a large bowl.","secondary_message":"6 cloves garlic"},{"id":315559,"primary_message":"Wash and dry cabbages, then trim off and discard root ends; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the garlic.","secondary_message":"1 ½ medium heads napa cabbage"},{"id":315560,"primary_message":"Wash, dry, and halve mushrooms, then cut crosswise into ¼-inch thick slices; add to the bowl.","secondary_message":"6 caps portobello mushrooms"},{"id":315561,"primary_message":"When the chicken is done, add veggies and additional salt to the pot; continue to cook, stirring occasionally, until the veggies are fork-tender, 6-7 minutes more.","secondary_message":"¾ tsp salt"},{"id":315562,"primary_message":"Meanwhile, roughly chop walnuts.","secondary_message":"¾ cup walnuts"},{"id":315563,"primary_message":"When the veggies are done, drain off any excess cooking liquid from the pot, then add crispy bacon, walnuts, and vinegar. Stir to combine and remove from heat.","secondary_message":"3 tbsp apple cider vinegar"},{"id":315564,"primary_message":"To serve, divide stir-up between plates or bowls and enjoy!","secondary_message":null}],"line_items":[{"id":335411,"quantity":"12 slices","ingredient_name":"bacon"},{"id":335407,"quantity":"1.02 kg","ingredient_name":"chicken thighs, boneless skinless"},{"id":335401,"quantity":"6 cloves","ingredient_name":"garlic"},{"id":335410,"quantity":"1 ½ medium heads","ingredient_name":"napa cabbage"},{"id":335408,"quantity":"6 caps","ingredient_name":"portobello mushrooms"},{"id":335409,"quantity":"¾ cup","ingredient_name":"walnuts"},{"id":335406,"quantity":"","ingredient_name":"apple cider vinegar"},{"id":335402,"quantity":"","ingredient_name":"black pepper"},{"id":335403,"quantity":"","ingredient_name":"oregano, dried"},{"id":335404,"quantity":"","ingredient_na
{"id":11415,"recipe_id":1314,"serving_count":6,"cooking_minutes":30,"name":"Scrambled Tofu Breakfast Burrito with Carrot, Celery \u0026 Cilantro","slug":"scrambled-tofu-breakfast-burrito-carrot-celery-cilantro","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1314/thumbnail_302d91dc-00e5-44e8-90d7-31a3c690c10d.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1314/presentation_302d91dc-00e5-44e8-90d7-31a3c690c10d.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":192218,"primary_message":"Cut the tofu in half along the long side. Sandwich between clean towels or paper towels and place on a baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.","secondary_message":"3 (340 g) pkgs extra firm tofu"},{"id":192219,"primary_message":"Meanwhile, wash and dry the fresh produce.","secondary_message":"3 medium carrots\n3 sticks celery\n1 small bunch cilantro\n1 lime"},{"id":192220,"primary_message":"Preheat a large skillet over medium heat.","secondary_message":null},{"id":192221,"primary_message":"While the skillet heats up, peel and small dice onions.","secondary_message":"1 ½ medium red onions"},{"id":192222,"primary_message":"Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion and cook, stirring often, until slightly softened, about 6 minutes.","secondary_message":"3 tbsp extra virgin olive oil"},{"id":192223,"primary_message":"Meanwhile, peel and coarsely grate carrots. Trim and mince celery. Add both to the skillet and stir to combine. ","secondary_message":null},{"id":192224,"primary_message":"Peel and mince garlic; add to the skillet.","secondary_message":"6 cloves garlic"},{"id":192225,"primary_message":"Crumble the tofu with your fingers into the skillet. Add soy sauce and spices; increase heat to medium-high and continue to cook, stirring often, until veggies are soft and tofu begins to brown, 7-8 minutes more. Remove from heat.","secondary_message":"⅓ cup soy sauce\n2 ½ tsp turmeric\n2 ½ tsp curry powder\n2 ½ tsp cumin\n2 ½ tsp paprika"},{"id":192226,"primary_message":"Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.","secondary_message":null},{"id":192227,"primary_message":"Juice lime into the skillet; add cilantro and stir to combine.","secondary_message":null},{"id":192228,"primary_message":"Place tortillas on a flat surface, spread with mayo and top with tofu scramble. Tightly roll to close and cut in half. Enjoy! ","secondary_message":"6 large flour tortillas\n2 tbsp mayonnaise"}],"line_items":[{"id":200518,"quantity":"3 medium","ingredient_name":"carrots"},{"id":200517,"quantity":"3 sticks","ingredient_name":"celery"},{"id":200522,"quantity":"1 small bunch","ingredient_name":"cilantro"},{"id":200513,"quantity":"3 (340 g) pkgs","ingredient_name":"extra firm tofu"},{"id":200510,"quantity":"6 cloves","ingredient_name":"garlic"},{"id":200521,"quantity":"6","ingredient_name":"large flour tortillas"},{"id":200523,"quantity":"1","ingredient_name":"lime"},{"id":200519,"quantity":"1 ½ medium","ingredient_name":"red onions"},{"id":200520,"quantity":"","ingredient_name":"cumin, ground"},{"id":200514,"quantity":"","ingredient_name":"curry powder"},{"id":200511,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":200524
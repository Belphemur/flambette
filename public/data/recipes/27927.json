{"id":27927,"recipe_id":3140,"serving_count":6,"cooking_minutes":30,"name":"Savory Masala \"French Toast\" with Tomato, Shallot \u0026 Cilantro Salad","slug":"savory-masala-french-toast-tomato-shallot-cilantro-salad","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3140/thumbnail_899bd141-c0af-4e76-b262-abe2c74370ea.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3140/presentation_899bd141-c0af-4e76-b262-abe2c74370ea.jpeg","cookwares":[{"id":83,"name":"baking dish","slug":"baking-dish"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":18,"name":"spatula","slug":"spatula"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":447961,"primary_message":"Peel and mince shallots. Place in a medium bowl along with vinegar and salt. Stir to combine and set aside.","secondary_message":"2 shallots\n3 tbsp rice vinegar\n¾ tsp salt"},{"id":447962,"primary_message":"Place milk, eggs, and spices in a large baking dish. Whisk to combine the batter. ","secondary_message":"177 ml whole milk\n6 eggs\n2 ½ tsp garam masala\n¾ tsp salt\n½ tsp cayenne pepper\n½ tsp turmeric, ground"},{"id":447963,"primary_message":"Preheat a large skillet over medium heat.","secondary_message":null},{"id":447964,"primary_message":"While the skillet heats up, working in batches, place bread slices in the dish with the batter; turn the slices, making sure both sides are soaked through.","secondary_message":"12 slices sourdough bread"},{"id":447965,"primary_message":"Once the skillet is hot, add bu
{"id":5931,"recipe_id":398,"serving_count":6,"cooking_minutes":40,"name":"Thai Ground Beef \u0026 Carrot Lettuce Wraps","slug":"thai-ground-beef-carrot-lettuce-wraps","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/398/thumbnail_30e05ad3-d4d3-42f0-b581-8da0db5fbac0.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/398/presentation_30e05ad3-d4d3-42f0-b581-8da0db5fbac0.jpg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":52,"name":"grater (optional)","slug":"grater"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":59,"name":"stainless steel or cast iron skillet","slug":"stainless-steel-or-cast-iron-skillet"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":71435,"primary_message":"Wash and dry the fresh produce.","secondary_message":"3 heads butter (Boston) lettuce\n6 medium carrots\n3 limes\n3 (2 ½ cm) pieces ginger root\n1 ½ small bunch green onions (scallions)\n1 ½ small pkg fresh basil"},{"id":71434,"primary_message":"Juice the limes into a large bowl.","secondary_message":""},{"id":71433,"primary_message":"Add fish sauce, honey, sesame oil, and crushed red pepper to the lime juice; whisk together.","secondary_message":"6 tbsp fish sauce\n3 tsp honey\n¾ tsp toasted sesame oil\n⅜ tsp crushed red pepper"},{"id":71432,"primary_message":"Trim the ends and peel the carrots; discard the trimmings and coarsely grate the carrots. Add to the bowl.","secondary_message":""},{"id":71431,"primary_message":"Trim and discard the root ends of the green onions; chop the onions on an angle into 6-mm pieces. Add to the bowl.","secondary_message":""},{"id":71430,"primary_message":"Pick the basil leaves off the stems; discard the stems and thinly slice the leaves crosswise into ribbons. Add to the bowl.","secondary_message":""},{"id":71429,"primary_message":"Peel and mince or grate the ginger; transfer to a small bowl.","secondary_message":""},{"id":71428,"primary_message":"Peel and mince the garlic; add to the ginger.","secondary_message":"3 cloves garlic"},{"id":71427,"primary_message":"Heat a skillet over medium heat.","secondary_message":""},{"id":71426,"primary_message":"Separate the lettuce heads into leaves and place on a plate.","secondary_message":""},{"id":71425,"primary_message":"Add coconut oil to the skillet and swirl to coat the bottom.","secondary_message":"1 ½ tbsp virgin coconut oil"},{"id":71424,"primary_message":"Add the garlic and ginger to the skillet; cook until fragrant, 15 to 30 seconds.","secondary_message":""},{"id":71423,"primary_message":"Add ground beef to the skillet; cook, breaking apart with a spoon, until crumbly and browned, 3 to 4 minutes.","secondary_message":"1.02 kg lean ground beef"},{"id":71422,"primary_message":"To serve, spoon the ground beef into lettuce leaves and top with the carrot slaw. Enjoy!","secondary_message":""}],"line_items":[{"id":75633,"quantity":"3 heads","ingredient_name":"butter (Boston) lettuce"},{"id":75634,"quantity":"6 medium","ingredient_name":"carrots"},{"id":75625,"quantity":"1 ½ small pkgs","ingredient_name":"fresh basil"},{"id":75632,"quantity":"3 cloves","ingredient_name":"garlic"},{"id":75624,"quantity":"3 (2 ½ cm) pieces","ingredient_name":"ginger root"},{"id":75631,"quantity":"1 ½ small bunches","ingredient_name":"green onions (scallions)"},{"id":75635,"quantity":"1.02 kg","ingredient_name":"lean ground beef"},{"id":75628,"quantity":"3","ingredient_name":"limes"},{"id":75629,"qu
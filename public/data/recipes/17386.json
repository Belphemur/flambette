{"id":17386,"recipe_id":2065,"serving_count":6,"cooking_minutes":40,"name":"Italian Sausage Soup with Rotini Pasta, Bell Pepper, Tomato \u0026 Spinach","slug":"italian-sausage-soup-rotini-pasta-bell-pepper-tomato-spinach","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2065/thumbnail_0338b9a5-99d2-49e3-95e3-89caa82cd098.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2065/presentation_0338b9a5-99d2-49e3-95e3-89caa82cd098.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":57,"name":"ladle","slug":"ladle"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":323033,"primary_message":"Peel, halve, and small dice onions. ","secondary_message":"1 ½ medium yellow onions"},{"id":323034,"primary_message":"Peel and mince garlic. ","secondary_message":"6 cloves garlic"},{"id":323035,"primary_message":"Preheat a large pot over medium heat.","secondary_message":null},{"id":323036,"primary_message":"While the pot heats up, use the tip of a knife to slice down the length of each sausage; peel off casings and discard. ","secondary_message":"6 pork sausages"},{"id":323037,"primary_message":"Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, sausage, and spices; cook, breaking the meat apart with a spoon, until sausage is brown and crumbly, 6-8 minutes.","secondary_message":"2 tbsp extra virgin olive oil\n1 tbsp parsley flakes\n1 tbsp oregano, dried\n1 ½ tsp thyme, dried\n1 ½ tsp salt\n¾ tsp black pepper"},{"id":323038,"primary_message":"Meanwhile, wash and dry bell peppers; using a clean cutting board, trim, seed, and small dice. ","secondary_message":"3 red bell peppers"},{"id":323039,"primary_message":"When the sausage is done, add bell pepper to the pot and stir to combine. Continue to cook, stirring occasionally, until starting to soften, 4-5 minutes more.","secondary_message":null},{"id":323040,"primary_message":"Add broth, tomatoes, water, pasta, and vinegar to the pot; stir to combine. Cover and bring to a boil; once boiling, reduce heat to medium, and simmer until pasta is cooked through, 8-10 minutes.","secondary_message":"1420 ml chicken or vegetable broth\n3 (398 ml) cans diced tomatoes\n3 cup water\n255 g rotini pasta\n¼ cup balsamic vinegar"},{"id":323041,"primary_message":"While the soup is simmering, wash and dry the spinach (skip this step if the spinach came pre-washed), then roughly chop.","secondary_message":"3 (142 g) pkg baby spinach"},{"id":323042,"primary_message":"Finely grate Parmesan.","secondary_message":"85 g Parmesan cheese"},{"id":323043,"primary_message":"Add spinach to the soup in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from heat.","secondary_message":null},{"id":323044,"primary_message":"To serve, divide the soup between bowls and top with Parmesan. Enjoy!","secondary_message":null}],"line_items":[{"id":343965,"quantity":"3 (142 g) pkg","ingredient_name":"baby spinach"},{"id":343978,"quantity":"1420 ml","ingredient_name":"chicken or vegetable broth"},{"id":343973,"quantity":"3 (398 ml) cans","ingredient_name":"diced tomatoes"},{"id":343964,"quantity":"6 cloves","ingredient_name":"garlic"},{"id":343974,"quantity":"85 g","ingredient_name":"Parmesan cheese"},{"id":343979,"quantity":"6","ingredient_name":"pork sausages"},{"id":343976,"quantity":"3","ingredient_name":"red bell peppers"},{"id":343967,"quantity":"255 g","ingredient_name":"rotini pasta"},{"id":3439
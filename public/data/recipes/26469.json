{"id":26469,"recipe_id":2999,"serving_count":6,"cooking_minutes":30,"name":"Grilled Tomato-Garlic Chicken Thighs with Bell Pepper \u0026 Cabbage Salad","slug":"grilled-tomato-garlic-chicken-thighs-bell-pepper-cabbage-salad","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2999/thumbnail_48ab4105-7923-4c27-9909-f8f7fd33c836.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2999/presentation_48ab4105-7923-4c27-9909-f8f7fd33c836.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":45,"name":"grill pan, outdoor grill, or skillet","slug":"grill-pan-outdoor-grill-or-skillet"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"}],"instructions":[{"id":429690,"primary_message":"Mince anchovy fillets. Place in a large bowl along with tomato paste, oil, and spices. Stir to combine the marinade. ","secondary_message":"6 anchovy fillets, packed in oil\n6 tbsp tomato paste\n¼ cup extra virgin olive oil\n1 tbsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp crushed red pepper"},{"id":429691,"primary_message":"Pat chicken dry with paper towels and add to the bowl with the marinade. Using your hands, massage the marinade into the chicken. ","secondary_message":"1.36 kg chicken thighs, boneless skinless"},{"id":429692,"primary_message":"Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat. ","secondary_message":null},{"id":429693,"primary_message":"Once the grill pan is hot, coat with oil. Working in batches if necessary, add the chicken and grill until cooked through, 3-4 minutes per side. Remove to a plate. ","secondary_message":"2 tbsp extra virgin olive oil"},{"id":429694,"primary_message":"Meanwhile, wash and dry bell peppers. Using a clean cutting board, trim, seed, and medium dice the peppers. Place in a clean large bowl.","secondary_message":"3 red bell peppers"},{"id":429695,"primary_message":"Add shredded cabbage, pumpkin seeds, and dressing to the bowl with the bell pepper. Stir to combine the salad. ","secondary_message":"1 ½ (397 g) bags shredded cabbage (coleslaw mix)\n⅓ cup pumpkin seeds\n⅓ cup Italian salad dressing"},{"id":429696,"primary_message":"To serve, divide chicken and cabbage salad between plates. Enjoy!","secondary_message":null}],"line_items":[{"id":460437,"quantity":"6","ingredient_name":"anchovy fillets, packed in oil"},{"id":460434,"quantity":"1.36 kg","ingredient_name":"chicken thighs, boneless skinless"},{"id":460438,"quantity":"90 ml","ingredient_name":"Italian salad dressing"},{"id":460435,"quantity":"⅓ cup","ingredient_name":"pumpkin seeds"},{"id":460433,"quantity":"3","ingredient_name":"red bell peppers"},{"id":460439,"quantity":"1 ½ (397 g) bags","ingredient_name":"shredded cabbage (coleslaw mix)"},{"id":460436,"quantity":"6 tbsp","ingredient_name":"tomato paste"},{"id":460429,"quantity":"","ingredient_name":"black pepper"},{"id":460431,"quantity":"","ingredient_name":"crushed red pepper"},{"id":460428,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":460430,"quantity":"","ingredient_name":"garlic powder"},{"id":460432,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":551.47,"alcohol":0.0,"ash":6.33,"caffeine":0.0,"water":343.16,"carbs":16.77,"fiber":5.12,"starch":1.05,"sugars":9.47,"fructose":4.65,"galactose":0.0,"glucose":4.45,"lactose":0.0,"maltose":0.06,"sucrose":0.32,"sugar_alcohol":0.0,"fat":31.39,"monounsaturated":16.29,"polyunsaturated":6.83,"omega_3":0.56,"omega_6":6.27,"saturated":5.71,"transfats":0.08,"cholesterol":216.47,"protein":50.64,"alanine":2.92,"arginine":3.
{"id":10003,"recipe_id":1165,"serving_count":6,"cooking_minutes":30,"name":"Curried Chickpea Salad Flatbread Wrap with Lettuce, Tomato \u0026 Dill","slug":"curried-chickpea-salad-flatbread-wrap-lettuce-tomato-dill","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1165/thumbnail_9a7564fc-e799-4cf0-80be-50978569a9c9.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1165/presentation_9a7564fc-e799-4cf0-80be-50978569a9c9.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":125,"name":"parchment paper","slug":"parchment-paper"},{"id":16,"name":"potato masher","slug":"potato-masher"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":77,"name":"toaster (optional)","slug":"toaster"}],"instructions":[{"id":211499,"primary_message":"Wash and dry the fresh produce.","secondary_message":"1 lemon\n3 sticks celery\n1 small bunch green onions (scallions)\n1 small bunch fresh dill\n3 tomatoes\n1 head butter (Boston) lettuce"},{"id":211500,"primary_message":"Juice lemon into a large bowl.","secondary_message":null},{"id":211501,"primary_message":"Drain and rinse chickpeas. Transfer half of the chickpeas to the bowl with the lemon juice, along with mayonnaise and spices. Using a fork or potato masher, mash until smooth.","secondary_message":"3 (398 ml) cans garbanzo beans (chickpeas)\n⅓ cup vegan mayonnaise\n1 ½ tsp curry powder\n¾ tsp turmeric\n¾ tsp salt\n½ tsp black pepper\n½ tsp garlic powder"},{"id":211502,"primary_message":"Add remaining chickpeas to the bowl and stir to combine.","secondary_message":null},{"id":211503,"primary_message":"Small dice celery and add to the bowl.","secondary_message":null},{"id":211504,"primary_message":"Trim off and discard ends of the green onions; cut crosswise into ¼-inch pieces and transfer to the bowl.","secondary_message":null},{"id":211505,"primary_message":"Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the chickpea salad.","secondary_message":null},{"id":211506,"primary_message":"Warm flatbreads in a skillet, oven, or toaster (optional).","secondary_message":"6 flatbreads or naan"},{"id":211507,"primary_message":"Meanwhile, slice tomatoes into rounds.","secondary_message":null},{"id":211508,"primary_message":"Divide lettuce and tomato slices between flatbreads and season with salt and pepper. Top with curried chickpea salad.","secondary_message":"3 pinch salt\n3 pinch black pepper"},{"id":211509,"primary_message":"To make wraps easier to eat, place flatbreads on individual squares of parchment paper. Use the paper to tightly roll and secure each wrap. Otherwise eat as is and get a little messy! Enjoy!","secondary_message":null}],"line_items":[{"id":221567,"quantity":"1 head","ingredient_name":"butter (Boston) lettuce"},{"id":221563,"quantity":"3 sticks","ingredient_name":"celery"},{"id":221565,"quantity":"6","ingredient_name":"flatbreads or naan"},{"id":221568,"quantity":"1 small bunch","ingredient_name":"fresh dill"},{"id":221561,"quantity":"3 (398 ml) cans","ingredient_name":"garbanzo beans (chickpeas)"},{"id":221562,"quantity":"1 small bunch","ingredient_name":"green onions (scallions)"},{"id":221564,"quantity":"1","ingredient_name":"lemon"},{"id":221566,"quantity":"3","ingredient_name":"tomatoes"},{"id":221556,"quantity":"","ingredient_name":"black pepper"},{"id":221557,"quantity":"","ingredient_name":"curry powder"},{"id":221558,"quantity":"","ingredient_name":"garlic powder"},{"id":221559,"quantity":"","ingredient_name":"salt"},{"id":221560,"quantity":"","ingredient_name"
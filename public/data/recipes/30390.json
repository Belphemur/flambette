{"id":30390,"recipe_id":3387,"serving_count":6,"cooking_minutes":30,"name":"Cinnamon Apple \u0026 Banana Oatmeal Protein Bites","slug":"cinnamon-apple-banana-oatmeal-protein-bites","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3387/thumbnail_3012ccf3-953e-465c-bce8-1c1f657314d6.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3387/presentation_3012ccf3-953e-465c-bce8-1c1f657314d6.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":125,"name":"parchment paper","slug":"parchment-paper"},{"id":16,"name":"potato masher","slug":"potato-masher"},{"id":18,"name":"spatula","slug":"spatula"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":483619,"primary_message":"Preheat oven to 175°C (350°F). Line two large baking sheet pans with parchment paper.","secondary_message":null},{"id":483620,"primary_message":"Peel bananas, break into chunks, and place in a large bowl. Mash with a fork or potato masher until smooth.","secondary_message":"3 bananas"},{"id":483621,"primary_message":"Add eggs and maple syrup to the bowl with the banana. Stir to combine.","secondary_message":"3 eggs\n3 tbsp pure maple syrup"},{"id":483622,"primary_message":"Wash, dry, quarter, core, and small dice apples. Add to the bowl along with oats, protein powder, cinnamon, and salt. Stir once more to combine the batter.","secondary_message":"2 Gala apples\n2 ¼ cup oats, quick cooking\n3 servings vanilla whey-based protein powder (containing 20 grams protein/serving)\n1 ½ tsp cinnamon, ground\n3 pinch salt"},{"id":483623,"primary_message":"Using a ¼-cup measure, scoop batter onto the baking sheets, leaving some space between. Use the back of a spoon to spread each \"bite\" into a 3-inch circle. Place in the oven and bake until just firm to the touch, about 15 minutes. Remove from oven.","secondary_message":null},{"id":483624,"primary_message":"Allow to cool for a few minutes before transferring to plates. Enjoy!","secondary_message":null}],"line_items":[{"id":519726,"quantity":"3","ingredient_name":"bananas"},{"id":519724,"quantity":"3","ingredient_name":"eggs"},{"id":519725,"quantity":"2","ingredient_name":"Gala apples"},{"id":519721,"quantity":"","ingredient_name":"cinnamon, ground"},{"id":519727,"quantity":"","ingredient_name":"oats, quick cooking"},{"id":519723,"quantity":"","ingredient_name":"pure maple syrup"},{"id":519722,"quantity":"","ingredient_name":"salt"},{"id":519728,"quantity":"","ingredient_name":"vanilla whey-based protein powder (containing 20 grams protein/serving)"}],"nutrition":{"energy":304.84,"alcohol":0.0,"ash":3.01,"caffeine":0.0,"water":119.93,"carbs":50.77,"fiber":6.83,"starch":17.92,"sugars":19.95,"fructose":6.5,"galactose":0.0,"glucose":4.66,"lactose":0.0,"maltose":0.01,"sucrose":8.79,"sugar_alcohol":0.0,"fat":4.6,"monounsaturated":1.46,"polyunsaturated":1.24,"omega_3":0.06,"omega_6":1.13,"saturated":1.15,"transfats":0.01,"cholesterol":83.92,"protein":17.13,"alanine":0.34,"arginine":0.45,"aspartic_acid":0.71,"cystine":0.2,"glutamic_acid":1.25,"glycine":0.3,"histidine":0.16,"isoleucine":0.31,"leucine":0.55,"lysine":0.4,"methionine":0.15,"phenylalanine":0.36,"proline":0.26,"serine":0.44,"threonine":0.24,"tryptophan":0.09,"tyrosine":0.23,"valine":0.41,"b1_thiamine":0.25,"b2_riboflavin":0.55,"b3_niacin":0.58,"b5_pantothenic_acid":1.44,"b6_pyridoxine":0.17,"b12_cobalamin":0.51,"choline":108.41,"folate":26.28,"vitamin_a":153.51,"vitamin_c":2.82,"vitamin_d":18.04,"vitamin_e":0.48,"vitamin_k":2.22,"calcium":103.08,"copper":0
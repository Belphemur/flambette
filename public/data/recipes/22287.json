{"id":22287,"recipe_id":2526,"serving_count":6,"cooking_minutes":35,"name":"Thai Peanut-Coconut Soup with Parsnip, Zucchini \u0026 Butternut Squash","slug":"thai-peanut-coconut-soup-parsnip-zucchini-butternut-squash","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2526/thumbnail_adc1b10e-2469-49ba-89e7-94b6f072e080.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2526/presentation_adc1b10e-2469-49ba-89e7-94b6f072e080.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":57,"name":"ladle","slug":"ladle"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"}],"instructions":[{"id":372969,"primary_message":"Wash and dry the fresh produce. ","secondary_message":"6 medium parsnips\n3 medium zucchini squash\n1 small bunch cilantro\n1 ½ limes"},{"id":372970,"primary_message":"Peel, trim, and small dice parsnips. Place in a medium bowl. ","secondary_message":null},{"id":372971,"primary_message":"Place broth, coconut milk, peanut sauce, chili-garlic sauce, salt, and pepper in a large pot. Stir to combine the broth and bring to a boil over high heat. ","secondary_message":"2129 ml chicken or vegetable broth\n1 ½ (398 ml) cans coconut milk\n1 ½ cup peanut sauce\n1 tbsp chili-garlic sauce\n1 ½ tsp salt\n¾ tsp black pepper"},{"id":372972,"primary_message":"Meanwhile, trim and medium dice zucchini. Add to the pot along with parsnips. ","secondary_message":null},{"id":372973,"primary_message":"Once the soup is boiling, reduce heat to low an
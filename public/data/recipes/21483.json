{"id":21483,"recipe_id":2436,"serving_count":6,"cooking_minutes":30,"name":"White Bean, Asparagus \u0026 Mushroom Sauté over Parmesan Polenta","slug":"white-bean-asparagus-mushroom-saute-over-parmesan-polenta","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2436/thumbnail_08befe4b-8522-4890-82db-9c0f8e857e7e.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2436/presentation_08befe4b-8522-4890-82db-9c0f8e857e7e.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":16,"name":"potato masher","slug":"potato-masher"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":427932,"primary_message":"Medium dice polenta; place in a large pot along with broth, salt, and pepper. Bring to a simmer over medium-high heat.","secondary_message":"3 (510 g) tubes polenta, pre-cooked\n710 ml chicken or vegetable broth\n½ tsp salt\n3 pinch black pepper"},{"id":427933,"primary_message":"Once the broth is simmering, reduce heat to medium. Using a potato masher, mash the polenta until smooth; continue to cook, stirring occasionally, until heated through, 3-4 minutes more. Remove from heat and cover to keep warm.","secondary_message":null},{"id":427934,"primary_message":"Meanwhile, wash, dry, and snap (or cut) off woody ends of the asparagus; cut spears into 1-inch pieces.","secondary_message":"3 small bunches asparagus"},{"id":427935,"primary_message":"Preheat another large pot over medium-high heat.","secondary_message":null},{"id":427936,"primary_message":"While the pot heats up, peel and mince garlic.","secondary_message":"3 cloves garlic"},{"id":427937,"primary_message":"Once the pot is hot, add oil and swirl to coat the bottom. Add asparagus, garlic, mushrooms, and spices. Cook, stirring occasionally, until veggies are tender, 5-6 minutes.","secondary_message":"3 tbsp extra virgin olive oil\n3 (227g ) pkgs sliced white mushrooms\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"},{"id":427938,"primary_message":"Meanwhile, drain and rinse beans in a colander.","secondary_message":"3 (398 ml) cans cannellini (white kidney) beans"},{"id":427939,"primary_message":"Add beans and vinegar to the pot. Continue to cook, stirring occasionally, until beans are warmed through, 3-4 minutes. Remove from heat.","secondary_message":"⅓ cup balsamic vinegar"},{"id":427940,"primary_message":"Add Parmesan to the pot with the polenta and stir to combine.","secondary_message":"1 ½ cups Parmesan cheese, shredded"},{"id":427941,"primary_message":"To serve, divide polenta between plates or bowls; top with bean and veggie sauté. Sprinkle with basil and enjoy!","secondary_message":"¾ tsp basil, dried"}],"line_items":[{"id":458661,"quantity":"3 small bunches","ingredient_name":"asparagus"},{"id":458667,"quantity":"3 (398 ml) cans","ingredient_name":"cannellini (white kidney) beans"},{"id":458669,"quantity":"710 ml","ingredient_name":"chicken or vegetable broth"},{"id":458660,"quantity":"3 cloves","ingredient_name":"garlic"},{"id":458671,"quantity":"1 ½ cups","ingredient_name":"Parmesan cheese, shredded"},{"id":458670,"quantity":"3 (510 g) tubes","ingredient_name":"polenta, pre-cooked"},{"id":458672,"quantity":"3 (227g ) pkgs","ingredient_name":"sliced white mushrooms"},{"id":458668,"quantity":"","ingredient_name":"balsamic vinegar"},{"id":458663,"quantity":"","ingredient_name":"basil, dried"},{"id":458664,"quantity":"","ingredient_name":"black pepper"},{"id":458662,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":458665,"quantity":"","in
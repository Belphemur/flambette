{"id":29592,"recipe_id":3327,"serving_count":6,"cooking_minutes":30,"name":"Smoky Ground Beef Tacos with Lime-Dressed Broccoli Slaw \u0026 Sprouts","slug":"smoky-ground-beef-tacos-lime-dressed-broccoli-slaw-sprouts","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3327/thumbnail_f956ae54-2010-411f-b2fa-9bcf244633dc.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3327/presentation_f956ae54-2010-411f-b2fa-9bcf244633dc.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":471788,"primary_message":"Wash and dry the fresh produce.","secondary_message":"3 red bell peppers\n1 ½ limes\n1 ½ (3 oz) pkgs alfalfa sprouts"},{"id":471789,"primary_message":"Trim, seed, and small dice bell peppers. Place in a medium bowl. ","secondary_message":null},{"id":471790,"primary_message":"Peel, halve, and small dice onions. Peel and mince garlic. Add both to the bowl with the bell pepper.","secondary_message":"1 ½ medium red onions\n3 cloves garlic"},{"id":471791,"primary_message":"Preheat a large pot over medium-high heat. ","secondary_message":null},{"id":471792,"primary_message":"Once the pot is hot, add bell pepper, onion, garlic, beef, and spices to the pot. Cook, breaking the meat apart with a spoon, until browned and crumbly, 6-7 minutes. Remove from heat. (Reserve bowl for the next step.)","seconda
{"id":26139,"recipe_id":2942,"serving_count":6,"cooking_minutes":30,"name":"Grilled Salmon with Avocado-Corn Salsa \u0026 Dressed Arugula","slug":"grilled-salmon-avocado-corn-salsa-dressed-arugula","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2942/thumbnail_3b3266ed-52c9-4b0f-84ea-9fd0fe10344a.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2942/presentation_3b3266ed-52c9-4b0f-84ea-9fd0fe10344a.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":45,"name":"grill pan, outdoor grill, or skillet","slug":"grill-pan-outdoor-grill-or-skillet"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":18,"name":"spatula","slug":"spatula"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":415853,"primary_message":"Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.","secondary_message":null},{"id":415854,"primary_message":"While the pan heats up, pat salmon dry with paper towels. Place on a plate and season the top side with salt and pepper. ","secondary_message":"1.02 kg salmon fillet\n1 ½ tsp salt\n¾ tsp black pepper"},{"id":415855,"primary_message":"Once the pan is hot, coat with oil. Working in batches if necessary, add salmon, skin-side down, and cook, flipping once, until skin is crispy and flesh is opaque, 3-4 minutes per side. Transfer to a clean plate.","secondary_message":"2 tbsp extra virgin olive oil"},{"id":415856,"primary_message":"Meanwhile, place corn in a colander and rinse under hot water (from the tap) to defrost. Transfer to a medium bowl. ","secondary_message":"3 cups frozen corn"},{"id":415857,"primary_message":"Wash, dry, halve, and pit avocados; using a spoon, scoop out the flesh and small dice. Add to the bowl with the corn, along with the salsa, and stir to combine; set aside.","secondary_message":"3 avocados\n1 ½ cup salsa"},{"id":415858,"primary_message":"Wash and dry arugula (skip this step if it came pre-washed).","secondary_message":"1 ½ (142 g) pkgs baby arugula"},{"id":415859,"primary_message":"To serve, divide salmon, salsa, and arugula between plates; drizzle arugula with vinaigrette. Enjoy!","secondary_message":"⅓ cup French vinaigrette"}],"line_items":[{"id":445220,"quantity":"3","ingredient_name":"avocados"},{"id":445219,"quantity":"1 ½ (142 g) pkgs","ingredient_name":"baby arugula"},{"id":445223,"quantity":"90 ml","ingredient_name":"French vinaigrette"},{"id":445221,"quantity":"3 cups","ingredient_name":"frozen corn"},{"id":445215,"quantity":"1.02 kg","ingredient_name":"salmon fillet"},{"id":445222,"quantity":"1 ½ cups","ingredient_name":"salsa"},{"id":445217,"quantity":"","ingredient_name":"black pepper"},{"id":445216,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":445218,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":617.54,"alcohol":0.0,"ash":8.63,"caffeine":0.0,"water":381.98,"carbs":31.78,"fiber":10.84,"starch":10.5,"sugars":3.09,"fructose":2.93,"galactose":0.1,"glucose":2.8,"lactose":0.0,"maltose":0.12,"sucrose":1.46,"sugar_alcohol":0.0,"fat":37.47,"monounsaturated":16.98,"polyunsaturated":6.06,"omega_3":2.95,"omega_6":3.02,"saturated":5.53,"transfats":0.01,"cholesterol":76.5,"protein":43.4,"alanine":2.49,"arginine":2.37,"aspartic_acid":4.14,"cystine":0.45,"glutamic_acid":6.17,"glycine":1.94,"histidine":1.18,"isoleucine":1.84,"leucine":3.38,"lysine":3.69,"methionine":1.17,"phenylalanine":1.63,"proline":1.65,"serine":1.73,"threonine":1.75,"tryptophan":0.46,"tyrosine":1.37,"valine":2.1,"b1_thiamine":0.37,"b2_riboflavin":0.45,"b3_niacin":16.6,"b5_pantothenic_acid":3.43,"b6_pyridoxine":1.53,"b12_cobalamin":7.09,"choline":222.05,"folate":155.67,"vitamin_a":511.14,"vitamin_c
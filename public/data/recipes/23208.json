{"id":23208,"recipe_id":2598,"serving_count":6,"cooking_minutes":30,"name":"Penne Alfredo with Ham \u0026 Broccoli","slug":"penne-alfredo-ham-broccoli","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2598/thumbnail_37fe8b55-6507-4f0c-b606-af9137c61100.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2598/presentation_37fe8b55-6507-4f0c-b606-af9137c61100.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":382118,"primary_message":"Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.","secondary_message":"1 ½ tsp salt\n425 g penne pasta"},{"id":382119,"primary_message":"Meanwhile, peel, halve, and small dice onions. Peel and mince garlic.","secondary_message":"1 ½ medium yellow onions\n3 cloves garlic"},{"id":382120,"primary_message":"Preheat another large pot over medium-high heat.","secondary_message":null},{"id":382121,"primary_message":"Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, broccoli, salt, and pepper; cook, stirring occasionally, until veggies start to soften, 4-5 minutes.","secondary_message":"2 tbsp extra virgin olive oil\n1 ½ (510 g) bags broccoli florets\n½ tsp salt\n½ tsp black pepper"},{"id":382122,"primary_message":"Meanwhile, medium dice ham.","secondary_message":"680 g ham steak, boneless"},{"id":382123,"primary_message":"When the veggies are soft, add ham and Alfredo sauce to the pot. Stir to combine and continue to cook until heated through, 2-3 minutes more. Cover and remove from heat.","secondary_message":"1 ½ (454 g) jars Alfredo sauce"},{"id":382124,"primary_message":"When the pasta is done, drain in a colander. Add to the pot with the sauce and stir to combine.","secondary_message":null},{"id":382125,"primary_message":"To serve, divide pasta between plates or bowls and enjoy!","secondary_message":null}],"line_items":[{"id":407904,"quantity":"1 ½ (454 g) jars","ingredient_name":"Alfredo sauce"},{"id":407906,"quantity":"1 ½ (510 g) bags","ingredient_name":"broccoli florets"},{"id":407898,"quantity":"3 cloves","ingredient_name":"garlic"},{"id":407905,"quantity":"680 g","ingredient_name":"ham steak, boneless"},{"id":407900,"quantity":"425 g","ingredient_name":"penne pasta"},{"id":407903,"quantity":"1 ½ medium","ingredient_name":"yellow onions"},{"id":407901,"quantity":"","ingredient_name":"black pepper"},{"id":407899,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":407902,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":667.6,"alcohol":0.0,"ash":8.39,"caffeine":0.0,"water":318.11,"carbs":66.23,"fiber":6.13,"starch":44.69,"sugars":6.24,"fructose":1.31,"galactose":0.0,"glucose":1.26,"lactose":0.27,"maltose":1.66,"sucrose":0.75,"sugar_alcohol":0.0,"fat":28.13,"monounsaturated":10.03,"polyunsaturated":2.29,"omega_3":0.24,"omega_6":2.0,"saturated":13.42,"transfats":0.01,"cholesterol":103.21,"protein":38.11,"alanine":1.76,"arginine":2.06,"aspartic_acid":2.99,"cystine":0.55,"glutamic_acid":7.65,"glycine":1.59,"histidine":1.09,"isoleucine":1.44,"leucine":2.64,"lysine":2.28,"methionine":0.74,"phenylalanine":1.59,"proline":2.21,"serine":1.51,"threonine":1.43,"tryptophan":0.44,"tyrosine":0.97,"valine":1.55,"b1_thiamine":1.65,"b2_riboflavin":0.75,"b3_niacin":11.73,"b5_pantothenic_acid":1.78,"b6_pyridoxine":0.81,"b12_cobalamin":1.03,"choline":43.86,"folate":260.31,"vitamin_a":796.07,"vitamin_c":153.07,"vitamin_d":0.57,"vitamin_e":2.17,"vitamin_k":134.29,"calcium":165.82,"cop
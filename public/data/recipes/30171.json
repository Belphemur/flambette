{"id":30171,"recipe_id":3369,"serving_count":6,"cooking_minutes":40,"name":"Cheesy Pinto Bean, Carrot \u0026 Potato Soup with Lemon-Dijon Side Salad","slug":"cheesy-pinto-bean-carrot-potato-soup-lemon-dijon-side-salad","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3369/thumbnail_2388ebaf-25cf-40ff-ba2c-4e46b9dfd4eb.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3369/presentation_2388ebaf-25cf-40ff-ba2c-4e46b9dfd4eb.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":74,"name":"hand or regular blender","slug":"hand-or-regular-blender"},{"id":57,"name":"ladle","slug":"ladle"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":35,"name":"tongs","slug":"tongs"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":479703,"primary_message":"Wash and dry the fresh produce.","secondary_message":"6 medium yellow potatoes\n3 medium carrots\n1 ½ lemons\n1 ½ heads romaine lettuce"},{"id":479704,"primary_message":"Peel and medium dice potatoes. Place in a large pot.","secondary_message":null},{"id":479705,"primary_message":"Peel, trim, and medium dice carrots. Add to the pot with the potatoes.","secondary_message":null},{"id":479706,"primary_message":"Peel and mince garlic. Add to the pot.","secondary_message":"3 cloves garlic"},{"id":479707,"primary_message":"Add broth, beans with their liquid (do not drain), and spices to the pot; stir to combine the soup, then bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until veggies and beans are tender, 12-15 minutes.","secondary_message":"2129 ml chicken or vegetable broth\n3 (398 ml) cans pinto beans\n1 ½ tsp salt\n¾ tsp onion powder\n¾ tsp rosemary, dried\n¾ tsp crushed red pepper"},{"id":479708,"primary_message":"Meanwhile, peel and mince additional garlic. Place in a large bowl.","secondary_message":"3 cloves garlic"},{"id":479709,"primary_message":"Juice lemons into the bowl with the garlic. Add mayo, Dijon, soy sauce, salt, and pepper; whisk to combine the dressing.","secondary_message":"3 tbsp mayonnaise\n1 tbsp Dijon mustard\n1 ½ tsp soy sauce\n3 pinch salt\n3 pinch black pepper"},{"id":479710,"primary_message":"Chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the dressing, toss to combine the salad, and set aside.","secondary_message":null},{"id":479711,"primary_message":"When the soup is done, remove from the heat. Use a hand blender to purée the soup until smooth. (If using a regular blender, work in batches as needed, then return soup to the pot.) ","secondary_message":null},{"id":479712,"primary_message":"Coarsely grate cheese. Add to the soup and stir until melted and combined.","secondary_message":"¾ (227 g) block cheddar cheese"},{"id":479713,"primary_message":"Divide soup between bowls. Serve with salad on the side and enjoy!","secondary_message":null}],"line_items":[{"id":515368,"quantity":"3 medium","ingredient_name":"carrots"},{"id":515359,"quantity":"¾ (227 g) block","ingredient_name":"cheddar cheese"},{"id":515371,"quantity":"2129 ml","ingredient_name":"chicken or vegetable broth"},{"id":515357,"quantity":"6 cloves","ingredient_name":"garlic"},{"id":515369,"quantity":"1 ½","ingredient_name":"lemons"},{"id":515365,"quantity":"3 (398 ml) cans","ingredient_name":"pinto beans"},{"id":515358,"quantity":"1 ½ heads","i
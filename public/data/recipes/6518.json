{"id":6518,"recipe_id":692,"serving_count":6,"cooking_minutes":40,"name":"Cheesy Cheddar Broccoli \u0026 Chicken","slug":"cheesy-cheddar-broccoli-chicken","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/692/thumbnail_49ab815e-07c0-47c9-ad44-50afa4b37466.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/692/presentation_49ab815e-07c0-47c9-ad44-50afa4b37466.jpeg","cookwares":[{"id":83,"name":"baking dish","slug":"baking-dish"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":68,"name":"stainless steel sauté pan","slug":"stainless-steel-saute-pan"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":189892,"primary_message":"Preheat oven to 190°C (375°F).","secondary_message":null},{"id":189893,"primary_message":"Wash the broccoli and cut into bite-sized florets; transfer to a large pot. Fill with just enough water to cover florets and add salt to season.","secondary_message":"3 crowns broccoli\n1 ½ tsp salt"},{"id":189894,"primary_message":"Bring to a boil, then reduce heat to a simmer and cook until the broccoli is fork-tender, 5-6 minutes.","secondary_message":null},{"id":189895,"primary_message":"Add yogurt, mayo, curry powder, salt, pepper and garlic powder to a large mixing bowl.","secondary_message":"1 ½ cups plain Greek yogurt\n¾ cup mayonnaise\n¾ tsp curry powder\n¾ tsp salt\n¾ tsp black pepper\n¾ tsp garlic powder"},{"id":189896,"primary_message":"Coarsely grate the cheddar, set aside.","secondary_message":"1 ½ (227 g) blocks cheddar cheese"},{"id":189897,"primary_message":"When broccoli is done, drain well in a colander and add to a baking dish.","secondary_message":null},{"id":189898,"primary_message":"Pour yogurt mixture over broccoli and top with cheddar cheese. Bake in the oven for 10 minutes.","secondary_message":null},{"id":189899,"primary_message":"While broccoli mixture cooks, heat a large skillet over medium-high heat. ","secondary_message":null},{"id":189900,"primary_message":"Pat the chicken breasts dry with paper towel and place on a plate; season with salt and pepper on both sides.","secondary_message":"0.68 kg chicken breasts, boneless skinless\n3 pinch salt\n3 pinch black pepper"},{"id":189901,"primary_message":"Once the skillet is hot, add oil and swirl to coat the bottom.","secondary_message":"1 tbsp virgin coconut oil"},{"id":189902,"primary_message":"Working in batches if necessary, place the chicken breasts in the skillet; cook until the chicken is golden brown and cooked through, 4-5 minutes per side. Cook in batches if necessary.","secondary_message":null},{"id":189903,"primary_message":"To serve, divide broccoli and chicken between plates. Enjoy!","secondary_message":null}],"line_items":[{"id":197950,"quantity":"3 crowns","ingredient_name":"broccoli"},{"id":197944,"quantity":"1 ½ (227 g) blocks","ingredient_name":"cheddar cheese"},{"id":197945,"quantity":"0.68 kg","ingredient_name":"chicken breasts, boneless skinless"},{"id":197951,"quantity":"1 ½ cups","ingredient_name":"plain Greek yogurt"},{"id":197946,"quantity":"","ingredient_name":"black pepper"},{"id":197947,"quantity":"","ingredient_name":"curry powder"},{"id":197948,"quantity":"","ingredient_name":"garlic powder"},{"id":197953,"quantity":"","ingredient_name":"mayonnaise"},{"id":197949,"quantity":"","ingredient_name":"salt"},{"id":197952,"quantity":"","ingredient_name":"virgin coconut oil"}],"nutrition":{"energy":658.52,"alcohol":0.0,"ash":7.32,"caffeine":0.0,"water":236.69,"carbs":10.0,"fiber"
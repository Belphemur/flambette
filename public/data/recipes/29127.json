{"id":29127,"recipe_id":3256,"serving_count":6,"cooking_minutes":35,"name":"Smoked Salmon-Avocado Flatbread with Fennel, Cucumber \u0026 Sesame Seeds","slug":"smoked-salmon-avocado-flatbread-fennel-cucumber-sesame-seeds","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3256/thumbnail_568a640c-db0c-4326-a2c1-1607f9b69a3a.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3256/presentation_568a640c-db0c-4326-a2c1-1607f9b69a3a.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":16,"name":"potato masher","slug":"potato-masher"},{"id":35,"name":"tongs","slug":"tongs"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":464878,"primary_message":"Preheat oven to broil on high and position rack in the upper third of the oven.","secondary_message":null},{"id":464879,"primary_message":"Wash and dry the fresh produce.","secondary_message":"1 small bunch fresh dill\n3 limes\n3 fennel bulbs\n1 ½ English cucumbers\n1 ½ avocados"},{"id":464880,"primary_message":"Shave dill leaves off the stems; discard stems and mince the leaves. Place in a large bowl.","secondary_message":null},{"id":464881,"primary_message":"Juice limes into the bowl with the dill. Add yogurt, oil, salt, and pepper, then whisk to combine the dressing.","secondary_message":"⅓ cup plain Greek yogurt\n2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"},{"id":464882,"primary_message":"Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the dressing.","secondary_message":null},{"id":464883,"primary_message":"Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the bowl.","secondary_message":null},{"id":464884,"primary_message":"Divide flatbreads between two large baking sheet pans. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven.","secondary_message":"6 flatbreads or naan"},{"id":464885,"primary_message":"Meanwhile, chop or tear smoked salmon into bite-sized pieces.","secondary_message":"3 (113 g) pkgs smoked salmon"},{"id":464886,"primary_message":"Halve and pit avocados; using a spoon, scoop out the flesh and place in a small bowl. Mash with a fork or potato masher until smooth.","secondary_message":null},{"id":464887,"primary_message":"To serve, spread toasted flatbreads with mashed avocado, then top with salad and smoked salmon. Sprinkle with sesame seeds and enjoy!","secondary_message":"1 tbsp sesame seeds"}],"line_items":[{"id":498504,"quantity":"1 ½","ingredient_name":"avocados"},{"id":498502,"quantity":"1 ½","ingredient_name":"English cucumbers"},{"id":498509,"quantity":"3","ingredient_name":"fennel bulbs"},{"id":498505,"quantity":"6","ingredient_name":"flatbreads or naan"},{"id":498507,"quantity":"1 small bunch","ingredient_name":"fresh dill"},{"id":498506,"quantity":"3","ingredient_name":"limes"},{"id":498501,"quantity":"⅓ cup","ingredient_name":"plain Greek yogurt"},{"id":498508,"quantity":"3 (113 g) pkgs","ingredient_name":"smoked salmon"},{"id":498499,"quantity":"","ingredient_name":"black pepper"},{"id":498498,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":498500,"quantity":"","ingredient_name":"salt"},{"id":498503,"quantity":"","ingredient_name":"sesame seeds"}],"nutrition":{"energy":649.35,"alcohol":0.0,"ash":5.49,"caffeine":0.0,"wa
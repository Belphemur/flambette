{"id":21777,"recipe_id":2484,"serving_count":6,"cooking_minutes":35,"name":"\"Spinach \u0026 Artichoke Dip\" Gnocchi Bake with Cauliflower","slug":"spinach-artichoke-dip-gnocchi-bake-cauliflower","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2484/thumbnail_64fd0ac2-bb52-4bf0-9b2a-62cd23791238.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2484/presentation_64fd0ac2-bb52-4bf0-9b2a-62cd23791238.jpeg","cookwares":[{"id":83,"name":"baking dish","slug":"baking-dish"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":424148,"primary_message":"Preheat oven to 230°C (450°F).","secondary_message":null},{"id":424149,"primary_message":"Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat. ","secondary_message":null},{"id":424150,"primary_message":"While the water heats up, drain and roughly chop artichoke hearts. Divide between two large baking dishes. ","secondary_message":"3 (170 ml) jars artichoke hearts, marinated"},{"id":424151,"primary_message":"Add Alfredo sauce and spices to the baking dishes with the artichokes. Stir to combine and set aside. ","secondary_message":"1 ½ (454 g) jars Alfredo sauce\n1 ½ tsp onion powder\n¾ tsp salt\n¾ tsp black pepper"},{"id":424152,"primary_message":"Once the water in the pot is boiling, add gnocchi and cauliflower. Cook, stirring occasionally, until gnocchi begins to float to the surface, about 5 minutes.","secondary_message":"3 (454 g) pkgs potato gnocchi\n3 (283 g) bags cauliflower florets"},{"id":424153,"primary_message":"Meanwhile, place frozen spinach in a colander. ","secondary_message":"1 ½ (454 g) bags frozen chopped spinach"},{"id":424154,"primary_message":"When the gnocchi and cauliflower are done, drain in the colander over the spinach. ","secondary_message":null},{"id":424155,"primary_message":"Add gnocchi, cauliflower, and spinach to the baking dishes. Stir to combine with the sauce, then top with cheese.","secondary_message":"1 cup Parmesan cheese, shredded"},{"id":424156,"primary_message":"Place baking dishes in the oven and bake until cheese is golden, 10-12 minutes. Remove from oven. ","secondary_message":null},{"id":424157,"primary_message":"To serve, divide gnocchi bake between plates or bowls. Enjoy!","secondary_message":null}],"line_items":[{"id":454352,"quantity":"1 ½ (454 g) jars","ingredient_name":"Alfredo sauce"},{"id":454351,"quantity":"3 (170 ml) jars","ingredient_name":"artichoke hearts, marinated"},{"id":454354,"quantity":"3 (283 g) bags","ingredient_name":"cauliflower florets"},{"id":454355,"quantity":"1 ½ (454 g) bags","ingredient_name":"frozen chopped spinach"},{"id":454353,"quantity":"1 cup","ingredient_name":"Parmesan cheese, shredded"},{"id":454350,"quantity":"3 (454 g) pkgs","ingredient_name":"potato gnocchi"},{"id":454347,"quantity":"","ingredient_name":"black pepper"},{"id":454349,"quantity":"","ingredient_name":"onion powder"},{"id":454348,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":651.52,"alcohol":0.0,"ash":8.03,"caffeine":0.0,"water":536.43,"carbs":60.18,"fiber":12.71,"starch":33.26,"sugars":7.19,"fructose":1.75,"galactose":0.0,"glucose":1.98,"lactose":1.41,"maltose":0.02,"sucrose":0.85,"sugar_alcohol":0.0,"fat":37.95,"monounsaturated":9.6,"polyunsaturated":2.08,"omega_3":0.66,"omega_6":1.37,"saturated":23.22,"transfats":0.57,"cholesterol":102.85,"protein":23.95,"alanine":0.83,"arginine":1.18,"aspartic_acid":1.78,"cystine":0.2,"glutamic_acid":4.19,"glycine":0.65,"histidine":0.57,"isoleucine":0.86,"leuc
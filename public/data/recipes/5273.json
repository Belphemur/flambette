{"id":5273,"recipe_id":224,"serving_count":6,"cooking_minutes":40,"name":"Fettuccine Alfredo with Asparagus","slug":"fettuccine-alfredo-asparagus","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/224/thumbnail_efff3669-42b3-4af3-bae9-75eeb7e1b8d8.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/224/presentation_efff3669-42b3-4af3-bae9-75eeb7e1b8d8.jpg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":68,"name":"stainless steel sauté pan","slug":"stainless-steel-saute-pan"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":63428,"primary_message":"Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 9-10 minutes.","secondary_message":"about 21 cups water\n3 tbsp salt\n510 g (1 quarter coin = 57 g) fettuccine pasta"},{"id":63427,"primary_message":"Wash asparagus and snap off woody ends. Cut diagonally into 5 cm pieces. Add to pasta during the last 2-3 minutes of cooking time.","secondary_message":"3 small bunches asparagus"},{"id":63426,"primary_message":"Heat a sauté pan over medium heat.","secondary_message":""},{"id":63425,"primary_message":"Peel and mince garlic.","secondary_message":"6 cloves garlic"},{"id":63424,"primary_message":"Add butter to pan and swirl to coat. Add garlic and cook until fragrant, 15-30 seconds.","secondary_message":"3 tbsp butter, unsalted"},{"id":63423,"primary_message":"Sprinkle flour into pan and whisk until combined with the butter.","secondary_message":"4 ½ tbsp all-purpose flour"},{"id":63422,"primary_message":"Add broth and whisk until smooth. Then add milk and stir until sauce is thickened, 4-5 minutes.","secondary_message":"354 ml (1 ½ cup) chicken or vegetable broth\n354 ml (1 ½ cup) whole milk"},{"id":63421,"primary_message":"Finely grate ¾ cup of Parmesan.","secondary_message":"84 g Parmesan cheese"},{"id":63420,"primary_message":"Add Parmesan, salt, and pepper to sauce. Stir until smooth, then reduce heat to low until pasta is ready.","secondary_message":"¾ tsp salt\n⅜ tsp black pepper"},{"id":63417,"primary_message":"Drain pasta and asparagus in a colander, reserving about 1 ½ cup of the pasta water.","secondary_message":""},{"id":63419,"primary_message":"Add pasta, asparagus, and ½ of the reserved pasta water to sauce. Toss to combine. Add more pasta water to thin out the sauce if desired.","secondary_message":""},{"id":63418,"primary_message":"Place on a plate, garnish with freshly ground pepper, and enjoy!","secondary_message":""}],"line_items":[{"id":67814,"quantity":"3 small bunches","ingredient_name":"asparagus"},{"id":67805,"quantity":"354 ml","ingredient_name":"chicken or vegetable broth"},{"id":67807,"quantity":"510 g","ingredient_name":"fettuccine pasta"},{"id":67813,"quantity":"6 cloves","ingredient_name":"garlic"},{"id":67812,"quantity":"84 g","ingredient_name":"Parmesan cheese"},{"id":67811,"quantity":"354 ml","ingredient_name":"whole milk"},{"id":67810,"quantity":"","ingredient_name":"all-purpose flour"},{"id":67806,"quantity":"","ingredient_name":"black pepper"},{"id":67809,"quantity":"","ingredient_name":"butter, unsalted"},{"id":67808,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":519.35,"alcohol":0.0,"ash":4.44,"caffeine":0.0,"water":241.38,"carbs":77.87,"fiber":5.52,"starch":58.39,"sugars":7.84,"fructose":1.31,"galactose":0.0,"glucose":0.95,"lactose":3.23,"
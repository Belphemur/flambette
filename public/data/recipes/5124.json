{"id":5124,"recipe_id":211,"serving_count":6,"cooking_minutes":40,"name":"Soft Beef Tacos with Shredded Romaine, Cheddar \u0026 Spicy Salsa","slug":"soft-beef-tacos-shredded-romaine-cheddar-spicy-salsa","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/211/thumbnail_5e9107ab-7422-4023-97c4-0604955749a9.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/211/presentation_5e9107ab-7422-4023-97c4-0604955749a9.jpg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":15,"name":"grater","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":59,"name":"stainless steel or cast iron skillet","slug":"stainless-steel-or-cast-iron-skillet"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":61898,"primary_message":"Heat a skillet over medium-high heat.","secondary_message":""},{"id":61897,"primary_message":"Wash and dry lettuce, tomatoes, jalapeños, and green onions.","secondary_message":"1 ½ head romaine lettuce\n6 tomatoes\n3 jalapeño peppers\n1 ½ small bunch green onions (scallions)"},{"id":61896,"primary_message":"Add beef to the skillet and, breaking apart with a spoon, cook until beef is browned and crumbly, 3-4 minutes.","secondary_message":"1.02 kg lean ground beef"},{"id":61895,"primary_message":"Add chili powder, cumin, salt, and pepper to skillet and stir to combine with the beef. Remove skillet from heat.","secondary_message":"1 ½ tbsp chili powder\n3 tsp cumin\n⅜ tsp salt\n⅜ tsp black pepper"},{"id":61894,"primary_message":"Halve the lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Small dice the tomatoes. Seed and mince the jalapeños. Trim and discard root ends and chop green onions.","secondary_message":""},{"id":61893,"primary_message":"In a small bowl, prepare the salsa by mixing together tomatoes, jalapeño, onions, lime juice, salt, and pepper.","secondary_message":"juice of 1 ½ limes\n⅜ tsp salt\n3 pinches black pepper"},{"id":61892,"primary_message":"Grate 1 ½ cup of cheddar.","secondary_message":"¾ (227 g) block cheddar cheese"},{"id":61891,"primary_message":"To serve, fill tortillas with shredded lettuce, ground beef, and salsa. Sprinkle cheddar over top. Enjoy!","secondary_message":"24 small corn tortillas"}],"line_items":[{"id":65894,"quantity":"¾ (227 g) block","ingredient_name":"cheddar cheese"},{"id":65893,"quantity":"1 ½ small bunches","ingredient_name":"green onions (scallions)"},{"id":65886,"quantity":"3","ingredient_name":"jalapeño peppers"},{"id":65892,"quantity":"1.02 kg","ingredient_name":"lean ground beef"},{"id":65887,"quantity":"1 ½","ingredient_name":"limes"},{"id":65888,"quantity":"1 ½ heads","ingredient_name":"romaine lettuce"},{"id":65883,"quantity":"24","ingredient_name":"small corn tortillas"},{"id":65889,"quantity":"6","ingredient_name":"tomatoes"},{"id":65885,"quantity":"","ingredient_name":"black pepper"},{"id":65890,"quantity":"","ingredient_name":"chili powder"},{"id":65891,"quantity":"","ingredient_name":"cumin, ground"},{"id":65884,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":761.61,"alcohol":0.0,"ash":6.39,"caffeine":0.0,"water":469.72,"carbs":57.98,"fiber":12.57,"starch":37.04,"sugars":7.25,"fructose":3.48,"galactose":0.03,"glucose":2.85,"lactose":0.05,"maltose":0.32,"sucrose":0.69,"sugar_alcohol":0.0,"fat":39.15,"monounsaturated":14.33,"polyunsaturated":3.08,"omega_3":0.46,"omega_6":2.71,"saturated":15.83,"transfats":1.8,"cholesterol":144.54,"protein":47.95,"alanine":2.77,"arginine":2.66,"aspartic_acid":4.23,"cystine":0.5,"glutamic_acid":8.12,"glycine":2.68,"histidine":1.42,"isoleucine":2.07,"leucine":3.91,"lysine":3.24,"methionine":1.13,"phenylalanine":1.98,"prolin
{"id":4916,"recipe_id":202,"serving_count":6,"cooking_minutes":35,"name":"Margherita Pita Pizza with Spinach \u0026 Tomato Salad","slug":"margherita-pita-pizza-spinach-tomato-salad","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/202/thumbnail_01e3396b-e6e2-4d96-b209-c3bbaa97e4b6.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/202/presentation_01e3396b-e6e2-4d96-b209-c3bbaa97e4b6.jpg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":36,"name":"salad spinner (optional)","slug":"salad-spinner"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":59783,"primary_message":"Preheat oven to 200°C (400°F).","secondary_message":""},{"id":59782,"primary_message":"Peel and mince garlic. In a small bowl, mix together garlic and oil.","secondary_message":"6 cloves garlic\n3 tbsp extra virgin olive oil"},{"id":59781,"primary_message":"Wash and dry tomatoes and basil. Slice three tomatoes into rounds and the other three into wedges. Pick basil leaves off the stems; discard the stems.","secondary_message":"6 tomatoes\n1 ½ small pkg fresh basil"},{"id":59780,"primary_message":"Grate 3 cups of mozzarella.","secondary_message":"1 ½ (227 g) block mozzarella cheese"},{"id":59779,"primary_message":"Place pitas on a flat surface. Spoon olive oil and garlic mixture over top, add tomato slices (save the wedges for the salad), and sprinkle with mozzarella.","secondary_message":"6 whole grain pita breads"},{"id":59778,"primary_message":"Place in the oven, directly on the rack, and bake until cheese melts and crust is crispy, 8-10 minutes. Then add basil leaves and broil until cheese begins to brown, 1-2 minutes.","secondary_message":""},{"id":59777,"primary_message":"In a large bowl, prepare salad dressing by whisking together oil, vinegar, Dijon, salt, and pepper.","secondary_message":"4 ½ tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n⅜ tsp Dijon mustard\n3 pinches salt\n3 pinches black pepper"},{"id":59776,"primary_message":"Wash and dry baby spinach. Add spinach and remaining tomatoes to bowl with dressing and toss.","secondary_message":"1 ½ (142 g) pkg baby spinach"},{"id":59775,"primary_message":"To serve, place pizza wedges on a plate and have with salad on the side. Enjoy!","secondary_message":""}],"line_items":[{"id":63331,"quantity":"1 ½ (142 g) pkg","ingredient_name":"baby spinach"},{"id":63330,"quantity":"1 ½ small pkgs","ingredient_name":"fresh basil"},{"id":63329,"quantity":"6 cloves","ingredient_name":"garlic"},{"id":63327,"quantity":"1 ½ (227 g) blocks","ingredient_name":"mozzarella cheese"},{"id":63326,"quantity":"6","ingredient_name":"tomatoes"},{"id":63324,"quantity":"6","ingredient_name":"whole grain pitas"},{"id":63323,"quantity":"","ingredient_name":"black pepper"},{"id":63328,"quantity":"","ingredient_name":"Dijon mustard"},{"id":63322,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":63325,"quantity":"","ingredient_name":"red wine vinegar"},{"id":63321,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":529.44,"alcohol":0.0,"ash":4.74,"caffeine":0.0,"water":208.7,"carbs":43.77,"fiber":7.2,"starch":28.1,"sugars":4.55,"fructose":1.86,"galactose":0.14,"glucose":2.42,"lactose":0.04,"maltose":0.09,"sucrose":0.22,"sugar_alcohol":0.0,"fat":31.93,"monounsaturated":16.5,"polyunsaturated":3.11,"omega_3":0.45,"omega_6":2.66,"saturated":10.15,"transfats":0.33,"cholesterol":44.83,"protein":21.39,"alanine":0.72,"arginine":0.7,"aspartic_acid":1.53,"cystine":0.24,"glutamic_acid":5.25,"glycine":0.63,"histidine":0.48,"isoleucine":0.97,"leucine":1.6,"
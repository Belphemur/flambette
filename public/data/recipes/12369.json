{"id":12369,"recipe_id":1450,"serving_count":6,"cooking_minutes":40,"name":" Caesar Salad with Tomatoes \u0026 Creamy Dijon Deviled Eggs","slug":"caesar-salad-tomatoes-creamy-dijon-deviled-eggs","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1450/thumbnail_830d6914-1fd4-4f94-9dbf-c30107db3729.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1450/presentation_830d6914-1fd4-4f94-9dbf-c30107db3729.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":375630,"primary_message":"Place eggs in a large pot, cover with water and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.","secondary_message":"12 eggs"},{"id":375631,"primary_message":"Meanwhile, wash and dry the fresh produce.","secondary_message":"1 ½ lemons\n3 tomatoes\n3 heads romaine lettuce"},{"id":375632,"primary_message":"Grate Parmesan into a large bowl.","secondary_message":"85 g Parmesan cheese"},{"id":375633,"primary_message":"Peel and mince garlic; add to bowl with the Parmesan.","secondary_message":"3 cloves garlic"},{"id":375634,"primary_message":"Mince anchovy fillets and add to the bowl.","secondary_message":"3 anchovy fillets, packed in oil"},{"id":375635,"primar
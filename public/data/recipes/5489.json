{"id":5489,"recipe_id":277,"serving_count":6,"cooking_minutes":50,"name":"Chicken Cauliflower Fried 'Rice' with Carrots \u0026 Peas","slug":"chicken-cauliflower-fried-rice-carrots-peas","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/277/thumbnail_f55acb99-973b-4fb8-b710-0fec49acd65c.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/277/presentation_f55acb99-973b-4fb8-b710-0fec49acd65c.jpg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":87,"name":"grater or food processor","slug":"grater-or-food-processor"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":27,"name":"stainless steel skillet","slug":"stainless-steel-skillet"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":65846,"primary_message":"Wash cauliflower and cut off the leaves. Rice (grate) using a hand grater or in a food processor.","secondary_message":"3 medium heads cauliflower"},{"id":65845,"primary_message":"Wash carrots and green onions.","secondary_message":"3 medium carrots\n1 ½ small bunch green onions (scallions)"},{"id":65833,"primary_message":"Trim ends, peel, and small dice carrots; transfer to a medium bowl. Trim ends and slice green onions on the diagonal into ⅔ cm pieces; transfer to a small bowl.","secondary_message":""},{"id":65844,"primary_message":"Measure out peas and add to bowl with carrots.","secondary_message":"1 ½ cup frozen peas"},{"id":65843,"primary_message":"Peel and mince garlic. Peel and mince ginger. Transfer both to a small bowl.","secondary_message":"6 cloves garlic\n3 (2 ½ cm) pieces ginger root"},{"id":65842,"primary_message":"Heat a skillet over medium-high heat.","secondary_message":""},{"id":65832,"primary_message":"Cube chicken into bite-sized pieces. Season with salt and freshly ground pepper.","secondary_message":"1.02 kg chicken breasts, boneless skinless\n⅜ tsp salt\n⅜ tsp black pepper"},{"id":65841,"primary_message":"Coat bottom of skillet with oil. Add chicken and stir-fry until browned, 3-4 minutes. Transfer to a plate.","secondary_message":"1 ½ tbsp toasted sesame oil"},{"id":65840,"primary_message":"Add more oil to skillet followed by garlic and ginger. Stir fry until fragrant, 15-30 seconds.","secondary_message":"3 tbsp toasted sesame oil"},{"id":65839,"primary_message":"Add carrots and peas; stir-fry until tender-crisp, 3-4 minutes.","secondary_message":""},{"id":65838,"primary_message":"Add cauliflower rice, mix well, and stir-fry until tender, 2-3 minutes.","secondary_message":""},{"id":65837,"primary_message":"In a medium bowl, whisk eggs.","secondary_message":"3 eggs"},{"id":65836,"primary_message":"Move all the ingredients to one side of the skillet and pour eggs on the other side. Scramble eggs and mix with everything else.","secondary_message":""},{"id":65835,"primary_message":"Return chicken to skillet and add soy sauce and green onions; stir to combine.","secondary_message":"6 tbsp soy sauce"},{"id":65834,"primary_message":"Serve in a bowl and enjoy!","secondary_message":""}],"line_items":[{"id":70452,"quantity":"3 medium","ingredient_name":"carrots"},{"id":70451,"quantity":"3 medium heads","ingredient_name":"cauliflower"},{"id":70441,"quantity":"1.02 kg","ingredient_name":"chicken breasts, boneless skinless"},{"id":70450,"quantity":"3","ingredient_name":"eggs"},{"id":70446,"quantity":"1 ½ cups","ingredient_name":"frozen peas"},{"id":70449,"quantity":"6 cloves","ingredient_name":"garlic"},{"id":70448,"quantity":"3 (2 ½ cm) pieces","ingredient_name":"ginger root"},{"id":70447,"quantity":"1 ½ small bunches",
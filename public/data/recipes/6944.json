{"id":6944,"recipe_id":787,"serving_count":6,"cooking_minutes":20,"name":"Bacon \u0026 Egg Bowl with Wilted Kale","slug":"bacon-egg-bowl-wilted-kale","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/787/thumbnail_ea12ae2f-ded2-44cf-85dd-17a0be2e268c.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/787/presentation_ea12ae2f-ded2-44cf-85dd-17a0be2e268c.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":18,"name":"spatula","slug":"spatula"},{"id":59,"name":"stainless steel or cast iron skillet","slug":"stainless-steel-or-cast-iron-skillet"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":373077,"primary_message":"Wash kale, fold leaves in half lengthwise, and slice off the stems. Chop or tear leaves into bite-sized pieces and set aside. ","secondary_message":"1 ½ bunches kale"},{"id":373078,"primary_message":"Preheat a stainless steel or cast iron skillet over medium-high heat.","secondary_message":null},{"id":373079,"primary_message":"Chop bacon into 1-inch pieces; add to the skillet and cook until crispy, 4-5 minutes. ","secondary_message":"18 slices bacon"},{"id":373080,"primary_message":"Meanwhile, peel and mince garlic.","secondary_message":"3 cloves garlic"},{"id":373081,"primary_message":"Once bacon is cooked, tilt the skillet and use a spoon to remove and discard half of the bacon drippings. ","secondary_message":null},{"id":373082,"primary_message":"Add kale, crushed red pepper, garlic, salt, and pepper to the skillet. Cook, stirring occasionaly, until kale is wilted, 2-3 minutes. Cover the skillet with a large lid to help the wilting process. ","secondary_message":"1 ½ tsp crushed red pepper\n¾ tsp salt\n¾ tsp black pepper"},{"id":373083,"primary_message":"Place a non-stick skillet over medium-high heat and add butter. ","secondary_message":"1 ½ tbsp butter, unsalted"},{"id":373084,"primary_message":"Once the butter begins to bubble, gently crack the eggs into the skillet. Cook until the tops of the whites are set but the yolks are still runny, 3-4 minutes. Cook in batches. ","secondary_message":"12 eggs"},{"id":373085,"primary_message":"To serve, arrange kale, bacon, and eggs in bowls. Season with salt and pepper and enjoy! ","secondary_message":"3 pinch salt\n3 pinch black pepper"}],"line_items":[{"id":397883,"quantity":"18 slices","ingredient_name":"bacon"},{"id":397881,"quantity":"12","ingredient_name":"eggs"},{"id":397876,"quantity":"3 cloves","ingredient_name":"garlic"},{"id":397882,"quantity":"1 ½ bunches","ingredient_name":"kale"},{"id":397877,"quantity":"","ingredient_name":"black pepper"},{"id":397880,"quantity":"","ingredient_name":"butter, unsalted"},{"id":397878,"quantity":"","ingredient_name":"crushed red pepper"},{"id":397879,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":526.49,"alcohol":0.0,"ash":4.4,"caffeine":0.0,"water":139.57,"carbs":6.7,"fiber":1.05,"starch":0.73,"sugars":1.89,"fructose":0.11,"galactose":0.0,"glucose":0.47,"lactose":0.02,"maltose":0.0,"sucrose":1.31,"sugar_alcohol":0.0,"fat":45.0,"monounsaturated":18.66,"polyunsaturated":7.39,"omega_3":0.43,"omega_6":6.95,"saturated":15.82,"transfats":0.26,"cholesterol":390.54,"protein":23.19,"alanine":1.33,"arginine":1.49,"aspartic_acid":2.3,"cystine":0.38,"glutamic_acid":3.27,"glycine":0.93,"histidine":0.74,"isoleucine":1.18,"leucine":1.93,"lysine":1.83,"methionine":0.64,"phenylalanine":1.11,"proline":0.97,"serine":1.36,"threonine":1.02,"tryptophan":0.29,"tyrosine":0.91,"valine":1.37,"b1_thiamine":0.32,"b2_riboflavin":0.53,"b3_niacin":3.9,"b5_pantothenic_acid":1.87,"b6_pyridoxine":0.51,"b12_cobalamin":1.21,"choline":300.27,"folate":53.65,"vitamin_a
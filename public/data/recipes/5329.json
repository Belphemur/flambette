s, apples, and green onions.","secondary_message":"3 medium turnips\n3 medium carrots\n3 Gala apples\n1 ½ small bunch green onions (scallions)"},{"id":64071,"primary_message":"Trim ends and peel turnips and carrots; coarsely grate and add to bowl with dressing. Core, coarsely grate, and add apples to bowl. Trim and discard root ends of onions, thinly slice, and add to bowl. Toss salad.","secondary_message":""},{"id":64070,"primary_message":"Serve steak with slaw on the side and enjoy!","secondary_message":""}],"line_items":[{"id":68528,"quantity":"3 medium","ingredient_name":"carrots"},{"id":68530,"quantity":"3","ingredient_name":"Gala apples"},{"id":68526,"quantity":"3 cloves","ingredient_name":"garlic"},{"id":68525,"quantity":"1 ½ small bunches","ingredient_name":"green onions (scallions)"},{"id":68529,"quantity":"1 ½","ingredient_name":"lemons"},{"id":68520,"quantity":"1.02 kg","ingredient_name":"ribeye steak"},{"id":68524,"quantity":"3 medium","ingredient_name":"turnips"},{"id":68523,"quantity":"","ingredient_name":"apple cider vinegar"},{"id":68522,"quantity":"","ingredient_name":"black pepper"},{"id":68527,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":68532,"quantity":"","ingredient_name":"honey"},{"id":68531,"quantity":"","ingredient_name":"salt"},{"id":68521,"quantity":"","ingredient_name":"virgin coconut oil"}],"nutrition":{"energy":646.95,"alcohol":0.0,"ash":3.42,"caffeine":0.0,"water":302.67,"carbs":24.27,"fiber":4.93,"starch":3.18,"sugars":15.61,"fructose":7.49,"galactose":0.06,"glucose":4.83,"lactose":0.0,"maltose":0.03,"sucrose":3.45,"sugar_alcohol":0.0,"fat":48.06,"monounsaturated":21.27,"polyunsaturated":2.57,"omega_3":0.15,"omega_6":2.42,"saturated":21.84,"transfats":2.13,"cholesterol":115.6,"protein":32.96,"alanine":2.02,"arginine":2.2,"aspartic_acid":3.23,"cystine":0.35,"glutamic_acid":5.41,"glycine":1.61,"histidine":1.19,"isoleucine":1.53,"leucine":2.77,"lysine":3.05,"methionine":0.86,"phenylalanine":1.3,"proline":1.47,"serine":
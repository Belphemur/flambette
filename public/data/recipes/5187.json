{"id":5187,"recipe_id":213,"serving_count":6,"cooking_minutes":40,"name":"Shrimp, Avocado \u0026 Grapefruit Salad","slug":"shrimp-avocado-grapefruit-salad","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/213/thumbnail_38d526b4-1345-424c-a01c-d0dce2bfbc8d.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/213/presentation_38d526b4-1345-424c-a01c-d0dce2bfbc8d.jpg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":36,"name":"salad spinner (optional)","slug":"salad-spinner"},{"id":27,"name":"stainless steel skillet","slug":"stainless-steel-skillet"},{"id":35,"name":"tongs","slug":"tongs"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":62478,"primary_message":"If using frozen shrimp, place in a medium bowl, cover with water, and set aside to thaw. If using fresh shrimp, skip this step.","secondary_message":"1.02 kg raw peeled shrimp, fresh or frozen"},{"id":62477,"primary_message":"Wash and dry the lettuce. Tear into smaller pieces.","secondary_message":"3 head butter (Boston) lettuce"},{"id":62476,"primary_message":"Wash and quarter grapefruit. Peel and slice 9 of the quarters into wedges (save 3 for the dressing). Halve and pit avocado; thinly slice flesh while still in skin and scoop out (save a quarter of the avocado for the dressing).","secondary_message":"3 grapefruit\n3 avocados"},{"id":62475,"primary_message":"Wash and juice the lime and remaining grapefruit wedge into a small bowl; add saved avocado and mash thoroughly. Add honey, salt, and pepper; whisk to combine and set aside.","secondary_message":"½ lime\n¼ tsp honey\n¼ tsp salt\n¼ tsp black pepper"},{"id":62474,"primary_message":"Heat a skillet over medium-high heat.","secondary_message":""},{"id":62473,"primary_message":"Peel and mince garlic.","secondary_message":"3 cloves garlic"},{"id":62472,"primary_message":"Drain and rinse shrimp under cold water until there are no more ice chunks. Place on paper towels and pat dry. If using fresh shrimp, skip this step.","secondary_message":""},{"id":62471,"primary_message":"Coat bottom of skillet with oil. Add garlic and cook until fragrant, 15-30 seconds. Add shrimp and cook until opaque, 2-3 minutes.","secondary_message":"3 tbsp virgin coconut oil"},{"id":62470,"primary_message":"To serve, arrange lettuce on a plate and top with avocado, grapefruit, and shrimp. Drizzle with dressing and enjoy!","secondary_message":""}],"line_items":[{"id":66709,"quantity":"3","ingredient_name":"avocados"},{"id":86607,"quantity":"3 heads","ingredient_name":"butter (Boston) lettuce"},{"id":66715,"quantity":"3 cloves","ingredient_name":"garlic"},{"id":66708,"quantity":"3","ingredient_name":"grapefruits"},{"id":86613,"quantity":"1 ½","ingredient_name":"limes"},{"id":66714,"quantity":"1.02 kg","ingredient_name":"raw peeled shrimp, fresh or frozen"},{"id":66713,"quantity":"","ingredient_name":"black pepper"},{"id":66711,"quantity":"","ingredient_name":"honey"},{"id":66710,"quantity":"","ingredient_name":"salt"},{"id":66705,"quantity":"","ingredient_name":"virgin coconut oil"}],"nutrition":{"energy":413.87,"alcohol":0.0,"ash":6.52,"caffeine":0.0,"water":416.43,"carbs":27.93,"fiber":9.83,"starch":1.89,"sugars":11.19,"fructose":3.24,"galactose":0.13,"glucose":3.17,"lactose":0.0,"maltose":0.01,"sucrose":4.62,"sugar_alcohol":0.0,"fat":23.74,"monounsaturated":10.59,"polyunsaturated":2.6,"omega_3":0.48,"omega_6":2.14,"saturated":8.61,"transfats":0.03,"cholesterol":214.2,"protein":27.41,"alanine":1.62,"arginine":2.53,"aspartic_acid":3.13,"cystine":0.32,"glutamic_acid":4.8,"glycine":1.53,"histidine":0.59,"isoleucine":1.2,"leucine":2.21,"lysine
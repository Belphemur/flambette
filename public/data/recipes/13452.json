{"id":13452,"recipe_id":1583,"serving_count":6,"cooking_minutes":30,"name":"Pecan-Crusted Goat Cheese Plate with Honey \u0026 Thyme-Roasted Grapes ","slug":"pecan-crusted-goat-cheese-plate-honey-thyme-roasted-grapes","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1583/thumbnail_76204014-c863-4637-a862-f7203c6ba79f.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1583/presentation_76204014-c863-4637-a862-f7203c6ba79f.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":125,"name":"parchment paper","slug":"parchment-paper"},{"id":77,"name":"toaster (optional)","slug":"toaster"}],"instructions":[{"id":224830,"primary_message":"Preheat oven to 190°C (375°F). Line a large baking sheet pan with parchment paper.","secondary_message":null},{"id":224831,"primary_message":"Wash and dry grapes; separate into small bunches and place on the baking sheet.","secondary_message":"0.68 kg red grapes"},{"id":224832,"primary_message":"Wash, dry, and slide thyme leaves off the stems; discard stems. Sprinkle thyme over the grapes, then drizzle with oil. ","secondary_message":"1 small pkg fresh thyme\n1 tbsp extra virgin olive oil"},{"id":224833,"primary_message":"Place baking sheet in the oven (it doesn't have to be fully heated) and roast until grapes begin to swell, about 15 minutes. Remove from oven and set aside.","secondary_message":null},{"id":224834,"primary_message":"Meanwhile, finely chop pecans and place on a plate.","secondary_message":"1 cup pecans, dry roasted"},{"id":224835,"primary_message":"Slice goat cheese into ½-inch thick medallions and transfer to the plate with the pecans. Turn to coat, gently pressing pecans into both sides of the medallions. Set aside.","secondary_message":"3 (113 g) logs goat cheese"},{"id":224836,"primary_message":"Arrange bread on another large baking sheet and place in the oven to toast, about 5 minutes. (Alternatively, you can use a toaster.) Slice toast in half.","secondary_message":"9 slices whole grain bread"},{"id":224837,"primary_message":"To serve, divide roasted grapes, goat cheese medallions, and toast between plates. Drizzle honey over the goat cheese and enjoy!","secondary_message":"⅓ cup honey"}],"line_items":[{"id":235802,"quantity":"1 small pkg","ingredient_name":"fresh thyme"},{"id":235799,"quantity":"3 (113 g) logs","ingredient_name":"goat cheese"},{"id":235803,"quantity":"1 cup","ingredient_name":"pecan halves"},{"id":235801,"quantity":"0.68 kg","ingredient_name":"red grapes"},{"id":235800,"quantity":"9 slices","ingredient_name":"whole grain bread"},{"id":235797,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":235798,"quantity":"","ingredient_name":"honey"}],"nutrition":{"energy":568.72,"alcohol":0.0,"ash":3.03,"caffeine":0.0,"water":151.25,"carbs":62.35,"fiber":6.32,"starch":31.94,"sugars":38.05,"fructose":19.08,"galactose":0.67,"glucose":16.36,"lactose":0.01,"maltose":0.8,"sucrose":1.11,"sugar_alcohol":0.0,"fat":29.75,"monounsaturated":12.75,"polyunsaturated":5.14,"omega_3":0.3,"omega_6":4.84,"saturated":10.13,"transfats":0.41,"cholesterol":25.99,"protein":19.32,"alanine":0.28,"arginine":0.68,"aspartic_acid":0.75,"cystine":0.09,"glutamic_acid":2.39,"glycine":0.22,"histidine":0.36,"isoleucine":0.52,"leucine":1.06,"lysine":0.84,"methionine":0.32,"phenylalanine":0.52,"proline":1.45,"serine":0.52,"threonine":0.48,"tryptophan":0.15,"tyrosine":0.46,"valine":0.84,"b1_thiamine":0.39,"b2_riboflavin":0.42,"b3_niacin":2.91,"b5_pantothenic_acid":0.91,"b6_pyridoxine":0.4,"b12_cobalamin":0.11,"choline":36.54,"folate":34.67,"vitamin_a":104.12,"vit
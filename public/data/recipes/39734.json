{"id":39734,"recipe_id":4282,"serving_count":6,"cooking_minutes":30,"name":"Sweet Potato Fritters with Greek Yogurt \u0026 Raspberry Sauce","slug":"sweet-potato-fritters-greek-yogurt-raspberry-sauce","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/4282/thumbnail_928efc88-6a42-44ae-a375-3ff3ad817ed1.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/4282/presentation_928efc88-6a42-44ae-a375-3ff3ad817ed1.jpeg","cookwares":[{"id":11,"name":"colander","slug":"colander"},{"id":15,"name":"grater","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":48,"name":"medium saucepan","slug":"medium-saucepan"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":16,"name":"potato masher","slug":"potato-masher"},{"id":18,"name":"spatula","slug":"spatula"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"}],"instructions":[{"id":616407,"primary_message":"Wash, dry, peel, and coarsely grate sweet potatoes. Place in a large bowl along with eggs, flour, cinnamon, and salt, then stir to combine the batter.","secondary_message":"1.02 kg sweet potatoes\n6 eggs\n⅓ cup all-purpose flour\n1 ½ tsp cinnamon, ground\n3 pinch salt"},{"id":616408,"primary_message":"Preheat a large skillet over medium heat.","secondary_message":null},{"id":616409,"primary_message":"Once the skillet is hot, add oil and swirl to coat the bottom.","secondary_message":"3 tbsp virgin coconut oil"},{"id":616410,"primary_message":"Working in batches, using a ¼-cup measure, drop batter into the skillet, spacing scoops a few inches apart; flatten slightly with the back of a spoon. Cook, flipping once, until fritters are golden brown and cooked through, 6-8 minutes. Remove to a paper towel-lined plate.","secondary_message":null},{"id":616411,"primary_message":"Meanwhile, wash and dry raspberries. Place in a medium saucepan along with maple syrup.","secondary_message":"3 (170 g) pkgs raspberries\n1 tbsp pure maple syrup"},{"id":616412,"primary_message":"Set pan over medium heat and cook, stirring occasionally, until raspberries are warmed through, about 3 minutes. Remove from heat and lightly crush raspberries with a potato masher or fork to create a semi-smooth sauce.","secondary_message":null},{"id":616413,"primary_message":"To serve, divide fritters between plates, then top with yogurt and raspberry sauce. Enjoy!","secondary_message":"1 cup plain Greek yogurt"}],"line_items":[{"id":669850,"quantity":"6","ingredient_name":"eggs"},{"id":669851,"quantity":"1 cup","ingredient_name":"plain Greek yogurt"},{"id":669854,"quantity":"3 (170 g) pkgs","ingredient_name":"raspberries"},{"id":669853,"quantity":"1.02 kg","ingredient_name":"sweet potatoes"},{"id":669849,"quantity":"","ingredient_name":"all-purpose flour"},{"id":669846,"quantity":"","ingredient_name":"cinnamon, ground"},{"id":669848,"quantity":"","ingredient_name":"pure maple syrup"},{"id":669847,"quantity":"","ingredient_name":"salt"},{"id":669852,"quantity":"","ingredient_name":"virgin coconut oil"}],"nutrition":{"energy":376.11,"alcohol":0.0,"ash":3.1,"caffeine":0.0,"water":274.61,"carbs":54.95,"fiber":11.22,"starch":28.01,"sugars":14.4,"fructose":3.21,"galactose":0.29,"glucose":3.44,"lactose":1.04,"maltose":0.01,"sucrose":6.41,"sugar_alcohol":0.08,"fat":11.98,"monounsaturated":2.1,"polyunsaturated":1.35,"omega_3":0.16,"omega_6":1.19,"saturated":7.46,"transfats":0.02,"cholesterol":165.72,"protein":14.22,"alanine":0.65,"arginine":0.61,"aspartic_acid":1.67,"cystine":0.24,"glutamic_acid":2.07,"glycine":0.41,"histidine":0.3,"isoleucine":0.63,"leucine":1.09,"lysine":0.89,"methionine":0.32,"phenylalanine":0.65,"proline":0.7,"serine":0.82,"threonine":0.61,"tryptophan":0.21,"tyrosine":0.43,"valine":0.78,"b1_thiamine":0.25,"b2_ribo
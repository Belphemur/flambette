{"id":9001,"recipe_id":1035,"serving_count":6,"cooking_minutes":30,"name":"Avocado Toasts with Lemon \u0026 Cayenne-Paprika Roasted Chickpeas","slug":"avocado-toasts-lemon-cayenne-paprika-roasted-chickpeas","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1035/thumbnail_42f17312-b07d-411e-ae5f-0fa794950ab8.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1035/presentation_42f17312-b07d-411e-ae5f-0fa794950ab8.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":16,"name":"potato masher","slug":"potato-masher"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":77,"name":"toaster (optional)","slug":"toaster"}],"instructions":[{"id":140069,"primary_message":"Preheat oven to 230°C (450°F).","secondary_message":null},{"id":140070,"primary_message":"Drain and rinse chickpeas. Place on paper towels and pat dry, then transfer to a medium bowl. Add oil and spices to the bowl with the chickpeas and stir to combine. ","secondary_message":"1 ½ (398 ml) cans garbanzo beans (chickpeas)\n1 ½ tbsp extra virgin olive oil\n¾ tsp paprika\n¼ tsp salt\n3 pinch cayenne pepper"},{"id":140071,"primary_message":"Transfer chickpeas to a large baking sheet and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until slightly crispy, about 20 minutes. Reserve bowl for next step.","secondary_message":null},{"id":140072,"primary_message":"Meanwhile, wash and juice lemons into the medium bowl.","secondary_message":"1 ½ lemons"},{"id":140073,"primary_message":"Wash, halve, and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. ","secondary_message":"3 avocados"},{"id":140074,"primary_message":"Add avocado, salt, and garlic powder to the bowl with the lemon juice and mash with a potato masher or fork. ","secondary_message":"½ tsp salt\n½ tsp garlic powder"},{"id":140075,"primary_message":"Toast bread if desired.","secondary_message":"12 slices whole grain bread"},{"id":140076,"primary_message":"To serve, divide toasts between dishes. Top with a layer of mashed avocado and a pile of warm roasted chickpeas. Enjoy! ","secondary_message":null}],"line_items":[{"id":145731,"quantity":"3","ingredient_name":"avocados"},{"id":145730,"quantity":"1 ½ (398 ml) cans","ingredient_name":"garbanzo beans (chickpeas)"},{"id":145733,"quantity":"1 ½","ingredient_name":"lemons"},{"id":145732,"quantity":"12 slices","ingredient_name":"whole grain bread"},{"id":145726,"quantity":"","ingredient_name":"cayenne pepper"},{"id":145725,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":145727,"quantity":"","ingredient_name":"garlic powder"},{"id":145728,"quantity":"","ingredient_name":"paprika"},{"id":145729,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":445.14,"alcohol":0.0,"ash":4.48,"caffeine":0.0,"water":152.06,"carbs":51.43,"fiber":14.68,"starch":27.42,"sugars":4.06,"fructose":1.69,"galactose":0.1,"glucose":1.19,"lactose":0.01,"maltose":0.65,"sucrose":0.42,"sugar_alcohol":0.0,"fat":22.23,"monounsaturated":13.06,"polyunsaturated":3.85,"omega_3":0.28,"omega_6":3.58,"saturated":3.22,"transfats":0.02,"cholesterol":0.0,"protein":14.59,"alanine":0.3,"arginine":0.53,"aspartic_acid":0.78,"cystine":0.09,"glutamic_acid":1.09,"glycine":0.3,"histidine":0.18,"isoleucine":0.28,"leucine":0.47,"lysine":0.44,"methionine":0.1,"phenylalanine":0.34,"proline":0.29,"serine":0.35,"threonine":0.24,"tryptophan":0.07,"
{"id":10018,"recipe_id":1167,"serving_count":6,"cooking_minutes":40,"name":"Spicy Thai Coconut Chicken Soup (Tom Kha Gai)","slug":"spicy-thai-coconut-chicken-soup-tom-kha-gai","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1167/thumbnail_6de6c55b-5c0c-4166-8b85-d6542eeb3d7e.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1167/presentation_6de6c55b-5c0c-4166-8b85-d6542eeb3d7e.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":159874,"primary_message":"Wash and dry the fresh produce.","secondary_message":"3 (2 ½ cm) pieces ginger root\n0.68 kg white mushrooms\n1 ½ small bunches green onions (scallions)\n1 ½ small bunches cilantro\n1 ½ limes"},{"id":159875,"primary_message":"Peel and thinly slice onions into half rings.","secondary_message":"1 ½ medium yellow onions"},{"id":159876,"primary_message":"Heat a large pot over medium heat.","secondary_message":null},{"id":159877,"primary_message":"Peel and mince ginger and garlic.","secondary_message":"3 cloves garlic"},{"id":159878,"primary_message":"Once the pot is hot, add oil and swirl to coat the bottom.","secondary_message":"3 tbsp virgin coconut oil"},{"id":159879,"primary_message":"Add onion, ginger, garlic, and chili-garlic sauce to the pot. Cook, stirring frequently, until onion begins to soften, 4-5 minutes.","secondary_message":"3 tbsp chili-garlic sauce"},{"id":159880,"primary_message":"Add broth, coconut milk, sugar, fish sauce, and salt to the pot. Bring to a boil over high heat, then reduce heat to a simmer.","secondary_message":"2129 ml chicken or vegetable broth\n1 ½ (398 ml) cans coconut milk\n1 ½ tbsp brown sugar\n1 tbsp fish sauce\n1 ½ tsp salt"},{"id":159881,"primary_message":"Thinly slice mushrooms.","secondary_message":null},{"id":159882,"primary_message":"Slice chicken crosswise into thin strips. ","secondary_message":"1.02 kg chicken breasts, boneless skinless"},{"id":159883,"primary_message":"Add mushrooms and chicken to the pot and continue to simmer until chicken is cooked through, 10-12 minutes.","secondary_message":null},{"id":159884,"primary_message":"Meanwhile, using a fresh cutting board, trim green onions; cut crosswise into ¼-inch pieces.","secondary_message":null},{"id":159885,"primary_message":"Shave cilantro leaves off the stems; discard stems.","secondary_message":null},{"id":159886,"primary_message":"When the soup is done, juice limes into the pot and stir to combine.","secondary_message":null},{"id":159887,"primary_message":"To serve, divide soup between bowls. Top with green onions and cilantro. Enjoy!","secondary_message":null}],"line_items":[{"id":166194,"quantity":"1.02 kg","ingredient_name":"chicken breasts, boneless skinless"},{"id":166201,"quantity":"2129 ml","ingredient_name":"chicken or vegetable broth"},{"id":166200,"quantity":"1 ½ small bunches","ingredient_name":"cilantro"},{"id":166193,"quantity":"1 ½ (398 ml) cans","ingredient_name":"coconut milk"},{"id":166192,"quantity":"3 cloves","ingredient_name":"garlic"},{"id":166202,"quantity":"3 (2 ½ cm) pieces","ingredient_name":"ginger root"},{"id":166199,"quantity":"1 ½ small bunches","ingredient_name":"green onions (scallions)"},{"id":166203,"quantity":"1 ½","ingredient_name":"limes"},{"id":166191,"quantity":"0.68 kg","ingredient_name":"white mushrooms"},{"id":166198,"quantity":"1 ½ medium","ingredient_name":"yellow onions"},{"id":166204,"quantity":"","ingredient_name":"brown sugar"},{"id":166205,"quantit
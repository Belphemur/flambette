{"id":5533,"recipe_id":289,"serving_count":6,"cooking_minutes":40,"name":"Egg \u0026 Walnut Caesar Salad with Parmesan Crisps \u0026 Creamy Dressing","slug":"egg-walnut-caesar-salad-parmesan-crisps-creamy-dressing","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/289/thumbnail_d2cb5232-c0d2-45fd-8086-9584f9d2690c.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/289/presentation_d2cb5232-c0d2-45fd-8086-9584f9d2690c.jpg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":48,"name":"medium saucepan","slug":"medium-saucepan"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":66314,"primary_message":"Preheat the oven to 200°C (400°F).","secondary_message":""},{"id":66313,"primary_message":"Place the eggs in a medium saucepan, cover with water, and bring to a full, rolling boil. Once boiling, remove the pan from the heat, cover, and let sit for 10 minutes. Drain and cover with cold water or ice to cool.","secondary_message":"12 eggs"},{"id":66312,"primary_message":"Coarsely grate 1 ½ cup of Parmesan.","secondary_message":"84 g Parmesan cheese"},{"id":66311,"primary_message":"Line a baking sheet with parchment paper. Measure out 1 tbsp of the grated Parmesan and place in a pile on the sheet. Repeat with remaining cheese.","secondary_message":""},{"id":66310,"primary_message":"Place in the oven and bake until lightly browned, 5-7 minutes. Once done, remove from the oven and let them sit for a couple of minutes.","secondary_message":""},{"id":66309,"primary_message":"Finely grate ⅓ cup of Parmesan.","secondary_message":"42 g Parmesan cheese"},{"id":66308,"primary_message":"Peel and mince the garlic.","secondary_message":"3 cloves garlic"},{"id":66307,"primary_message":"In a small bowl, prepare the dressing by whisking together the grated Parmesan, minced garlic, lemon juice, mayo, olive oil, Dijon, Worcestershire, salt, and pepper. Set aside.","secondary_message":"juice of ¾ lemon\n12 tbsp mayonnaise\n6 tbsp extra virgin olive oil\n¾ tsp Dijon mustard\n1 ½ tsp Worcestershire sauce\n⅜ tsp salt\n⅜ tsp black pepper"},{"id":66306,"primary_message":"Roughly chop the walnuts and transfer to a small bowl.","secondary_message":"1 ½ cups walnuts"},{"id":66303,"primary_message":"Wash and dry the lettuce. Halve lengthwise, then chop crosswise into 2 ½ cm strips.","secondary_message":"3 heads romaine lettuce"},{"id":66305,"primary_message":"Peel and quarter the eggs. Gently peel the Parmesan crisps off of the parchment paper. Slice remaining lemon into wedges.","secondary_message":""},{"id":66304,"primary_message":"To serve, arrange a bed of romaine on a plate, add eggs, walnuts, and Parmesan crisps. Drizzle with dressing and lemon juice and enjoy!","secondary_message":""}],"line_items":[{"id":70951,"quantity":"12","ingredient_name":"eggs"},{"id":70950,"quantity":"3 cloves","ingredient_name":"garlic"},{"id":70952,"quantity":"1 ½","ingredient_name":"lemons"},{"id":70949,"quantity":"126 g","ingredient_name":"Parmesan cheese"},{"id":70948,"quantity":"3 heads","ingredient_name":"romaine lettuce"},{"id":70947,"quantity":"1 ½ cups","ingredient_name":"walnuts"},{"id":70946,"quantity":"","ingredient_name":"black pepper"},{"id":70945,"quantity":"","ingredient_name":"Dijon mustard"},{"id":70944,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":70943,"quantity":"","ingredient_name":"mayonnaise"},{"id":70942
{"id":12873,"recipe_id":1498,"serving_count":6,"cooking_minutes":35,"name":"Pan con Tomate (Spanish Tomato Bread) with Ham \u0026 Spinach Salad","slug":"pan-con-tomate-spanish-tomato-bread-ham-spinach-salad","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1498/thumbnail_1392a8a6-c567-4f35-a4c0-3ab0c35d1bf0.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1498/presentation_1392a8a6-c567-4f35-a4c0-3ab0c35d1bf0.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":216874,"primary_message":"Preheat oven to 220°C (425°F).","secondary_message":null},{"id":216875,"primary_message":"Wash, dry, and mince tomatoes; place in a medium bowl. Season with salt and pepper, stir to combine, and set aside. ","secondary_message":"3 tomatoes\n¾ tsp salt\n½ tsp black pepper"},{"id":216876,"primary_message":"Peel and mince garlic. ","secondary_message":"6 cloves garlic"},{"id":216877,"primary_message":"Divide bread slices between two baking sheet pans and drizzle oil over both sides; sprinkle tops with garlic. Place in the oven and bake, flipping halfway through, until toasted, 3-5 minutes. Remove from oven (keep oven on). ","secondary_message":"12 slices whole grain bread\n3 tbsp extra virgin olive oil"},{"id":216878,"primary_message":"Meanwhile, place oil, vinegar, honey, and Dijon in a large bowl; whisk to combine the dressing.","secondary_message":"3 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n1 tbsp honey\n1 tbsp Dijon mustard"},{"id":216879,"primary_message":"Wash spinach (skip if it came pre-washed) and add to the bowl with the dressing; toss to combine the salad. ","secondary_message":"1 ½ (142 g) pkg baby spinach"},{"id":216880,"primary_message":"Spread tomato mixture over toasts and return to the oven. Bake until tomato topping is heated through, 2-3 minutes; remove from oven.","secondary_message":null},{"id":216881,"primary_message":"Halve olives. Cut or tear prosciutto into bite sized pieces.","secondary_message":"1 cup Kalamata olives, pitted\n18 slices prosciutto"},{"id":216882,"primary_message":"To serve, divide toasts and salad between plates. Top salad with olives, prosciutto, and almonds. Enjoy! ","secondary_message":"¾ cup almonds, sliced"}],"line_items":[{"id":227471,"quantity":"¾ cup","ingredient_name":"almonds, sliced"},{"id":227461,"quantity":"1 ½ (142 g) pkg","ingredient_name":"baby spinach"},{"id":227460,"quantity":"6 cloves","ingredient_name":"garlic"},{"id":227469,"quantity":"1 cup","ingredient_name":"Kalamata olives, pitted"},{"id":227472,"quantity":"18 slices","ingredient_name":"prosciutto"},{"id":227470,"quantity":"3","ingredient_name":"tomatoes"},{"id":227468,"quantity":"12 slices","ingredient_name":"whole grain bread"},{"id":227463,"quantity":"","ingredient_name":"black pepper"},{"id":227466,"quantity":"","ingredient_name":"Dijon mustard"},{"id":227462,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":227465,"quantity":"","ingredient_name":"honey"},{"id":227467,"quantity":"","ingredient_name":"red wine vinegar"},{"id":227464,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":541.77,"alcohol":0.0,"ash":3.77,"caffeine":0.0,"water":125.12,"carbs":40.84,"fiber":7.0,"starch":22.34,"sugars":9.54,"fructose":3.81,"galactose":0.1
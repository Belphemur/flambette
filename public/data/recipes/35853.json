{"id":35853,"recipe_id":3925,"serving_count":6,"cooking_minutes":25,"name":"Strawberry-Cardamom Breakfast Pita with Cottage Cheese \u0026 Honey","slug":"strawberry-cardamom-breakfast-pita-cottage-cheese-honey","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3925/thumbnail_3cb2d853-808b-4472-95fc-d9af72beb3e4.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3925/presentation_3cb2d853-808b-4472-95fc-d9af72beb3e4.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":48,"name":"medium saucepan","slug":"medium-saucepan"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":77,"name":"toaster (optional)","slug":"toaster"},{"id":35,"name":"tongs","slug":"tongs"}],"instructions":[{"id":564104,"primary_message":"Wash, dry, trim, and roughly chop strawberries. Place in a medium saucepan.","secondary_message":"1 ½ (454 g) pkgs strawberries"},{"id":564105,"primary_message":"Wash, dry, and juice lemons into the pan with the strawberries. Add honey, cardamom, and salt, then bring to a simmer over medium-high heat. Once simmering, reduce heat to medium and cook, stirring occasionally, until compote is thickened slightly, 6-8 minutes. Remove from heat.","secondary_message":"1 ½ lemons\n3 tbsp honey\n¾ tsp cardamom, ground\n3 pinch salt"},{"id":564106,"primary_message":"Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the pita.)","secondary_message":null},{"id":564107,"primary_message":"Place cottage cheese in a strainer to remove excess liquid. Set aside to drain further.","secondary_message":"3 cups cottage cheese"},{"id":564108,"primary_message":"Divide pita breads between two baking sheet pans. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes. Remove from oven. (Alternatively, you can use a toaster for the pita breads.)","secondary_message":"6 whole grain pitas"},{"id":564109,"primary_message":"Spread pita with drained cottage cheese, top with strawberry compote, and cut into wedges (if desired).","secondary_message":null},{"id":564110,"primary_message":"To serve, divide pita breads between plates and drizzle with honey. Enjoy!","secondary_message":"2 tbsp honey"}],"line_items":[{"id":610493,"quantity":"3 cups","ingredient_name":"cottage cheese"},{"id":610489,"quantity":"1 ½","ingredient_name":"lemons"},{"id":610490,"quantity":"1 ½ (454 g) pkgs","ingredient_name":"strawberries"},{"id":610491,"quantity":"6","ingredient_name":"whole grain pitas"},{"id":610492,"quantity":"","ingredient_name":"cardamom, ground"},{"id":610488,"quantity":"","ingredient_name":"honey"},{"id":610487,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":376.05,"alcohol":0.0,"ash":3.61,"caffeine":0.0,"water":227.59,"carbs":63.59,"fiber":7.18,"starch":41.97,"sugars":24.12,"fructose":10.26,"galactose":0.57,"glucose":9.29,"lactose":3.03,"maltose":0.3,"sucrose":0.91,"sugar_alcohol":0.0,"fat":6.94,"monounsaturated":1.16,"polyunsaturated":0.99,"omega_3":0.13,"omega_6":0.87,"saturated":2.24,"transfats":0.0,"cholesterol":19.31,"protein":19.79,"alanine":0.69,"arginine":0.89,"aspartic_acid":1.52,"cystine":0.23,"glutamic_acid":5.09,"glycine":0.54,"histidine":0.53,"isoleucine":0.93,"leucine":1.74,"lysine":1.26,"methionine":0.41,"phenylalanine":0.98,"proline":2.1,"serine":1.06,"threonine":0.77,"tryptophan":0.27,"tyrosine":0.9,"valine":1.15,"b1_thiamine":0.28,"b2_riboflavin":0.27,"b3_niacin":2.4,"b5_pantothenic_acid
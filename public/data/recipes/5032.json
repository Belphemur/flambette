{"id":5032,"recipe_id":36,"serving_count":6,"cooking_minutes":45,"name":"Grilled Peach, Strawberry \u0026 Arugula Salad with Pistachios \u0026 Goat Cheese","slug":"grilled-peach-strawberry-arugula-salad-pistachios-goat-cheese","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/36/thumbnail_34a7a7a6-07ea-4b1f-99e0-916f497dd3bb.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/36/presentation_34a7a7a6-07ea-4b1f-99e0-916f497dd3bb.jpg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":45,"name":"grill pan, outdoor grill, or skillet","slug":"grill-pan-outdoor-grill-or-skillet"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":36,"name":"salad spinner (optional)","slug":"salad-spinner"},{"id":35,"name":"tongs","slug":"tongs"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":61013,"primary_message":"Preheat a grill pan or skillet over medium heat.","secondary_message":""},{"id":61012,"primary_message":"Wash, halve, and pit peaches.","secondary_message":"6 peaches"},{"id":61011,"primary_message":"Coat grill or bottom of skillet with oil. Place peaches cut side down on grill/skillet and cook until lightly browned and tender, 2-3 minutes per side. Transfer to a plate.","secondary_message":"1 ½ tbsp virgin coconut oil"},{"id":61010,"primary_message":"Wash and dry arugula. Transfer to a large bowl.","secondary_message":"1 ½ (142 g) pkg baby arugula"},{"id":61009,"primary_message":"Wash cucumber and strawberries. Medium dice and add cucumber to bowl. Trim stem ends, slice, and add strawberries to bowl.","secondary_message":"1 ½ English cucumber\n1 ½ (454 g) pkg strawberries"},{"id":61008,"primary_message":"Peel and mince garlic. In a small bowl, prepare dressing by whisking together garlic, oil, vinegar, Dijon, salt, and pepper. Set aside.","secondary_message":"3 cloves garlic\n9 tbsp extra virgin olive oil\n3 tbsp balsamic vinegar\n3 tsp honey\n¾ tsp Dijon mustard\n⅜ tsp salt\n⅜ tsp black pepper"},{"id":61007,"primary_message":"Slice and add peaches to bowl. Toss salad.","secondary_message":""},{"id":61006,"primary_message":"Shell pistachios. Crumble goat cheese.","secondary_message":"¾ cup pistachios, roasted unsalted\n1 ½ (113 g) log goat cheese"},{"id":61005,"primary_message":"To serve, arrange salad on a plate, sprinkle goat cheese and pistachios over top, and drizzle with dressing. Enjoy!","secondary_message":""}],"line_items":[{"id":64688,"quantity":"1 ½ (142 g) pkg","ingredient_name":"baby arugula"},{"id":64690,"quantity":"1 ½","ingredient_name":"English cucumbers"},{"id":64691,"quantity":"3 cloves","ingredient_name":"garlic"},{"id":64689,"quantity":"1 ½ (113 g) logs","ingredient_name":"goat cheese"},{"id":64692,"quantity":"6","ingredient_name":"peaches"},{"id":64693,"quantity":"¾ cup","ingredient_name":"pistachios, unsalted"},{"id":64694,"quantity":"1 ½ (454 g) pkgs","ingredient_name":"strawberries"},{"id":64695,"quantity":"","ingredient_name":"balsamic vinegar"},{"id":64687,"quantity":"","ingredient_name":"black pepper"},{"id":64696,"quantity":"","ingredient_name":"Dijon mustard"},{"id":64686,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":64697,"quantity":"","ingredient_name":"honey"},{"id":64685,"quantity":"","ingredient_name":"salt"},{"id":64698,"quantity":"","ingredient_name":"virgin coconut oil"}],"nutrition":{"energy":509.4,"alcohol":0.0,"ash":3.29,"caffeine":0.0,"water":366.36,"carbs":36.53,"fiber":7.56,"starch":4.55,"sugars":25.48,"fructose":8.19,"galactose":0.21,"glucose":8.01,"lactose":0.0,"maltose":0.2,"sucrose":8.88,"sugar_alcohol":0.0,"fat":37.93,"monounsaturated":20.38,"polyuns
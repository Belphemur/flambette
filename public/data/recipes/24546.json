{"id":24546,"recipe_id":2761,"serving_count":6,"cooking_minutes":30,"name":"Ginger-Miso Pasta Salad with Edamame, Cabbage \u0026 Cucumber ","slug":"ginger-miso-pasta-salad-edamame-cabbage-cucumber","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2761/thumbnail_444acb35-19cf-4779-8b3e-5fe09d79fca8.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2761/presentation_444acb35-19cf-4779-8b3e-5fe09d79fca8.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":52,"name":"grater (optional)","slug":"grater"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":396734,"primary_message":"Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.","secondary_message":"1 ½ tsp salt\n425 g rotini pasta"},{"id":396735,"primary_message":"Meanwhile, wash, dry, peel, and mince ginger. Place in a large bowl along with oil, vinegar, soy sauce, miso paste, maple syrup, and pepper; whisk to combine the dressing. ","secondary_message":"3 (2 ½ cm) pieces ginger root\n¼ cup toasted sesame oil\n¼ cup rice vinegar\n¼ cup soy sauce\n3 tbsp miso paste, white\n3 tbsp pure maple syrup\n½ tsp black pepper"},{"id":396736,"primary_message":"Place edamame in a colander and rinse under hot, running water (from the tap) to defrost; drain and add to the bowl with the dressing.","secondary_message":"4 ½ cups edamame"},{"id":396737,"primary_message":"Wash, dry, trim, and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the bowl.","secondary_message":"1 ½ English cucumbers"},{"id":396738,"primary_message":"Add cabbage to the bowl and set aside. ","secondary_message":"1 ½ (397 g) bags shredded cabbage (coleslaw mix)"},{"id":396739,"primary_message":"When the pasta is done, drain and rinse under cold water to cool. Add to the bowl and stir to combine the pasta salad. ","secondary_message":null},{"id":396740,"primary_message":"To serve, divide pasta salad between plates or bowls. Enjoy!","secondary_message":null}],"line_items":[{"id":423891,"quantity":"4 ½ cups","ingredient_name":"edamame"},{"id":423888,"quantity":"1 ½","ingredient_name":"English cucumbers"},{"id":423889,"quantity":"3 (2 ½ cm) pieces","ingredient_name":"ginger root"},{"id":423892,"quantity":"45 ml","ingredient_name":"miso paste, white"},{"id":423884,"quantity":"425 g","ingredient_name":"rotini pasta"},{"id":423893,"quantity":"1 ½ (397 g) bags","ingredient_name":"shredded cabbage (coleslaw mix)"},{"id":423885,"quantity":"","ingredient_name":"black pepper"},{"id":423887,"quantity":"","ingredient_name":"pure maple syrup"},{"id":423890,"quantity":"","ingredient_name":"rice vinegar"},{"id":423886,"quantity":"","ingredient_name":"salt"},{"id":423883,"quantity":"","ingredient_name":"soy sauce"},{"id":423882,"quantity":"","ingredient_name":"toasted sesame oil"}],"nutrition":{"energy":587.11,"alcohol":0.0,"ash":7.65,"caffeine":0.0,"water":286.9,"carbs":82.31,"fiber":12.35,"starch":47.82,"sugars":15.54,"fructose":2.88,"galactose":0.0,"glucose":2.57,"lactose":0.0,"maltose":2.53,"sucrose":7.58,"sugar_alcohol":0.0,"fat":18.26,"monounsaturated":5.86,"polyunsaturated":7.54,"omega_3":0.51,"omega_6":7.02,"saturated":2.55,"transfats":0.01,"cholesterol":0.0,"protein":27.06,"alanine":0.97,"arginine":1.41,"aspartic_acid":2.36,"cystine":0.36,"glutamic_acid":6.42,"glycine":0.94,"histidine":0.6,"isoleucine":0.84,"leucine":1.77,"lysine":1.24,"methionine":0.31,"phenylalani
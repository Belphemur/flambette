{"id":26322,"recipe_id":2956,"serving_count":6,"cooking_minutes":30,"name":"Smoked Salmon, Tzatziki, Poppy Seed \u0026 Caper Flatbread with Mixed Salad","slug":"smoked-salmon-tzatziki-poppy-seed-caper-flatbread-mixed-salad","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2956/thumbnail_e4484bc0-9f4e-416a-8512-a30dfefcd365.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2956/presentation_e4484bc0-9f4e-416a-8512-a30dfefcd365.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":35,"name":"tongs","slug":"tongs"}],"instructions":[{"id":425224,"primary_message":"Preheat oven to 230°C (450°F).","secondary_message":null},{"id":425225,"primary_message":"Divide flatbreads between two large baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, 8-10 minutes. Remove from oven and set aside to cool slightly, about 3 minutes. ","secondary_message":"6 flatbreads or naan"},{"id":425226,"primary_message":"Meanwhile, peel and mince shallots. Place in a large bowl along with the vinaigrette.","secondary_message":"2 shallots\n½ cup French vinaigrette"},{"id":425227,"primary_message":"Wash, dry, trim, and thinly slice radishes. Add to the bowl with the vinaigrette and set aside. ","secondary_message":"1 ½ bunches radish"},{"id":425228,"primary_message":"Chop or tear salmon into bite-sized pieces.","secondary_message":"3 (113 g) pkgs smoked salmon"},{"id":425229,"primary_message":"Once the flatbreads have cooled slightl
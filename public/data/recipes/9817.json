{"id":9817,"recipe_id":1150,"serving_count":6,"cooking_minutes":35,"name":"Bell Pepper, Olive \u0026 Sun-Dried Tomato Frittata with Parmesan","slug":"bell-pepper-olive-sun-dried-tomato-frittata-parmesan","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1150/thumbnail_1336b40a-8b95-4583-9baf-6c94e695fcdb.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1150/presentation_1336b40a-8b95-4583-9baf-6c94e695fcdb.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":15,"name":"grater","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":18,"name":"spatula","slug":"spatula"},{"id":59,"name":"stainless steel or cast iron skillet","slug":"stainless-steel-or-cast-iron-skillet"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":156607,"primary_message":"Wash and dry bell peppers. Seed and slice into thin strips.","secondary_message":"3 red bell peppers"},{"id":156608,"primary_message":"Peel and thinly slice onions into half rings.","secondary_message":"1 ½ medium red onions"},{"id":156609,"primary_message":"Preheat a large ovenproof skillet over medium heat.","secondary_message":null},{"id":156610,"primary_message":"Meanwhile, roughly chop the olives and sun-dried tomatoes.","secondary_message":"1 ½ cups Kalamata olives, pitted\n24 sun-dried tomatoes, oil-packed"},{"id":156611,"primary_message":"Once the skillet is hot, add oil and swirl to coat the bottom.","secondary_message":"3 tbsp extra virgin olive oil"},{"id":156612,"primary_message":"Add bell pepper and onions; cook, stirring occasionally, until vegetables are softened, about 5-7 minutes. Add olives and sun-dried tomatoes; stir to combine.
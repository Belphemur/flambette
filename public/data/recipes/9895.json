{"id":9895,"recipe_id":1158,"serving_count":6,"cooking_minutes":40,"name":"Brussels Sprout Salad with Roasted Chicken, Crisp Apple \u0026 Walnuts","slug":"brussels-sprout-salad-roasted-chicken-crisp-apple-walnuts","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1158/thumbnail_37a27e3d-f498-4b3d-ae3e-a44bea29c25d.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1158/presentation_37a27e3d-f498-4b3d-ae3e-a44bea29c25d.jpeg","cookwares":[{"id":83,"name":"baking dish","slug":"baking-dish"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":35,"name":"tongs","slug":"tongs"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":157862,"primary_message":"Preheat oven to 220°C (425°F).","secondary_message":null},{"id":157863,"primary_message":"Combine oils, vinegar, honey, salt, and pepper in a large bowl; whisk to combine the dressing. ","secondary_message":"⅓ cup extra virgin olive oil\n3 tbsp toasted sesame oil\n⅓ cup rice vinegar\n3 tbsp honey\n1 tbsp salt\n1 ½ tsp black pepper"},{"id":157864,"primary_message":"Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Place in a baking dish, pour half of the dressing over the chicken and turn to coat.","secondary_message":"1.02 kg chicken breasts, boneless skinless"},{"id":157865,"primary_message":"Place chicken in the oven and bake, flipping once, until golden brown and cooked through, 17-22 minutes.","secondary_message":null},{"id":157866,"primary_message":"Meanwhile, wash and dry the fresh produce.","secondary_message":"1 ½ medium heads napa cabbage\n⅓ kg brussels sprouts\n3 Gala apples\n6 s
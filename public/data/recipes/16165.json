{"id":16165,"recipe_id":1902,"serving_count":6,"cooking_minutes":40,"name":"Honey-Butter Gnocchi with Prosciutto, Broccoli, Peas \u0026 Parmesan","slug":"honey-butter-gnocchi-prosciutto-broccoli-peas-parmesan","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1902/thumbnail_3ae945b0-bd6b-4c4b-8bf8-7160501be0fe.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1902/presentation_3ae945b0-bd6b-4c4b-8bf8-7160501be0fe.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"}],"instructions":[{"id":264977,"primary_message":"Preheat a large pot over medium heat.","secondary_message":null},{"id":264978,"primary_message":"Once the pot is hot, working in batches if necessary, add the prosciutto and cook until crispy, about 1 minute per side. Remove prosciutto to a plate and set aside. (Reserve pot for later use.)","secondary_message":"18 slices prosciutto"},{"id":264979,"primary_message":"Peel and mince garlic.","secondary_message":"6 cloves garlic"},{"id":264980,"primary_message":"Wash and dry broccoli. Separate into bite-sized florets and cut stems into smaller pieces.","secondary_message":"3 crowns broccoli"},{"id":264981,"primary_message":"Return pot to medium heat. Add butter, garlic, broccoli, salt, and red pepper; cook, stirring occasionally, until broccoli is bright green and tender-crisp, 5-6 minutes.","secondary_message":"⅓ cup butter, unsalted\n¾ tsp salt\n½ tsp crushed red pepper"},{"id":264982,"primary_message":"Meanwhile, finely grate Parmesan, place in a small bowl, and set aside.","secondary_message":"85 g Parmesan cheese"},{"id":264983,"primary_message":"Add gnocchi, peas, and hot water (from the tap) to the pot; continue to cook, stirring occasionally, until the water reduces and gnocchi are soft, 7-8 minutes more.","secondary_message":"3 (454 g) pkgs potato gnocchi\n2 ¼ cups frozen peas\n1 cup water"},{"id":264984,"primary_message":"While the gnocchi is cooking, crumble or chop prosciutto into bite-sized pieces.","secondary_message":null},{"id":264985,"primary_message":"Wash, dry, and juice lemons into the pot. Add honey and stir to combine; remove from heat.","secondary_message":"1 ½ lemons\n3 tbsp honey"},{"id":264986,"primary_message":"To serve, divide gnocchi and vegetables between bowls. Top with crispy prosciutto and Parmesan. Enjoy!","secondary_message":null}],"line_items":[{"id":279504,"quantity":"3 crowns","ingredient_name":"broccoli"},{"id":279508,"quantity":"2 ¼ cups","ingredient_name":"frozen peas"},{"id":279500,"quantity":"6 cloves","ingredient_name":"garlic"},{"id":279507,"quantity":"1 ½","ingredient_name":"lemons"},{"id":279506,"quantity":"85 g","ingredient_name":"Parmesan cheese"},{"id":279509,"quantity":"3 (454 g) pkgs","ingredient_name":"potato gnocchi"},{"id":279510,"quantity":"18 slices","ingredient_name":"prosciutto"},{"id":279505,"quantity":"","ingredient_name":"butter, unsalted"},{"id":279501,"quantity":"","ingredient_name":"crushed red pepper"},{"id":279503,"quantity":"","ingredient_name":"honey"},{"id":279502,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":658.23,"alcohol":0.0,"ash":5.56,"caffeine":0.0,"water":303.48,"carbs":63.92,"fiber":7.13,"starch":44.77,"sugars":16.93,"fructose":5.5,"galactose":0.33,"glucose":4.73,"lactose":1.79,"maltose":0.4,"sucrose":2.76,"sugar_alcohol":0.0,"fat":35.31,"mono
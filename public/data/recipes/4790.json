{"id":4790,"recipe_id":189,"serving_count":6,"cooking_minutes":40,"name":"Cajun Chicken \u0026 Avocado Burger with Baby Spinach Salad","slug":"cajun-chicken-avocado-burger-baby-spinach-salad","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/189/thumbnail_520a967e-d86a-4c90-8932-b6002748fa74.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/189/presentation_520a967e-d86a-4c90-8932-b6002748fa74.jpg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":45,"name":"grill pan, outdoor grill, or skillet","slug":"grill-pan-outdoor-grill-or-skillet"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":36,"name":"salad spinner (optional)","slug":"salad-spinner"},{"id":35,"name":"tongs","slug":"tongs"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":58498,"primary_message":"Heat a grill pan, outdoor grill, or skillet over medium heat.","secondary_message":""},{"id":58501,"primary_message":"In a small bowl, prepare cajun rub by mixing together cumin, coriander, paprika, oregano, salt, and pepper.","secondary_message":"¾ tsp cumin\n¾ tsp coriander\n¾ tsp paprika\n⅜ tsp oregano\n⅜ tsp salt\n⅜ tsp black pepper"},{"id":58499,"primary_message":"Slice chicken in half horizontally to form thin fillets. Rub with spice mixture on all sides.","secondary_message":""},{"id":58497,"primary_message":"Coat grill or bottom of skillet with oil. Add chicken fillets and cook until golden brown and cooked through, 2-3 minutes per side.","secondary_message":"about 3 tbsp virgin coconut oil"},{"id":58502,"primary_message":"In a medium bowl, prepare dressing by whisking together oil, vinegar, Dijon, salt, and pepper.","secondary_message":"4 ½ tbsp extra virgin olive oil\n1 ½ tbsp balsamic vinegar\n⅜ tsp Dijon mustard\n3 pinches salt\n3 pinches black pepper"},{"id":58503,"primary_message":"Wash and dry spinach. Save a small handful of leaves for the burgers; add the rest to bowl with dressing and toss to coat.","secondary_message":"1 ½ (142 g) pkg baby spinach"},{"id":58505,"primary_message":"Wash and slice tomatoes into rounds. Halve and pit avocados; thinly slice while still in skin and scoop out.","secondary_message":"3 tomatoes\n3 avocados"},{"id":58504,"primary_message":"Toast buns on grill/skillet.","secondary_message":"6 whole grain buns or rolls"},{"id":58500,"primary_message":"To serve, spread some Dijon on buns. Top with remaining spinach leaves, chicken, and slices of tomato and avocado. Serve with spinach salad on the side. Enjoy!","secondary_message":""}],"line_items":[{"id":61772,"quantity":"3","ingredient_name":"avocados"},{"id":61778,"quantity":"1 ½ (142 g) pkg","ingredient_name":"baby spinach"},{"id":61779,"quantity":"0.681 kg","ingredient_name":"chicken breasts, boneless skinless"},{"id":61780,"quantity":"3","ingredient_name":"tomatoes"},{"id":61781,"quantity":"6","ingredient_name":"whole grain buns or rolls"},{"id":61769,"quantity":"","ingredient_name":"balsamic vinegar"},{"id":61771,"quantity":"","ingredient_name":"black pepper"},{"id":61774,"quantity":"","ingredient_name":"coriander, ground"},{"id":61768,"quantity":"","ingredient_name":"cumin, ground"},{"id":61770,"quantity":"","ingredient_name":"Dijon mustard"},{"id":61777,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":61776,"quantity":"","ingredient_name":"oregano, dried"},{"id":61775,"quantity":"","ingredient_name":"paprika"},{"id":61767,"quantity":"","ingredient_name":"salt"},{"id":61773,"quantity":"","ingredient_name":"virgin coconut oil"}],"nutrition":{"energy":579.39,"alcohol":0.0,"ash":6.12,"caffeine":0.0,"water":268.07,"carbs":31.29,"fiber":11.45,"starch":10.62,"sugars":7.43,"fructose":2.99,"galactose":0.14,"glucose":2.75,"lactose":0.0,"maltose":1.45,"sucrose":0.09,"sugar_alcohol":0.0,"fat":36.75,"monounsaturat
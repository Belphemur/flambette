{"id":10629,"recipe_id":1249,"serving_count":6,"cooking_minutes":35,"name":"Puttanesca Pasta Salad with Tuna, Anchovies \u0026 Artichokes","slug":"puttanesca-pasta-salad-tuna-anchovies-artichokes","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1249/thumbnail_13e7d14b-5e3c-4a3a-bd6d-6ea38ba6c5d8.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1249/presentation_13e7d14b-5e3c-4a3a-bd6d-6ea38ba6c5d8.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":170588,"primary_message":"Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.","secondary_message":"1 tbsp salt\n425 g spaghetti pasta"},{"id":170589,"primary_message":"Meanwhile, peel and mince the garlic and shallots; place both in a large bowl. ","secondary_message":"3 cloves garlic\n3 shallots"},{"id":170590,"primary_message":"Finely mince anchovy fillets; add to the bowl along with oil, vinegar, and spices. Whisk to combine the dressing.","secondary_message":"6 anchovy fillets, packed in oil\n⅓ cup extra virgin olive oil\n3 tbsp balsamic vinegar\n¾ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"},{"id":170591,"primary_message":"Drain and thinly slice artichokes; add to the bowl with the dressing.","secondary_message":"3 (170 ml) jars artichoke hearts, marinated"},{"id":170592,"primary_message":"Halve olives lengthwise and add to the bowl.","secondary_message":"1 cup Kalamata olives, pitted"},{"id":170593,"primary_message":"Roughly chop capers and add to the bowl.","secondary_message":"4 ½ tbsp capers"},{"id":170594,"primary_message":"Wash, dry, and halve tomatoes; add to the bowl.","secondary_message":"3 small pkgs grape tomatoes"},{"id":170595,"primary_message":"Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Add to the bowl and stir to combine.","secondary_message":"1 small bunch Italian (flat-leaf) parsley"},{"id":170596,"primary_message":"Drain pasta in a colander and rinse under cold water; add to the bowl. ","secondary_message":null},{"id":170597,"primary_message":"Drain tuna, flake with a fork, and add to the bowl. Gently toss the salad to combine.","secondary_message":"3 (170 g) cans chunk light tuna in water"},{"id":170598,"primary_message":"To serve, divide pasta salad between bowls or plates. Garnish with pine nuts and enjoy!","secondary_message":"⅓ cup pine nuts"}],"line_items":[{"id":177594,"quantity":"6","ingredient_name":"anchovy fillets, packed in oil"},{"id":177595,"quantity":"3 (170 ml) jars","ingredient_name":"artichoke hearts, marinated"},{"id":177580,"quantity":"4 ½ tbsp","ingredient_name":"capers"},{"id":177582,"quantity":"3 (170 g) cans","ingredient_name":"chunk light tuna in water"},{"id":177581,"quantity":"3 cloves","ingredient_name":"garlic"},{"id":177593,"quantity":"3 small pkgs","ingredient_name":"grape tomatoes"},{"id":177588,"quantity":"1 small bunch","ingredient_name":"Italian (flat-leaf) parsley"},{"id":177591,"quantity":"1 cup","ingredient_name":"Kalamata olives, pitted"},{"id":177592,"quantity":"⅓ cup","ingredient_name":"pine nuts"},{"id":177590,"quantity":"3","ingredient_name":"shallots"},{"id":177584,"quantity":"425 g","ingredient_name":"spaghetti pasta"},{"id":177589,"quant
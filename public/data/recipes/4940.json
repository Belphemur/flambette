{"id":4940,"recipe_id":217,"serving_count":6,"cooking_minutes":40,"name":"Southwest White Chicken Chili with Avocado \u0026 Crusty Bread","slug":"southwest-white-chicken-chili-avocado-crusty-bread","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/217/thumbnail_c23d4086-2dc1-4560-95fc-d6a6e43b41a6.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/217/presentation_c23d4086-2dc1-4560-95fc-d6a6e43b41a6.jpg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":36,"name":"salad spinner (optional)","slug":"salad-spinner"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":77,"name":"toaster (optional)","slug":"toaster"}],"instructions":[{"id":60033,"primary_message":"Heat a large pot over medium heat.","secondary_message":""},{"id":60032,"primary_message":"Peel and small dice onion. Peel and mince garlic. Wash, seed, and mince jalapeño.","secondary_message":"1 ½ medium yellow onion\n6 cloves garlic\n3 jalapeño peppers"},{"id":60023,"primary_message":"Coat bottom of pot with oil. Add onion, garlic, and jalapeños. Stirring frequently, cook until onion is softened, 3-4 minutes.","secondary_message":"about 3 tbsp virgin coconut oil"},{"id":60031,"primary_message":"Cut chicken into bite-sized pieces.","secondary_message":"0.681 kg chicken breasts, boneless skinless"},{"id":60030,"primary_message":"Drain and rinse beans.","secondary_message":"3 (398 ml) cans cannellini (white kidney) beans"},{"id":60029,"primary_message":"Add chicken to pot and, stirring occasionally, cook until no longer
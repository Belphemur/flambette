{"id":12978,"recipe_id":1510,"serving_count":6,"cooking_minutes":45,"name":"Bell Pepper-Goat Cheese Polenta with Roasted Veggies","slug":"bell-pepper-goat-cheese-polenta-roasted-veggies","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1510/thumbnail_0f0d2ab2-1f33-490a-9e8e-67051cc80283.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1510/presentation_0f0d2ab2-1f33-490a-9e8e-67051cc80283.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":48,"name":"medium saucepan","slug":"medium-saucepan"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":125,"name":"parchment paper","slug":"parchment-paper"},{"id":18,"name":"spatula","slug":"spatula"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":217933,"primary_message":"Preheat oven to 205°C (400°F). Line two baking sheet pans with parchment paper.","secondary_message":null},{"id":217934,"primary_message":"Wash and dry the fresh produce.","secondary_message":"1.36 kg sweet potatoes\n3 crowns broccoli\n1 ½ red bell peppers\n1 small pkg chives"},{"id":217935,"primary_message":"Peel and small dice sweet potatoes; divide between baking sheets.","secondary_message":null},{"id":217936,"primary_message":"Separate broccoli into bite-sized florets and cut stems into smaller pieces; divide between baking sheets.","secondary_message":null},{"id":217937,"primary_message":"Peel and medium dice onions; divide between baking sheets.","secondary_message":"1 ½ medium red onions"},{"id":217938,"primary_message":"Drizzle oil over veggies and season with salt and pepper; toss to coat, then spread out in an even layer. Place in the oven and bake until veggies are fork-tender, 25 -30 minutes.","secondary_message":"3 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"},{"id":217939,"primary_message":"Pour broth into a medium saucepan, cover, and bring to a boil over high heat.","secondary_message":"1774 ml chicken or vegetable broth"},{"id":217940,"primary_message":"Meanwhile, trim, seed, and mince bell peppers; add to the pan with the boiling broth.","secondary_message":null},{"id":217941,"primary_message":"Reduce heat to low and gradually add polenta to the pan in a thin steady stream, while whisking constantly, until the polenta is incorporated into the broth. Cook, stirring occasionally, until grains are soft and the texture is creamy, 15-25 minutes.","secondary_message":"1 ½ cups polenta (cornmeal)"},{"id":217942,"primary_message":"Meanwhile, crumble goat cheese into a small bowl.","secondary_message":"1 ½ (113 g) logs goat cheese"},{"id":217943,"primary_message":"Chop chives into small pieces.","secondary_message":null},{"id":217944,"primary_message":"When the polenta is done, add oil, goat cheese, and half of the chives to the pan and stir until smooth.","secondary_message":"3 tbsp extra virgin olive oil"},{"id":217945,"primary_message":"To serve, divide polenta and veggies between bowls. Top with remaining chives and enjoy!","secondary_message":null}],"line_items":[{"id":228674,"quantity":"3 crowns","ingredient_name":"broccoli"},{"id":228679,"quantity":"1774 ml","ingredient_name":"chicken or vegetable broth"},{"id":228680,"quantity":"1 small pkg","ingredient_name":"chives"},{"id":228675,"quantity":"1 ½ (113 g) logs","ingredient_name":"goat cheese"},{"id":228681,"quantity":"1 ½ cups","ingredient_name":"polenta (cornmeal)"},{"id":228677,"quantity":"1 ½","ingredient_name":"red bell peppers"},{"id"
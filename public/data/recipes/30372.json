{"id":30372,"recipe_id":3384,"serving_count":6,"cooking_minutes":30,"name":"Banana, Apricot \u0026 Almond Oatmeal Protein Bites","slug":"banana-apricot-almond-oatmeal-protein-bites","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3384/thumbnail_4ba36731-fa89-4a62-bc88-03110e86d963.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3384/presentation_4ba36731-fa89-4a62-bc88-03110e86d963.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":125,"name":"parchment paper","slug":"parchment-paper"},{"id":16,"name":"potato masher","slug":"potato-masher"},{"id":18,"name":"spatula","slug":"spatula"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":483547,"primary_message":"Preheat oven to 175°C (350°F). Line two large baking sheet pans with parchment paper.","secondary_message":null},{"id":483548,"primary_message":"Peel bananas, break into chunks, and place in a medium bowl. Mash with a fork or potato masher until smooth.","secondary_message":"3 bananas"},{"id":483549,"primary_message":"Add eggs and maple syrup to the bowl with the banana. Stir to combine.","secondary_message":"3 eggs\n3 tbsp pure maple syrup"},{"id":483550,"primary_message":"Roughly chop apricots and almonds. Add both to the bowl along with oats, protein powder, cinnamon, and cardamom. Stir once more to combine the batter.","secondary_message":"18 dried apricots\n¾ cup almonds\n2 ¼ cup oats, quick cooking\n3 servings vanilla whey-based protein powder (containing 20 grams protein/serving)\n¾ tsp cinnamon, ground\n¼ tsp cardamom, ground"},{"id":483551,"primary_message":"Using a ¼-cup measure, scoop batter onto the baking sheets, leaving some space between. Use the back of a spoon to spread each \"bite\" into a 3-inch circle. Place in the oven and bake until just firm to the touch, about 12 minutes. Remove from oven.","secondary_message":null},{"id":483552,"primary_message":"Allow to cool for a few minutes before transferring to plates. Enjoy!","secondary_message":null}],"line_items":[{"id":519612,"quantity":"¾ cup","ingredient_name":"almonds"},{"id":519617,"quantity":"3","ingredient_name":"bananas"},{"id":519616,"quantity":"18","ingredient_name":"dried apricots"},{"id":519615,"quantity":"3","ingredient_name":"eggs"},{"id":519619,"quantity":"","ingredient_name":"cardamom, ground"},{"id":519613,"quantity":"","ingredient_name":"cinnamon, ground"},{"id":519618,"quantity":"","ingredient_name":"oats, quick cooking"},{"id":519614,"quantity":"","ingredient_name":"pure maple syrup"},{"id":519620,"quantity":"","ingredient_name":"vanilla whey-based protein powder (containing 20 grams protein/serving)"}],"nutrition":{"energy":405.27,"alcohol":0.0,"ash":3.54,"caffeine":0.0,"water":72.49,"carbs":53.57,"fiber":8.35,"starch":17.98,"sugars":20.83,"fructose":4.43,"galactose":0.01,"glucose":7.18,"lactose":0.0,"maltose":0.01,"sucrose":9.19,"sugar_alcohol":0.0,"fat":13.49,"monounsaturated":7.1,"polyunsaturated":3.42,"omega_3":0.06,"omega_6":3.32,"saturated":1.81,"transfats":0.01,"cholesterol":83.92,"protein":21.16,"alanine":0.53,"arginine":0.89,"aspartic_acid":1.25,"cystine":0.24,"glutamic_acid":2.37,"glycine":0.56,"histidine":0.25,"isoleucine":0.44,"leucine":0.82,"lysine":0.51,"methionine":0.18,"phenylalanine":0.56,"proline":0.52,"serine":0.6,"threonine":0.36,"tryptophan":0.13,"tyrosine":0.32,"valine":0.56,"b1_thiamine":0.27,"b2_riboflavin":0.75,"b3_niacin":1.48,"b5_pantothenic_acid":1.55,"b6_pyridoxine":0.19,"b12_cobalamin":0.51,"choline":117.3,"folate":33.51,"vitamin_a":120.49,"vitamin_c":0.16,"vitamin_d":18.04,"vi
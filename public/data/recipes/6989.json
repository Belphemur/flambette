{"id":6989,"recipe_id":794,"serving_count":6,"cooking_minutes":30,"name":"French Toast with Fruit Salad","slug":"french-toast-fruit-salad","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/794/thumbnail_2b7bbb81-f05c-487c-bb05-5edc23137a6b.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/794/presentation_2b7bbb81-f05c-487c-bb05-5edc23137a6b.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":18,"name":"spatula","slug":"spatula"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":102506,"primary_message":"Wash and dry the fresh produce.","secondary_message":"1 ½ (454 g) pkgs strawberries\n3 kiwifruit\n3 oranges\n3 limes"},{"id":102507,"primary_message":"Trim the strawberry tops and thinly slice; add to a large bowl.","secondary_message":null},{"id":102508,"primary_message":"Using a knife, trim off the ends and peel the kiwis; slice into pieces and add to the bowl with the strawberries.","secondary_message":null},{"id":102509,"primary_message":"Slice off a piece from both orange ends, then place it flat on one of the ends and slice off the peel (from top to bottom), exposing the flesh; cut out the segments of flesh from between the membranes. Add to the bowl.","secondary_message":null},{"id":102510,"primary_message":"Juice the limes into the bowl with the fruit and toss to combine, set aside.","secondary_message":null},{"id":102511,"primary_message":"In a medium bowl, whisk together the eggs, milk, and cinnamon.","secondary_message":"6 eggs\n177 ml whole milk\n¾ tsp cinnamon"},{"id":102512,"primary_message":"Preheat a large skillet over medium heat.","secondary_message":null},{"id":102513,"primary_message":"Once the skillet is hot, add butter and swirl to coat the bottom.","secondary_message":"¼ cup butter, unsalted"},{"id":102514,"primary_message":"Working in batches, dip the slices of bread into the egg batter, covering both sides. Place into the hot skillet and cook for 2-3 min per side, until each side is browned evenly.","secondary_message":"12 slices whole grain bread"},{"id":102515,"primary_message":"Remove the slices of bread from the skillet and divide onto plates. Top with butter and a drizzle of maple syrup. Serve the fruit salad on the side. Enjoy!","secondary_message":"1 tbsp butter, unsalted\n⅓ cup pure maple syrup"}],"line_items":[{"id":106611,"quantity":"6","ingredient_name":"eggs"},{"id":106613,"quantity":"3","ingredient_name":"kiwifruit"},{"id":106614,"quantity":"3","ingredient_name":"limes"},{"id":106615,"quantity":"3","ingredient_name":"oranges"},{"id":106616,"quantity":"1 ½ (454 g) pkgs","ingredient_name":"strawberries"},{"id":106612,"quantity":"12 slices","ingredient_name":"whole grain bread"},{"id":106610,"quantity":"177 ml","ingredient_name":"whole milk"},{"id":106609,"quantity":"","ingredient_name":"butter, unsalted"},{"id":106607,"quantity":"","ingredient_name":"cinnamon, ground"},{"id":106608,"quantity":"","ingredient_name":"pure maple syrup"}],"nutrition":{"energy":483.74,"alcohol":0.0,"ash":3.29,"caffeine":0.0,"water":302.84,"carbs":66.1,"fiber":8.98,"starch":18.52,"sugars":31.71,"fructose":7.26,"galactose":0.07,"glucose":6.21,"lactose":1.62,"maltose":0.72,"sucrose":15.28,"sugar_alcohol":0.0,"fat":18.74,"monounsaturated":5.11,"polyunsaturated":2.62,"omega_3":0.29,"omega_6":2.33,"saturated":9.22,"transfats":0.5,"cholesterol":195.09,"protein":16.45,"alanine":0.45,"arginine":0.5,"aspartic_acid":0.99,"cystine":0.1
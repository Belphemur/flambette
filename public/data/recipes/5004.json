{"id":5004,"recipe_id":46,"serving_count":6,"cooking_minutes":45,"name":"Thai Coconut Chicken Soup with Mushrooms \u0026 Bell Pepper","slug":"thai-coconut-chicken-soup-mushrooms-bell-pepper","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/46/thumbnail_90c9fcb3-599f-4136-87fa-431572d0061b.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/46/presentation_90c9fcb3-599f-4136-87fa-431572d0061b.jpg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":57,"name":"ladle","slug":"ladle"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":48,"name":"medium saucepan","slug":"medium-saucepan"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":36,"name":"salad spinner (optional)","slug":"salad-spinner"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":77,"name":"toaster (optional)","slug":"toaster"}],"instructions":[{"id":60716,"primary_message":"Wash and dry mushrooms and bell peppers. Thinly slice mushrooms. Seed and small dice peppers. Transfer both to a large bowl.","secondary_message":"0.341 kg white mushrooms\n3 orange bell peppers"},{"id":60715,"primary_message":"Peel and mince garlic and ginger. Grate 3 tsp of lime zest.","secondary_message":"6 cloves garlic\n3 (2 ½ cm) pieces ginger\n3 limes"},{"id":60714,"primary_message":"Heat a large saucepan over medium heat.","secondary_message":""},{"id":60713,"primary_message":"Cut chicken into bite-sized pieces.","secondary_message":"0.681 kg chicken breasts, boneless skinless"},{"id":60712,"primary_message":"Coat bottom of saucepan with oil. Add chicken and, stirring frequen
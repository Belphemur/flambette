{"id":7452,"recipe_id":858,"serving_count":6,"cooking_minutes":20,"name":"Maple-Cinnamon Roasted Peach \u0026 Cashew Yogurt Bowl","slug":"maple-cinnamon-roasted-peach-cashew-yogurt-bowl","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/858/thumbnail_2066ad03-59f5-4471-a2fd-17e5907ad09f.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/858/presentation_2066ad03-59f5-4471-a2fd-17e5907ad09f.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":125,"name":"parchment paper","slug":"parchment-paper"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":107112,"primary_message":"Preheat the oven to 230°C (450°F) and place the rack in the center position. Line a baking sheet pan with parchment paper.","secondary_message":null},{"id":107113,"primary_message":"Wash and dry, then halve the peaches. Twist to open, and remove pits. Slice each half into 4 wedges, and transfer to the baking sheet pan.","secondary_message":"6 peaches"},{"id":107114,"primary_message":"Drizzle maple syrup and cinnamon over the peaches, and spread out in an even layer.","secondary_message":"¾ tsp cinnamon\n¼ cup pure maple syrup"},{"id":107115,"primary_message":"Dot the peaches with coconut oil, and place in the oven (it doesn't have to be fully heated). Cook for 5 minutes.","secondary_message":"1 tbsp virgin coconut oil"},{"id":107116,"primary_message":"Remove baking sheet from the oven, sprinkle cashews and salt over the peaches, and stir to combine. Return to the oven and bake for another 5 minutes, or until peaches begin to swell and juices are bubbling.","secondary_message":"1 ½ cups cashews, roasted unsalted\n3 pinch salt"},{"id":107117,"primary_message":"To serve, divide yogurt between bowls and top with warm peaches and cashews; drizzle pan juices over the top. Enjoy!","secondary_message":"6 cups plain Greek yogurt"}],"line_items":[{"id":111313,"quantity":"1 ½ cups","ingredient_name":"cashews, roasted unsalted"},{"id":111316,"quantity":"6","ingredient_name":"peaches"},{"id":111314,"quantity":"6 cups","ingredient_name":"plain Greek yogurt"},{"id":111310,"quantity":"","ingredient_name":"cinnamon, ground"},{"id":111312,"quantity":"","ingredient_name":"pure maple syrup"},{"id":111311,"quantity":"","ingredient_name":"salt"},{"id":111315,"quantity":"","ingredient_name":"virgin coconut oil"}],"nutrition":{"energy":459.26,"alcohol":0.0,"ash":4.04,"caffeine":0.0,"water":347.27,"carbs":44.63,"fiber":3.45,"starch":6.69,"sugars":31.3,"fructose":2.38,"galactose":1.8,"glucose":3.22,"lactose":6.22,"maltose":0.12,"sucrose":17.54,"sugar_alcohol":0.07,"fat":19.52,"monounsaturated":9.72,"polyunsaturated":2.89,"omega_3":0.06,"omega_6":2.82,"saturated":5.45,"transfats":0.01,"cholesterol":12.25,"protein":31.59,"alanine":1.31,"arginine":1.33,"aspartic_acid":3.52,"cystine":0.51,"glutamic_acid":6.05,"glycine":0.77,"histidine":0.72,"isoleucine":1.53,"leucine":2.86,"lysine":2.46,"methionine":0.62,"phenylalanine":1.23,"proline":1.98,"serine":1.56,"threonine":1.43,"tryptophan":0.56,"tyrosine":0.97,"valine":1.71,"b1_thiamine":0.17,"b2_riboflavin":0.99,"b3_niacin":2.21,"b5_pantothenic_acid":1.46,"b6_pyridoxine":0.28,"b12_cobalamin":1.84,"choline":67.32,"folate":46.8,"vitamin_a":499.77,"vitamin_c":9.91,"vitamin_d":0.0,"vitamin_e":1.44,"vitamin_k":15.9,"calcium":309.24,"copper":0.91,"iron":2.65,"magnesium":132.85,"manganese":0.89,"phosphorus":529.09,"potassium":857.15,"selenium":28.02,"sodium":95.58,"zinc":3.68}}
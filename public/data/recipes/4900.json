{"id":4900,"recipe_id":123,"serving_count":6,"cooking_minutes":35,"name":"Italian Tuna Melt with Tomato, Parmesan \u0026 Arugula","slug":"italian-tuna-melt-tomato-parmesan-arugula","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/123/thumbnail_3b49c160-9d37-43fd-b62d-53d5f459fb58.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/123/presentation_3b49c160-9d37-43fd-b62d-53d5f459fb58.jpg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":36,"name":"salad spinner (optional)","slug":"salad-spinner"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":59607,"primary_message":"Preheat oven to broil and position rack under the broiler.","secondary_message":""},{"id":59606,"primary_message":"Peel and mince garlic. In a medium bowl, whisk together garlic, oil, vinegar, Dijon, dill, salt, and pepper.","secondary_message":"3 cloves garlic\n6 tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n3 tbsp Dijon mustard\n1 ½ tsp dill\n⅜ tsp salt\n⅜ tsp black pepper"},{"id":59605,"primary_message":"Drain tuna, add to bowl, and flake with a fork.","secondary_message":"3 (170 g) cans chunk light tuna in water"},{"id":59604,"primary_message":"Wash, dry, and small dice celery. Add to bowl and mix well. Set aside.","secondary_message":"3 sticks celery"},{"id":59603,"primary_message":"Wash and dry arugula. Wash and slice tomatoes into rounds.","secondary_message":"1 ½ (142 g) pkg baby arugula\n3 tomatoes"},{"id":59602,"primary_message":"Grate ¾ cup Parmesan.","secondary_message":"84 g Parmesan cheese"},{"id":59601,"primary_message":"Place bread slices on a sheet pan. Top 6 of the slices with a few arugula leaves, tomato slices, and tuna mixture. Sprinkle with Parmesan.","secondary_message":"12 slices whole grain bread"},{"id":59600,"primary_message":"Place in the oven and broil until cheese melts and browns, 3-4 minutes.","secondary_message":""},{"id":59599,"primary_message":"In a large bowl, prepare salad dressing by whisking together oil, vinegar, Dijon, salt, and pepper.","secondary_message":"4 ½ tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n⅜ tsp Dijon mustard\n3 pinches salt\n3 pinches black pepper"},{"id":59598,"primary_message":"Add arugula to bowl and toss to coat.","secondary_message":""},{"id":59597,"primary_message":"To serve, place tuna melts on a plate and have salad on the side. Enjoy!","secondary_message":""}],"line_items":[{"id":63133,"quantity":"1 ½ (142 g) pkg","ingredient_name":"baby arugula"},{"id":63132,"quantity":"3 sticks","ingredient_name":"celery"},{"id":63138,"quantity":"3 (170 g) cans","ingredient_name":"chunk light tuna in water"},{"id":63141,"quantity":"3 cloves","ingredient_name":"garlic"},{"id":63140,"quantity":"84 g","ingredient_name":"Parmesan cheese"},{"id":63139,"quantity":"3","ingredient_name":"tomatoes"},{"id":63137,"quantity":"12 slices","ingredient_name":"whole grain bread"},{"id":63131,"quantity":"","ingredient_name":"black pepper"},{"id":63136,"quantity":"","ingredient_name":"Dijon mustard"},{"id":63130,"quantity":"","ingredient_name":"dill, dried"},{"id":63135,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":63134,"quantity":"","ingredient_name":"red wine vinegar"},{"id":63129,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":516.1,"alcohol":0.01,"ash":5.09,"caffeine":0.0,"water":199.73,"carbs":33.39,"fiber":5.85,"starch":19.01,"sugars":5.7,"fructose
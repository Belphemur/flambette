{"id":12060,"recipe_id":1395,"serving_count":6,"cooking_minutes":35,"name":"Mango Chia Seed Pudding with Pistachios","slug":"mango-chia-seed-pudding-pistachios","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1395/thumbnail_1f70e7d0-9c28-4d9d-a6d1-d6f6f4ec4469.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1395/presentation_1f70e7d0-9c28-4d9d-a6d1-d6f6f4ec4469.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":74,"name":"hand or regular blender","slug":"hand-or-regular-blender"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":127,"name":"plastic wrap","slug":"plastic-wrap"},{"id":129,"name":"silicone spatula","slug":"silicone-spatula"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":203333,"primary_message":"This recipe will make about 6 cups of pudding. Work in batches to best fit your blender.","secondary_message":null},{"id":203334,"primary_message":"Wash, dry, and peel mangos; slice flesh away from the pits, starting with the flat sides. Small dice half the mangos and transfer to a small bowl or container. Cover with plastic wrap or a lid and refrigerate until ready to serve.","secondary_message":"3 mangoes"},{"id":203335,"primary_message":"Roughly chop remaining mangos and transfer to a blender.","secondary_message":null},{"id":203336,"primary_message":"Wash, dry, and juice limes into the blender.","secondary_message":"1 ½ limes"},{"id":203337,"primary_message":"Add milk, sugar, maple syrup, vanilla, cinnamon, and cardamom to the blender. Blend on high speed for several minutes until smooth.","secondary_message":"710 ml whole milk\n½ cup granulated sugar\n⅓ cup pure maple syrup\n1 ½ tsp vanilla extract\n3 pinch cinnamon\n3 pinch cardamom, ground"},{"id":203338,"primary_message":"Pour the mango mixture into a large bowl, add chia seeds, and whisk to combine. Let the mixture rest, whisking occasionally, until chia seeds start to swell, about 15 minutes.","secondary_message":"½ cup chia seeds"},{"id":203339,"primary_message":"When the chia seeds are slightly swollen, whisk the pudding once more to separate any seeds that are clumped together. Cover the bowl with plastic wrap or a lid and refrigerate until set, about 2 hours (or overnight).","secondary_message":null},{"id":203340,"primary_message":"Right before serving, roughly chop pistachios.","secondary_message":"⅜ cup pistachios, unsalted"},{"id":203341,"primary_message":"To serve, divide chia seed pudding between small bowls or cups; top with the reserved diced mango and pistachios. Enjoy!","secondary_message":null}],"line_items":[{"id":212668,"quantity":"1 ½","ingredient_name":"limes"},{"id":212669,"quantity":"3","ingredient_name":"mangoes"},{"id":212670,"quantity":"0.375 cup","ingredient_name":"pistachios, unsalted"},{"id":212667,"quantity":"710 ml","ingredient_name":"whole milk"},{"id":212672,"quantity":"","ingredient_name":"cardamom, ground"},{"id":212673,"quantity":"","ingredient_name":"chia seeds"},{"id":212665,"quantity":"","ingredient_name":"cinnamon, ground"},{"id":212671,"quantity":"","ingredient_name":"granulated sugar"},{"id":212666,"quantity":"","ingredient_name":"pure maple syrup"},{"id":212674,"quantity":"","ingredient_name":"vanilla extract"}],"nutrition":{"energy":436.26,"alcohol":0.38,"ash":2.67,"caffeine":0.0,"water":266.02,"carbs":73.76,"fiber":9.83,"starch":0.51,"sugars":60.3,"fructose":8.05,"galactose":0.0,"glucose":3.78,"lactose":6.16,"maltose":0.01,"sucrose":42.15,"sugar_alcohol":0.0,"fat":13.68,"monounsaturated":3.47,"polyunsaturated":5.71,"omega_3":3.45,"omega_6":2.26,"saturated":3.46,"transfats":0.17,"cho
{"id":24246,"recipe_id":2709,"serving_count":6,"cooking_minutes":30,"name":"Cheesy Broccoli-Bacon Soup with Bell Pepper, Cucumber \u0026 Arugula Salad","slug":"cheesy-broccoli-bacon-soup-bell-pepper-cucumber-arugula-salad","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2709/thumbnail_e5dd10eb-eead-4416-af37-60b04322f412.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2709/presentation_e5dd10eb-eead-4416-af37-60b04322f412.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":57,"name":"ladle","slug":"ladle"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"}],"instructions":[{"id":424425,"primary_message":"Small dice bacon. ","secondary_message":"12 slices bacon"},{"id":424426,"primary_message":"Preheat a large pot over medium heat.","secondary_message":null},{"id":424427,"primary_message":"Once the pot is hot, add bacon and cook, stirring occasionally, until golden brown and crispy, 5-6 minutes. ","secondary_message":null},{"id":424428,"primary_message":"Meanwhile, wash and dry the fresh produce. ","secondary_message":"3 orange bell peppers\n1 ½ English cucumbers\n1 ½ (142 g) pkgs baby arugula"},{"id":424429,"primary_message":"When the bacon is done, add broth, Alfredo sauce, broccoli, and spices to the pot. Stir to combine the soup and bring to a boil. Once boiling, reduce heat to low and simmer until broccoli is tender, about 5 minutes. Remove from heat.","secondary_message":"1420 ml chicken or vegetable broth\n1 ½ (454 g) jars Alfredo sauce\n1 ½ (510 g) bags broccoli florets\n¾ tsp salt\n
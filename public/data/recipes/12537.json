{"id":12537,"recipe_id":1468,"serving_count":6,"cooking_minutes":40,"name":"Cinnamon Roasted Pears with Vanilla Ice Cream \u0026 Balsamic Glaze","slug":"cinnamon-roasted-pears-vanilla-ice-cream-balsamic-glaze","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1468/thumbnail_0dffec4d-2fa1-4310-8062-560cf3d0dbf5.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1468/presentation_0dffec4d-2fa1-4310-8062-560cf3d0dbf5.jpeg","cookwares":[{"id":83,"name":"baking dish","slug":"baking-dish"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":133,"name":"ice cream scoop (optional)","slug":"ice-cream-scoop"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":48,"name":"medium saucepan","slug":"medium-saucepan"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":211329,"primary_message":"Preheat oven to 230°C (450°F).","secondary_message":null},{"id":211330,"primary_message":"Wash, dry, and juice lemons into a medium saucepan; add butter and cinnamon. Set over medium heat to melt. Whisk to combine and remove from heat.","secondary_message":"1 ½ lemons\n3 tbsp butter, unsalted\n¾ tsp cinnamon"},{"id":211331,"primary_message":"Meanwhile, wash, dry, quarter, and core pears. Place in a large baking dish and drizzle with lemon butter. (Reserve saucepan for later use.)","secondary_message":"6 pears"},{"id":211332,"primary_message":"Place pears in the oven (it doesn't have to be fully heated) and roast until fork-tender, 20-25 minutes. Remove from oven.","secondary_message":null},{"id":211333,"primary_message":"While the pears are baking, place sugar and vinegar in the saucepan, return to medium heat, and whisk to combine.","secondary_message":"1 cup brown sugar\n⅓ cup balsamic vinegar"},{"id":211334,"primary_message":"Increase heat to high and bring the mixture to a boil; Cook, whisking constantly, until smooth and slightly thickened, about 2 minutes. Remove glaze from heat and cover to keep warm.","secondary_message":null},{"id":211335,"primary_message":"To serve, divide pears and ice cream between bowls and drizzle with glaze. Enjoy!","secondary_message":"532 ml vanilla ice cream"}],"line_items":[{"id":221377,"quantity":"1 ½","ingredient_name":"lemons"},{"id":221378,"quantity":"6","ingredient_name":"pears"},{"id":221380,"quantity":"532 ml","ingredient_name":"vanilla ice cream"},{"id":221376,"quantity":"","ingredient_name":"balsamic vinegar"},{"id":221379,"quantity":"","ingredient_name":"brown sugar"},{"id":221375,"quantity":"","ingredient_name":"butter, unsalted"},{"id":221374,"quantity":"","ingredient_name":"cinnamon, ground"}],"nutrition":{"energy":416.7,"alcohol":0.0,"ash":1.29,"caffeine":0.0,"water":205.54,"carbs":79.37,"fiber":6.08,"starch":4.32,"sugars":66.9,"fructose":13.17,"galactose":0.0,"glucose":6.48,"lactose":0.04,"maltose":0.0,"sucrose":36.49,"sugar_alcohol":0.0,"fat":11.68,"monounsaturated":3.16,"polyunsaturated":0.62,"omega_3":0.11,"omega_6":0.5,"saturated":7.17,"transfats":0.24,"cholesterol":37.71,"protein":2.65,"alanine":0.11,"arginine":0.09,"aspartic_acid":0.32,"cystine":0.02,"glutamic_acid":0.43,"glycine":0.08,"histidine":0.05,"isoleucine":0.12,"leucine":0.2,"lysine":0.17,"methionine":0.05,"phenylalanine":0.11,"proline":0.21,"serine":0.12,"threonine":0.1,"tryptophan":0.03,"tyrosine":0.09,"valine":0.15,"b1_thiamine":0.05,"b2_riboflavin":0.17,"b3_niacin":0.4,"b5_pantothenic_acid":0.45,"b6_pyridoxine":0.1,"b12_cobalamin":0.21,"choline":25.77,"folate":17.99,"vitamin_a":259.11,"vitamin_c":12.61,"vitamin_d":4.42,"vitamin_e":0.56,"vitamin_k":8.59,"calcium":118.4,"copper":0.18,"iron":0.78,"magnesium":25.89,"manganese":0.19,"p
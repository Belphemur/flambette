{"id":10893,"recipe_id":1272,"serving_count":6,"cooking_minutes":40,"name":"Sheet Pan Roasted Chicken \u0026 Veggie Pitas with Lemony Yogurt","slug":"sheet-pan-roasted-chicken-veggie-pitas-lemony-yogurt","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1272/thumbnail_ee6479f0-e37a-4623-8270-b1048eb1fa13.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1272/presentation_ee6479f0-e37a-4623-8270-b1048eb1fa13.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":77,"name":"toaster (optional)","slug":"toaster"},{"id":35,"name":"tongs","slug":"tongs"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":197238,"primary_message":"Preheat oven to 220°C (425°F).","secondary_message":null},{"id":197239,"primary_message":"Wash and dry the fresh produce.","secondary_message":"3 lemons\n0.68 kg sweet potato\n1 ½ English cucumbers\n1 small bunch cilantro"},{"id":197240,"primary_message":"Zest lemons into a small bowl, add yogurt, and whisk to combine. Set aside.","secondary_message":"1 ½ cups plain Greek yogurt"},{"id":197241,"primary_message":"Peel and mince garlic; place in a large bowl.","secondary_message":"6 cloves garlic"},{"id":197242,"primary_message":"Juice lemons into the bowl with the garlic. Add oil, honey, and spices; whisk to combine.","secondary_message":"3 tbsp extra virgin olive oil\n1 tbsp honey\n1 ½ tsp thyme\n1 ½ tsp salt\n1 ½ tsp black pepper"},{"id":197243,"primary_message":"Cut the chicken into small bite-sized pieces and add to the bowl.","secondary_message":"1.36 kg chicken thighs, boneless skinless"},{"id":197244,"primary_message":"Peel, halve, and thinly slice the sweet potatoes into half rounds; add to the bowl.","secondary_message":null},{"id":197245,"primary_message":"Peel, trim, and cut the onions into thick wedges; add to the bowl and toss to coat.","secondary_message":"1 ½ medium red onions"},{"id":197246,"primary_message":"Divide chicken and veggies between two baking sheet pans and arrange in a single layer. Place in the oven and bake, tossing once, until the chicken is cooked through and veggies are fork-tender, 25-30 minutes.","secondary_message":null},{"id":197247,"primary_message":"Meanwhile, trim and thinly slice the cucumbers; place in a medium bowl along with the salt and pepper.","secondary_message":"½ tsp salt\n3 pinch black pepper"},{"id":197248,"primary_message":"Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add half to the bowl with the cucumber and toss to combine; reserve the other half for garnish.","secondary_message":null},{"id":197249,"primary_message":"Toast pitas if desired.","secondary_message":"6 whole grain pitas"},{"id":197250,"primary_message":"To serve, divide pitas between plates and spread with lemon yogurt. Top with chicken, veggies, cucumbers, and remaining cilantro. Enjoy!","secondary_message":null}],"line_items":[{"id":205923,"quantity":"1.36 kg","ingredient_name":"chicken thighs, boneless skinless"},{"id":205925,"quantity":"1 small bunch","ingredient_name":"cilantro"},{"id":205922,"quantity":"1 ½","ingredient_name":"English cucumbers"},{"id":205914,"quantity":"6 cloves","ingredient_name":"garlic"},{"id":205926,"quantity":"3","ingredient_name":"lemons"},{"id":205920,"quantity":"1 ½ cups","ingredi
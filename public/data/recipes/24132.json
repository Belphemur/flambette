{"id":24132,"recipe_id":2700,"serving_count":6,"cooking_minutes":25,"name":"Vegan Lemon-Jalapeño Lentil Pâté with Cucumber Slices","slug":"vegan-lemon-jalapeno-lentil-pate-cucumber-slices","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2700/thumbnail_8f4b44c0-ecc8-480b-9736-15d4b7fbcc1c.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2700/presentation_8f4b44c0-ecc8-480b-9736-15d4b7fbcc1c.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":16,"name":"potato masher","slug":"potato-masher"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":392092,"primary_message":"Wash and dry the fresh produce.","secondary_message":"1 ½ lemons\n1 ½ jalapeño peppers\n1 ½ English cucumbers"},{"id":392093,"primary_message":"Drain and rinse lentils in a colander. Using the back of a spoon, gently press on the lentils to remove excess liquid, then transfer to a medium bowl. Use a fork or potato masher to crush the lentils until they are broken down.","secondary_message":"3 (255 g) cans lentils"},{"id":392094,"primary_message":"Juice lemons into the bowl with the lentils.","secondary_message":null},{"id":392095,"primary_message":"Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)","secondary_message":null},{"id":392096,"primary_message":"Add oil, Dijon, and spices to the bowl. Stir to combine the lentil pâté.","secondary_message":"3 tbsp extra
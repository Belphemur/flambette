{"id":38855,"recipe_id":4189,"serving_count":6,"cooking_minutes":40,"name":"Smoky Tempeh Fajitas with Peppers, Onions \u0026 Avocado","slug":"smoky-tempeh-fajitas-peppers-onions-avocado","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/4189/thumbnail_d0239660-0821-47e0-b6a8-614f1b1b8e2a.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/4189/presentation_d0239660-0821-47e0-b6a8-614f1b1b8e2a.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":605023,"primary_message":"Preheat oven to 220°C (425°F).","secondary_message":null},{"id":605024,"primary_message":"Place oil and spices in a large bowl. Stir to combine the spice paste.","secondary_message":"¼ cup extra virgin olive oil\n2 tbsp chili powder\n1 tbsp smoked paprika\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"},{"id":605025,"primary_message":"Slice tempeh crosswise into ½-inch thick pieces. Add to the bowl with the spice paste, gently stir to coat, and set aside.","secondary_message":"3 (227g ) pkgs tempeh"},{"id":605026,"primary_message":"Wash and dry the fresh produce.","secondary_message":"3 green bell peppers\n3 yellow bell peppers\n1 ½ limes\n1 ½ avocados"},{"id":605027,"primary_message":"Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl with the tempeh.","secondary_message":null},{"id":605028,"primary_message":"Peel, halve, and slice onions crosswise into ½-inch thick half-moons. Add to the bowl and gently stir once more to combine. Divide tempeh and veggies between two large baking sheet pans and spread out in an even layer.","secondary_message":"1 ½ medium red onions"},{"id":605029,"primary_message":"Place baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until tempeh is browned and veggies are fork-tender, 15-18 minutes. Remove from oven.","secondary_message":null},{"id":605030,"primary_message":"Meanwhile, cut limes into wedges. Set aside for serving.","secondary_message":null},{"id":605031,"primary_message":"Halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Set aside.","secondary_message":null},{"id":605032,"primary_message":"Warm tortillas in a skillet, oven, or microwave (optional).","secondary_message":"18 small flour tortillas"},{"id":605033,"primary_message":"Divide tortillas between plates, then fill with tempeh, veggies, and avocado. Serve with lime wedges for squeezing and enjoy!","secondary_message":null}],"line_items":[{"id":656833,"quantity":"1 ½","ingredient_name":"avocados"},{"id":656838,"quantity":"3","ingredient_name":"green bell peppers"},{"id":656836,"quantity":"1 ½","ingredient_name":"limes"},{"id":656834,"quantity":"1 ½ medium","ingredient_name":"red onions"},{"id":656835,"quantity":"18","ingredient_name":"small flour tortillas"},{"id":656839,"quantity":"3 (227g ) pkgs","ingredient_name":"tempeh"},{"id":656837,"quantity":"3","ingredient_name":"yellow bell peppers"},{"id":656829,"quantity":"","ingredient_name":"black pepper"},{"id":656830,"quantity":"","ingredient_name":"chili powder"},{"id":656828,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":656831,"quantity":"","ingredient_name":"oregano, dried"},{"id":656832,"quantity":"","ingredient_name":"salt"},{"id":656840,"quantity":"","ingredient_name":"smoked paprika"}],"nutrition":{"energy":695.95,"alcohol":0.0,"ash":7.37,"caffeine":0.0,"water":276.62,"carbs":68.32,"fiber":8.88,"s
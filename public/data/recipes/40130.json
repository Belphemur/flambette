{"id":40130,"recipe_id":4309,"serving_count":6,"cooking_minutes":30,"name":"Chicken Shawarma Lettuce Wraps with Avocado \u0026 Lemon-Garlic Mayo","slug":"chicken-shawarma-lettuce-wraps-avocado-lemon-garlic-mayo","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/4309/thumbnail_482e636f-6555-4474-952c-7b5b1dd9dc7a.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/4309/presentation_482e636f-6555-4474-952c-7b5b1dd9dc7a.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":622213,"primary_message":"Wash and dry the fresh produce.","secondary_message":"1 small bunch green onions (scallions)\n1 ½ lemons\n3 tomatoes\n1 ½ avocados\n1 ½ heads butter (Boston) lettuce"},{"id":622214,"primary_message":"Place spices in a large bowl. Stir to combine the spice rub.","secondary_message":"1 tbsp cumin, ground\n1 ½ tsp smoked paprika\n1 ½ tsp coriander, ground\n1 ½ tsp turmeric, ground\n1 ½ tsp salt\n½ tsp cinnamon, ground\n½ tsp cayenne pepper"},{"id":622215,"primary_message":"Trim and cut green onions crosswise into thin pieces. Add to the bowl with the spice rub.","secondary_message":null},{"id":622216,"primary_message":"Preheat a large skillet over medium-high heat.","secondary_message":null},{"id":622217,"primary_message":"While the skillet heats up, pat the chicken breast dry with pap
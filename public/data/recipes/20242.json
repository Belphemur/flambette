{"id":20242,"recipe_id":2317,"serving_count":6,"cooking_minutes":30,"name":"Pan-Fried Zucchini Egg Nests with Bacon \u0026 Tomato","slug":"pan-fried-zucchini-egg-nests-bacon-tomato","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2317/thumbnail_4b51e140-c5e3-4a3d-8452-bb07482f71f6.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2317/presentation_4b51e140-c5e3-4a3d-8452-bb07482f71f6.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":86,"name":"julienne peeler (optional)","slug":"julienne-peeler"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":18,"name":"spatula","slug":"spatula"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"}],"instructions":[{"id":337733,"primary_message":"Preheat two large skillets over medium-high heat.","secondary_message":null},{"id":337734,"primary_message":"Once the skillets are hot, divide bacon between them and cook until crispy, 3-5 minutes per side. Remove bacon to a paper towel-lined plate. (Reserve both skillets with drippings for later use.)","secondary_message":"12 slices bacon"},{"id":337735,"primary_message":"Meanwhile, wash, dry, and trim zucchini; use a julienne (or regular) peeler to make noodles. ","secondary_message":"6 medium zucchini squash"},{"id":337736,"primary_message":"Return both skillets (with drippings) to medium-high heat; divide the zucchini noodles and spices between them. Cook, stirring occasionally, until starting to soften, about 2 minutes.","secondary_message":"1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"},{"id":337737,"primary_message":"When the zucchini noodles are soft, reduce heat to medium-low. Using a spatula, divide and shape noodles into 12 flattened mounds (6 mounds per skillet), making an indent at the center of each to create a \"nest.\"","secondary_message":null},{"id":337738,"primary_message":"Gently crack an egg into each \"nest.\" Cover each skillet with a lid and cook until the tops of the whites are set but the yolks are still runny, 3-4 minutes; remove from heat.","secondary_message":"12 eggs"},{"id":337739,"primary_message":"Meanwhile, wash, dry, and halve tomatoes.","secondary_message":"1 ½ small pkgs grape tomatoes"},{"id":337740,"primary_message":"To serve, divide zucchini egg nests, bacon, and tomatoes between plates; season eggs with salt and pepper. Enjoy!","secondary_message":"3 pinch salt\n3 pinch black pepper"}],"line_items":[{"id":360538,"quantity":"12 slices","ingredient_name":"bacon"},{"id":360535,"quantity":"12","ingredient_name":"eggs"},{"id":360537,"quantity":"1 ½ small pkgs","ingredient_name":"grape tomatoes"},{"id":360536,"quantity":"6 medium","ingredient_name":"zucchini squash"},{"id":360532,"quantity":"","ingredient_name":"black pepper"},{"id":360533,"quantity":"","ingredient_name":"Italian seasoning"},{"id":360534,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":406.77,"alcohol":0.0,"ash":4.64,"caffeine":0.0,"water":344.5,"carbs":10.52,"fiber":2.98,"starch":0.12,"sugars":7.81,"fructose":3.68,"galactose":0.0,"glucose":3.31,"lactose":0.0,"maltose":0.0,"sucrose":0.82,"sugar_alcohol":0.0,"fat":31.39,"monounsaturated":13.03,"polyunsaturated":5.54,"omega_3":0.38,"omega_6":5.16,"saturated":10.39,"transfats":0.11,"cholesterol":364.32,"protein":21.17,"alanine":1.2,"arginine":1.29,"aspartic_acid":2.22,"cystine":0.35,"glutamic_acid":3.12,"glycine":0.81,"histidine":0.62,"isoleucine":1.03,"leucine":1.7,"lysine":1.58,"methionine":0.57,"phenylalanine":1.0,"proline":0.83,"serine":1.27,"threonine":0.88,"tryptophan":0.26,"tyrosine":0.79,"valine":1.23,"b1_thiamine":0.31,"b2_riboflavin":0.65,"b3_niacin":3.64,"b5_pantothenic_acid":2.13,"b6_pyridoxine":0.68,"b12_cobalamin":1.06,"choli
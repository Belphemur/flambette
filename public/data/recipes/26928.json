{"id":26928,"recipe_id":3037,"serving_count":6,"cooking_minutes":25,"name":"Mango-Lime Yogurt Mousse with Honey \u0026 Pecans","slug":"mango-lime-yogurt-mousse-honey-pecans","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3037/thumbnail_ff8bbc53-218b-46b6-bc1e-4e95e96c5565.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3037/presentation_ff8bbc53-218b-46b6-bc1e-4e95e96c5565.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":52,"name":"grater (optional)","slug":"grater"},{"id":74,"name":"hand or regular blender","slug":"hand-or-regular-blender"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":129,"name":"silicone spatula","slug":"silicone-spatula"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":435064,"primary_message":"Place a large bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)","secondary_message":null},{"id":435065,"primary_message":"Wash, dry, peel, and slice mango flesh away from the pits, starting with the flat sides; medium dice. Place in a blender. ","secondary_message":"3 mangoes"},{"id":435066,"primary_message":"Wash, dry, zest, and juice limes into the blender. Blend on high speed for several minutes until mango is smooth.","secondary_message":"1 ½ limes"},{"id":435067,"primary_message":"Add yogurt and honey to the blender. Blend once more on high speed until combined, then set aside. ","secondary_message":"1 cup plain Greek yogurt\n⅓ cup honey"},{"id":435068,"primary_message":"Remove bowl from the freezer. Pour cold cream into the bowl; use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 4 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)","secondary_message":"355 ml heavy whipping cream"},{"id":435069,"primary_message":"Transfer the mango-yogurt mixture to the bowl with the whipped cream. Using a silicone spatula, gently fold the two together until the mousse is just combined.","secondary_message":null},{"id":435070,"primary_message":"Roughly chop pecans.","secondary_message":"⅓ cup pecan halves"},{"id":435071,"primary_message":"To serve, divide mousse between small bowls, cups, or jars; top with pecans and drizzle with additional honey. Enjoy!","secondary_message":"1 tbsp honey"}],"line_items":[{"id":466579,"quantity":"355 ml","ingredient_name":"heavy whipping cream"},{"id":466577,"quantity":"1 ½","ingredient_name":"limes"},{"id":466578,"quantity":"3","ingredient_name":"mangoes"},{"id":466580,"quantity":"⅓ cup","ingredient_name":"pecan halves"},{"id":466576,"quantity":"1 cup","ingredient_name":"plain Greek yogurt"},{"id":466575,"quantity":"","ingredient_name":"honey"}],"nutrition":{"energy":452.6,"alcohol":0.0,"ash":1.35,"caffeine":0.0,"water":223.65,"carbs":50.71,"fiber":3.36,"starch":20.99,"sugars":46.96,"fructose":18.2,"galactose":1.06,"glucose":12.41,"lactose":2.7,"maltose":0.36,"sucrose":12.23,"sugar_alcohol":0.01,"fat":27.37,"monounsaturated":9.3,"polyunsaturated":2.2,"omega_3":0.47,"omega_6":1.73,"saturated":14.3,"transfats":0.79,"cholesterol":83.58,"protein":7.46,"alanine":0.38,"arginine":0.29,"aspartic_acid":0.68,"cystine":0.09,"glutamic_acid":1.33,"glycine":0.19,"histidine":0.18,"isoleucine":0.35,"leucine":0.64,"lysine":0.59,"methionine":0.14,"phenylalanine":0.29,"proline":0.5,"serine":0.36,"threonine":0.33,"tryptophan":0.12,"tyrosine":0.23,"valine":0.4,"b1_thiamine":0.1,"b2_riboflavin":0.26,"b3_niacin":1.35,"b5_pantothenic_a
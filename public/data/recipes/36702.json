{"id":36702,"recipe_id":3982,"serving_count":6,"cooking_minutes":20,"name":"Scrambled Egg Breakfast Wrap with Prosciutto, Lettuce \u0026 Tomato","slug":"scrambled-egg-breakfast-wrap-prosciutto-lettuce-tomato","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3982/thumbnail_fd21d158-0253-4701-a6ef-1ae0ddf608b5.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3982/presentation_fd21d158-0253-4701-a6ef-1ae0ddf608b5.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":18,"name":"spatula","slug":"spatula"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":576121,"primary_message":"Wash, dry, and halve tomatoes lengthwise, then slice crosswise into thin half-moons. Place on a plate.","secondary_message":"3 tomatoes"},{"id":576122,"primary_message":"Wash, dry, and chop (or tear) lettuce into bite-sized pieces. Add to the plate with the tomato and set aside.","secondary_message":"1 ½ heads butter (Boston) lettuce"},{"id":576123,"primary_message":"Preheat a large skillet over medium heat.","secondary_message":null},{"id":576124,"primary_message":"While the skillet heats up, place eggs and spices in a large bowl. Whisk to combine.","secondary_message":"12 eggs\n¾ tsp basil, dried\n¾ tsp salt\n½ tsp black pepper"},{"id":576125,"primary_message":"Once the skillet is hot, add oil and swirl to coat the bottom. Pour the egg mixture into the skillet and scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny, then remove from heat.","secondary_message":"2 tbsp extra virgin olive oil"},{"id":576126,"primary_message":"Place tortillas on a flat surface and divide prosciutto between them. Top with scrambled eggs, lettuce, and tomato, then season with salt. Fold in sides of tortillas and roll tightly to close the wraps.","secondary_message":"6 large flour tortillas\n12 slices prosciutto\n½ tsp salt"},{"id":576127,"primary_message":"To serve, cut wraps in half and divide between plates. Enjoy!","secondary_message":null}],"line_items":[{"id":624139,"quantity":"1 ½ heads","ingredient_name":"butter (Boston) lettuce"},{"id":624136,"quantity":"12","ingredient_name":"eggs"},{"id":624137,"quantity":"6","ingredient_name":"large flour tortillas"},{"id":624140,"quantity":"12 slices","ingredient_name":"prosciutto"},{"id":624138,"quantity":"3","ingredient_name":"tomatoes"},{"id":624133,"quantity":"","ingredient_name":"basil, dried"},{"id":624134,"quantity":"","ingredient_name":"black pepper"},{"id":624132,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":624135,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":429.8,"alcohol":0.0,"ash":4.33,"caffeine":0.0,"water":183.73,"carbs":36.85,"fiber":2.69,"starch":26.44,"sugars":6.05,"fructose":1.07,"galactose":0.0,"glucose":1.32,"lactose":0.0,"maltose":2.25,"sucrose":0.41,"sugar_alcohol":0.0,"fat":20.81,"monounsaturated":8.76,"polyunsaturated":3.15,"omega_3":0.19,"omega_6":2.92,"saturated":5.93,"transfats":0.8,"cholesterol":347.24,"protein":24.14,"alanine":0.87,"arginine":0.98,"aspartic_acid":1.56,"cystine":0.36,"glutamic_acid":3.59,"glycine":0.61,"histidine":0.41,"isoleucine":0.81,"leucine":1.38,"lysine":0.97,"methionine":0.44,"phenylalanine":0.91,"proline":1.09,"serine":1.16,"threonine":0.68,"tryptophan":0.22,"tyrosine":0.62,"valine":1.01,"b1_thiamine":0.39,"b2_riboflavin":0.52,"b3_niacin":2.83,"b5_pantothenic_acid":1.57,"b6_pyridoxine":0.26,"b12_cobalamin":0.78,"choline":271.07,"folate":156.9,"vitamin_a":990.44,"vitamin_c":9.93,"vitamin_d":72.16,"vitamin_e":2.13,"vitamin_k":
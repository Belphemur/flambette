{"id":4950,"recipe_id":165,"serving_count":6,"cooking_minutes":40,"name":"Sautéed White Fish with Balsamic Quinoa, Spinach \u0026 Strawberry Salad","slug":"sauteed-white-fish-balsamic-quinoa-spinach-strawberry-salad","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/165/thumbnail_3f15ce7f-0bdb-464a-b4a2-cd60ca22ce2c.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/165/presentation_3f15ce7f-0bdb-464a-b4a2-cd60ca22ce2c.jpg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":36,"name":"salad spinner (optional)","slug":"salad-spinner"},{"id":14,"name":"small saucepan","slug":"small-saucepan"},{"id":18,"name":"spatula","slug":"spatula"},{"id":27,"name":"stainless steel skillet","slug":"stainless-steel-skillet"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":60141,"primary_message":"In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.","secondary_message":"1 ½ cups quinoa\n708 ml (3 cups) chicken or vegetable broth"},{"id":60149,"primary_message":"Heat a skillet over medium heat.","secondary_message":""},{"id":60148,"primary_message":"Season fish with dill, salt, and pepper. Dust both sides with flour.","secondary_message":"1 ½ tsp dill\n⅜ tsp salt\n⅜ tsp black pepper\n3 tbsp all-purpose flour"},{"id":60147,"primary_message":"Coat bottom of skillet with oil. Add fish and cook until golden, 2-3 minutes per side.","secondary_message":"about 3 tbsp extra virgin olive oil"},{"id":60146,"primary_message":"In a large bowl, prepare salad dressing by whisking together oil, vinegar, basil, salt, and pepper.","secondary_message":"4 ½ tbsp extra virgin olive oil\n3 tbsp balsamic vinegar\n1 ½ tsp basil\n⅜ tsp salt\n⅜ tsp black pepper"},{"id":60145,"primary_message":"Wash and dry spinach. Thinly slice leaves crosswise into ribbons and add to bowl with dressing.","secondary_message":"1 ½ (142 g) pkg baby spinach"},{"id":60144,"primary_message":"Wash strawberries, trim tops, and medium dice. Add to bowl.","secondary_message":"1 ½ (454 g) pkg strawberries"},{"id":60143,"primary_message":"Uncover quinoa and fluff with a fork. Add to bowl and toss salad.","secondary_message":""},{"id":60142,"primary_message":"To serve, place fish and salad on a plate. Enjoy!","secondary_message":""}],"line_items":[{"id":63697,"quantity":"1 ½ (142 g) pkg","ingredient_name":"baby spinach"},{"id":63695,"quantity":"708 ml","ingredient_name":"chicken or vegetable broth"},{"id":63706,"quantity":"0.681 kg","ingredient_name":"cod fillet"},{"id":63705,"quantity":"1 ½ cups","ingredient_name":"quinoa"},{"id":63704,"quantity":"1 ½ (454 g) pkgs","ingredient_name":"strawberries"},{"id":63703,"quantity":"","ingredient_name":"all-purpose flour"},{"id":63702,"quantity":"","ingredient_name":"balsamic vinegar"},{"id":63696,"quantity":"","ingredient_name":"basil, dried"},{"id":63701,"quantity":"","ingredient_name":"black pepper"},{"id":63700,"quantity":"","ingredient_name":"dill, dried"},{"id":63699,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":63698,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":473.74,"alcohol":0.0,"ash":4.87,"caffeine":0.0,"water":362.55,"carbs":43.58,"fiber":6.33,"starch":25.42,"sugars":9.78,"fructose":3.72,"galactose":0.05,"glucose":4.25,"lactose":0.0,"maltose":0.0,"sucrose":1.77,"sugar_alcohol":0.0,"fat":21.45,"monounsaturated":13.67,"polyunsaturated":3.8,"omega_3":0.55,"omega_6":3.25,"saturated":3.04,"transfats":0.06,"cholesterol":53.35,"protein":28.16,"alanine":1.5,"arginine":1.84,"aspartic_acid":2.72,
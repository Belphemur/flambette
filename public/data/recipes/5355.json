{"id":5355,"recipe_id":246,"serving_count":6,"cooking_minutes":50,"name":"Tomato-Basil Soup with Cheddar Grilled Cheese","slug":"tomato-basil-soup-cheddar-grilled-cheese","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/246/thumbnail_456118a8-f4eb-4663-8ec9-8be11da12c59.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/246/presentation_456118a8-f4eb-4663-8ec9-8be11da12c59.jpg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":74,"name":"hand or regular blender","slug":"hand-or-regular-blender"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":48,"name":"medium saucepan","slug":"medium-saucepan"},{"id":18,"name":"spatula","slug":"spatula"},{"id":59,"name":"stainless steel or cast iron skillet","slug":"stainless-steel-or-cast-iron-skillet"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":64356,"primary_message":"Remove butter from fridge and allow to soften in the microwave or on the counter.","secondary_message":"6 tbsp butter, unsalted"},{"id":64355,"primary_message":"Heat a large saucepan over medium heat.","secondary_message":""},{"id":64354,"primary_message":"Peel and small dice onion. Peel and mince garlic.","secondary_message":"1 ½ medium yellow onion\n6 cloves garlic"},{"id":64353,"primary_message":"Coat bottom of saucepan with oil. Add onion and garlic; begin cooking while you chop the carrot and celery.","secondary_message":"3 tbsp extra virgin olive oil"},{"id":64352,"primary_message":"Wash and thinly slice carrots and celery; add to saucepan. Stirring occasionally, cook until carrots and celery have softened, 6-7 minutes.","secondary_message":"3 medium carrots\n3 sticks celery"},{"id":64351,"primary_message":"Wash and medium dice tomatoes.","secondary_message":"6 tomatoes"},{"id":64350,"primary_message":"Wash basil. Pick leaves off the stems; discard the stems and thinly slice the leaves into ribbons.","secondary_message":"1 ½ small pkg fresh basil"},{"id":64343,"primary_message":"Add fresh and canned tomatoes, broth, salt, and pepper to saucepan. Stir and bring to a boil. Reduce heat, cover, and simmer for about 10 minutes.","secondary_message":"3 (398 ml) cans diced tomatoes\n708 ml (3 cups) chicken or vegetable broth\n1 ½ tsp salt\n⅜ tsp black pepper"},{"id":64349,"primary_message":"Heat a skillet over medium-low heat.","secondary_message":""},{"id":64348,"primary_message":"Grate 1 ½ cup of cheddar.","secondary_message":"¾ (227 g) block cheddar cheese"},{"id":64347,"primary_message":"Spread butter onto 1 side of each bread slice and place buttered-side down on a flat surface.","secondary_message":"12 slices whole grain bread"},{"id":64346,"primary_message":"Divide cheddar between 6 of the bread slices and top with the other slices. Place in the skillet and gently press down with a spatula. Cook until cheese is melted and bread is golden brown, 2-4 minutes per side.","secondary_message":""},{"id":64345,"primary_message":"Add basil to the soup and stir. Purée soup until smooth using a hand or regular blender.","secondary_message":""},{"id":64344,"primary_message":"Pour soup into a bowl and service with grilled cheese on the side. Enjoy!","secondary_message":""}],"line_items":[{"id":68846,"quantity":"3 medium","ingredient_name":"carrots"},{"id":68839,"quantity":"3 sticks","ingredient_name":"celery"},{"id":68838,"quantity":"¾ (227 g) block","ingredient_name":"cheddar cheese"},{"id":68833,"quantity":"708 ml","ingredient_name":"chicken or vegetable broth"},{"id":68845,"quantity":"3 (398 ml) cans","ingredient_name":"diced tomatoes"},{"id":68837,"quantity":"1 ½ small pkgs","ingredient_name":"fresh basil"},{"id":68844,"quantity":"6 cloves","ing
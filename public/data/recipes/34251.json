{"id":34251,"recipe_id":3794,"serving_count":6,"cooking_minutes":45,"name":"Green Lentil Dahl with Tomato, Bell Pepper, Cilantro, Yogurt \u0026 Naan","slug":"green-lentil-dahl-tomato-bell-pepper-cilantro-yogurt-naan","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3794/thumbnail_9f92243c-d047-4585-9fb0-66944192e632.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/3794/presentation_9f92243c-d047-4585-9fb0-66944192e632.jpeg","cookwares":[{"id":10,"name":"can opener","slug":"can-opener"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":52,"name":"grater (optional)","slug":"grater"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":77,"name":"toaster (optional)","slug":"toaster"}],"instructions":[{"id":540873,"primary_message":"Wash and dry the fresh produce. ","secondary_message":"1 small bunch green onions (scallions)\n3 green bell peppers\n3 yellow bell peppers\n3 (2 ½ cm) pieces ginger root\n1 small bunch cilantro"},{"id":540874,"primary_message":"Trim and cut green onions crosswise into thin pieces. Place half in a medium bowl. (Reserve remaining green onions for serving.)","secondary_message":null},{"id":540875,"primary_message":"Trim, seed, and medium dice bell peppers. Add to bowl with the green onions. ","secondary_message":null},{"id":540876,"primary_message":"Peel and mince ginger and garlic. Add both to the bowl. ","secondary_message":"3 cloves garlic"},{"id":540877,"primary_message":"Preheat a large pot over medium heat.","secondary_message":null},{"id":540878,"primary_message":"Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 5-6 minutes. ","secondary_message":"1 tbsp neutral vegetable oil\n1 tbsp garam masala\n1 tbsp curry powder\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp crushed red pepper"},{"id":540879,"primary_message":"Meanwhile, rinse lentils in a colander or strainer.","secondary_message":"1 ½ cups green lentils, dried"},{"id":540880,"primary_message":"Once the veggies are done, add lentils, tomatoes, and broth to the pot; stir to combine the dahl and bring to a boil over high heat. Once boiling, reduce to a simmer, cover, and cook until the lentils are just tender, 15-20 minutes.","secondary_message":"3 (398 ml) cans diced tomatoes\n710 ml chicken or vegetable broth"},{"id":540881,"primary_message":"Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.","secondary_message":null},{"id":540882,"primary_message":"When the lentils are done, add cilantro to the pot and stir to combine. Remove from heat. ","secondary_message":null},{"id":540883,"primary_message":"Toast naan if desired, then cut into wedges. ","secondary_message":"6 flatbreads or naan"},{"id":540884,"primary_message":"Divide dahl between bowls, then top with yogurt and reserved green onions. Serve with naan on the side and enjoy!","secondary_message":"¾ cup plain Greek yogurt"}],"line_items":[{"id":584965,"quantity":"710 ml","ingredient_name":"chicken or vegetable broth"},{"id":584964,"quantity":"1 small bunch","ingredient_name":"cilantro"},{"id":584961,"quantity":"3 (398 ml) cans","ingredient_name":"diced tomatoes"},{"id":584966,"quantity":"6","ingredient_name":"flatbreads or naan"},{"id":584956,"quantity":"3 cloves","ingredient_name":"garlic"},{"id":584967,"quantity":"3 (2 ½ cm) pieces","ingredient_name":"ginger root"},{"id":584969,"quantity":"3","ingredient_name":"green bell peppers"},{"id":584970,"quantity":"1 ½ cups","ingredient_name":"green lentils
{"id":22491,"recipe_id":2547,"serving_count":6,"cooking_minutes":30,"name":"Creamy Tuscan Ravioli with Mushrooms, Tomatoes, Spinach \u0026 Pine Nuts","slug":"creamy-tuscan-ravioli-mushrooms-tomatoes-spinach-pine-nuts","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2547/thumbnail_a3ab9231-8ac8-45a8-8fc6-175b846f4fb9.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2547/presentation_a3ab9231-8ac8-45a8-8fc6-175b846f4fb9.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":374641,"primary_message":"Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and ravioli, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions). Drain and set aside.","secondary_message":"1 ½ tsp salt\n765 g cheese ravioli, fresh or frozen"},{"id":374642,"primary_message":"Meanwhile, peel and mince garlic.","secondary_message":"3 cloves garlic"},{"id":374643,"primary_message":"Preheat another large pot over medium-high heat.","secondary_message":null},{"id":374644,"primary_message":"Once the pot is hot, add butter and swirl to coat the bottom. Add garlic and cook until fragrant, about 30 seconds.","secondary_message":"3 tbsp butter, unsalted"},{"id":374645,"primary_message":"Add mushrooms to the pot and cook, stirring occasionally, until golden brown, 4-5 minutes.","secondary_message":"3 (227g ) pkg sliced white mushrooms"},{"id":374646,"primary_message":"Meanwhile, wash, dry, and halve tomatoes.","secondary_message":"3 small pkgs grape tomatoes"},{"id":374647,"primary_message":"Wash and dry the spinach. (Skip if it came pre-washed.)","secondary_message":"3 (142 g) pkg baby spinach"},{"id":374648,"primary_message":"When the mushrooms are done, add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.","secondary_message":null},{"id":374649,"primary_message":"Add tomatoes and spices to the pot, then stir to combine. Continue to cook, stirring occasionally, until tomatoes begin to soften, 4-5 minutes.","secondary_message":"1 ½ tsp Italian seasoning\n¾ tsp crushed red pepper\n¾ tsp salt\n¾ tsp black pepper"},{"id":374650,"primary_message":"Add ravioli and Alfredo sauce to the pot. Continue to cook, stirring occasionally, until sauce is warmed through, 3-4 minutes more. Remove from heat.","secondary_message":"1 ½ (454 g) jars Alfredo sauce"},{"id":374651,"primary_message":"To serve, divide ravioli and sauce between plates or bowls. Sprinkle with pine nuts and enjoy!","secondary_message":"⅓ cup pine nuts"}],"line_items":[{"id":399633,"quantity":"1 ½ (454 g) jars","ingredient_name":"Alfredo sauce"},{"id":399625,"quantity":"3 (142 g) pkg","ingredient_name":"baby spinach"},{"id":399634,"quantity":"765 g","ingredient_name":"cheese ravioli, fresh or frozen"},{"id":399624,"quantity":"3 cloves","ingredient_name":"garlic"},{"id":399632,"quantity":"3 small pkgs","ingredient_name":"grape tomatoes"},{"id":399631,"quantity":"⅓ cup","ingredient_name":"pine nuts"},{"id":399635,"quantity":"3 (227g ) pkg","ingredient_name":"sliced white mushrooms"},{"id":399626,"quantity":"","ingredient_name":"black pepper"},{"id":399630,"quantity":"","ingredient_name":"butter, unsalted"},{"id":399628,"quantity":"","ingredient_name":"crushed red pepper"},{"id":399627,"quantity":"","ingredient_name":"Italian seasoning"},{"id":399629,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":561.62,"alcoh
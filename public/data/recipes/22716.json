{"id":22716,"recipe_id":2567,"serving_count":6,"cooking_minutes":30,"name":"Creamy Cauliflower Salad with Ham, Celery \u0026 Dill","slug":"creamy-cauliflower-salad-ham-celery-dill","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2567/thumbnail_ae02b202-0267-480e-b283-f61ede33ce93.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2567/presentation_ae02b202-0267-480e-b283-f61ede33ce93.jpeg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":78,"name":"large pot","slug":"large-pot"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":376770,"primary_message":"Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.","secondary_message":null},{"id":376771,"primary_message":"Meanwhile, wash and dry the fresh produce.","secondary_message":"1 ½ medium heads cauliflower\n3 sticks celery\n1 small bunch fresh dill"},{"id":376772,"primary_message":"Cut each cauliflower into 1-inch florets and slice stems into smaller pieces.","secondary_message":null},{"id":376773,"primary_message":"Once the water comes to a boil, uncover, then add cauliflower and salt; stir for a few seconds. Cook until tender-crisp, 3-4 minutes. Drain and set aside to cool slightly.","secondary_message":"¾ tsp salt"},{"id":376774,"primary_message":"Meanwhile, place mayo, Dijon, vinegar, and spices in a large bowl; whisk to combine the dressing.","secondary_message":"½ cup mayonnaise\n2 tbsp Dijon mustard\n2 tbsp red wine vinegar\n¾ tsp salt\n¾ tsp black pepper\n¾ tsp garlic powder\n¾ tsp curry powder\n½ tsp paprika"},{"id":376775,"primary_message":"Peel and mince shallots. Add to the bowl with the dressing.","secondary_message":"2 shallots"},{"id":376776,"primary_message":"Trim and small dice celery. Add to the bowl.","secondary_message":null},{"id":376777,"primary_message":"Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl.","secondary_message":null},{"id":376778,"primary_message":"Small dice ham. Add to the bowl, along with the cauliflower, and stir to combine the salad.","secondary_message":"680 g ham steak, boneless"},{"id":376779,"primary_message":"To serve, divide salad between bowls and enjoy!","secondary_message":null}],"line_items":[{"id":401999,"quantity":"1 ½ medium heads","ingredient_name":"cauliflower"},{"id":401998,"quantity":"3 sticks","ingredient_name":"celery"},{"id":402001,"quantity":"1 small bunch","ingredient_name":"fresh dill"},{"id":402002,"quantity":"680 g","ingredient_name":"ham steak, boneless"},{"id":401997,"quantity":"2","ingredient_name":"shallots"},{"id":401990,"quantity":"","ingredient_name":"black pepper"},{"id":401991,"quantity":"","ingredient_name":"curry powder"},{"id":401995,"quantity":"","ingredient_name":"Dijon mustard"},{"id":401992,"quantity":"","ingredient_name":"garlic powder"},{"id":402000,"quantity":"","ingredient_name":"mayonnaise"},{"id":401993,"quantity":"","ingredient_name":"paprika"},{"id":401996,"quantity":"","ingredient_name":"red wine vinegar"},{"id":401994,"quantity":"","ingredient_name":"salt"}],"nutrition":{"energy":349.87,"alcohol":0.01,"ash":8.06,"caffeine":0.0,"water":259.26,"carbs":11.42,"fiber":4.11,"starch":1.06,"sugars":4.49,"fructose":1.61,"galactose":0.1,"glucose":1.69,"lactose":0.0,"maltose":0.0,"sucrose":1.02,"sugar_alcohol":0.0,"fat":22.69,"monounsaturated":6.49,"polyunsaturated":10.34,"omega_3":1.23,"omega_6":9.1,"saturated":4.6,"transfats":0.09,"cholesterol":64.7,"protein":26.16,"alanine":1.53,"arginine":1.64,"aspartic_acid":2.48,"cystine":0.38,"glutamic_acid":4.
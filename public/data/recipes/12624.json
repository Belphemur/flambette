{"id":12624,"recipe_id":1477,"serving_count":6,"cooking_minutes":30,"name":"Orange-Blueberry \"Salsa\" with Cinnamon-Sugar Chips","slug":"orange-blueberry-salsa-cinnamon-sugar-chips","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1477/thumbnail_a93b5daa-23ed-40ec-8c3b-af00d930bae3.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1477/presentation_a93b5daa-23ed-40ec-8c3b-af00d930bae3.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":18,"name":"spatula","slug":"spatula"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":213009,"primary_message":"Preheat oven to 205°C (400°F).","secondary_message":null},{"id":213010,"primary_message":"Place sugar, cinnamon, and nutmeg in a large bowl; stir to combine the spice mix and set aside.","secondary_message":"2 tbsp granulated sugar\n1 ½ tsp cinnamon\n½ tsp nutmeg, ground"},{"id":213011,"primary_message":"Cut flatbreads into wedges, divide between two baking sheet pans, and spread out in an even layer.","secondary_message":"6 flatbreads or naan"},{"id":213012,"primary_message":"Drizzle oil over the wedges and sprinkle with spice mix; toss to coat, then spread back out in an even layer. (If the oil is solid, melt it in a small saucepan over low heat or in the microwave.)","secondary_message":"1 tbsp virgin coconut oil"},{"id":213013,"primary_message":"Place wedges in the oven (it doesn't have to be fully heated) and bake until toasted and crisp, 8-10 minutes. Reserve bowl for the fruit salsa.","secondary_message":null},{"id":213014,"primary_message":"Meanwhile, wash, dry, and cut off skin and white pith from the oranges. Slice between the membranes to release segments, small dice, and transfer to the reserved bowl.","secondary_message":"3 oranges"},{"id":213015,"primary_message":"Wash, dry, and roughly chop blueberries; add to the bowl with the oranges.","secondary_message":"1 ½ (170 g) pkg blueberries"},{"id":213016,"primary_message":"Finely chop dates and add to the bowl along with maple syrup and cardamom. Stir to combine the fruit salsa.","secondary_message":"¾ cup medjool dates, pitted\n1 ½ tsp pure maple syrup\n3 pinch cardamom, ground"},{"id":213017,"primary_message":"Serve flatbread chips with fruit salsa on the side and enjoy!","secondary_message":null}],"line_items":[{"id":223266,"quantity":"1 ½ (170 g) pkg","ingredient_name":"blueberries"},{"id":223268,"quantity":"6","ingredient_name":"flatbreads or naan"},{"id":223273,"quantity":"¾ cup","ingredient_name":"medjool dates, pitted"},{"id":223269,"quantity":"3","ingredient_name":"oranges"},{"id":223272,"quantity":"","ingredient_name":"cardamom, ground"},{"id":223264,"quantity":"","ingredient_name":"cinnamon, ground"},{"id":223270,"quantity":"","ingredient_name":"granulated sugar"},{"id":223271,"quantity":"","ingredient_name":"nutmeg, ground"},{"id":223265,"quantity":"","ingredient_name":"pure maple syrup"},{"id":223267,"quantity":"","ingredient_name":"virgin coconut oil"}],"nutrition":{"energy":556.4,"alcohol":0.0,"ash":2.7,"caffeine":0.0,"water":154.03,"carbs":91.99,"fiber":6.73,"starch":49.33,"sugars":34.55,"fructose":11.49,"galactose":0.6,"glucose":11.81,"lactose":1.59,"maltose":0.08,"sucrose":8.3,"sugar_alcohol":0.0,"fat":17.19,"monounsaturated":3.79,"polyunsaturated":1.11,"omega_3":0.12,"omega_6":0.99,"saturated":10.68,"transfats":0.51,"cholesterol":37.23,"protein":12.07,"alanine":0.43,"arginine":0.45,"aspartic_acid":0.68,"cystine":0.23,"glutamic_acid":3.53,"glycine":0.45,"histidine":0.26,"isoleucine":0
{"id":25368,"recipe_id":2869,"serving_count":6,"cooking_minutes":35,"name":"Cheesy Flatbread with Lemony Arugula, Parmesan \u0026 Toasted Pine Nuts","slug":"cheesy-flatbread-lemony-arugula-parmesan-toasted-pine-nuts","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2869/thumbnail_5064d40a-3446-433a-a415-f30608ccc57c.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/2869/presentation_5064d40a-3446-433a-a415-f30608ccc57c.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":37,"name":"citrus juicer (optional)","slug":"citrus-juicer"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":15,"name":"grater","slug":"grater"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"},{"id":35,"name":"tongs","slug":"tongs"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":407029,"primary_message":"Preheat oven to 230°C (450°F).","secondary_message":null},{"id":407030,"primary_message":"Preheat a skillet over medium heat.","secondary_message":null},{"id":407031,"primary_message":"Once the skillet is hot, add pine nuts and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to a small bowl and set aside to cool.","secondary_message":"⅓ cup pine nuts"},{"id":407032,"primary_message":"Meanwhile, divide flatbreads between two large baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake until flatbreads are warm, about 5 minutes.","secondary_message":"6 flatbreads or naan"},{"id":407033,"primary_message":"While the flatbreads warm up, wash, dry, and zest lemons into a large bowl (reserve lemons for later use).","secondary_message":"1 ½ lemons"},{"id":407034,"primary_message":"Coarsely grate mozzarella. Add to the bowl with the lemon zest and stir to combine.","secondary_message":"¾ (227 g) block mozzarella cheese"},{"id":407035,"primary_message":"Remove flatbreads from oven and sprinkle with the lemon-cheese mixture. Return baking sheets to the oven and continue to bake until flatbreads are crispy and cheese is melted, 4-5 minutes more. Remove from oven. (Reserve bowl for next step.)","secondary_message":null},{"id":407036,"primary_message":"Meanwhile, peel and mince shallots. Place in the reserved bowl.","secondary_message":"2 shallots"},{"id":407037,"primary_message":"Juice reserved lemons into the bowl with the shallot. Add oil, pepper, and salt, then whisk to combine the dressing.","secondary_message":"3 tbsp extra virgin olive oil\n¾ tsp black pepper\n½ tsp salt"},{"id":407038,"primary_message":"Wash and dry arugula (skip this step if it came pre-washed). Add to the bowl with the dressing.","secondary_message":"1 ½ (142 g) pkg baby arugula"},{"id":407039,"primary_message":"Using a peeler, shave the Parmesan into curls. Add to the bowl, along with the pine nuts, and gently toss to combine the salad.","secondary_message":"85 g Parmesan cheese"},{"id":407040,"primary_message":"Top each flatbread with a small handful of the arugula salad, then slice into wedges. (Reserve remaining salad for serving.)","secondary_message":null},{"id":407041,"primary_message":"Divide flatbreads between plates. Serve with remaining salad on the side and enjoy!","secondary_message":null}],"line_items":[{"id":435721,"quantity":"1 ½ (142 g) pkgs","ingredient_name":"baby arugula"},{"id":435724,"quantity":"6","ingredient_name":"flatbreads or naan"},{"id":435723,"quantity":"1 ½","ingredient_name":"lemons"},{"id":435717,"quantity":"¾ (227 g) block","ingredient_name":"mozzarella che
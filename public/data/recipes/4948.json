{"id":4948,"recipe_id":196,"serving_count":6,"cooking_minutes":45,"name":"Sautéed Chicken Thighs with Roasted Parsnips \u0026 Grape Tomatoes","slug":"sauteed-chicken-thighs-roasted-parsnips-grape-tomatoes","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/196/thumbnail_9647084c-b4e5-42cb-b231-dfbf4c8df900.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/196/presentation_9647084c-b4e5-42cb-b231-dfbf4c8df900.jpg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":18,"name":"spatula","slug":"spatula"},{"id":27,"name":"stainless steel skillet","slug":"stainless-steel-skillet"},{"id":35,"name":"tongs","slug":"tongs"},{"id":26,"name":"vegetable peeler","slug":"vegetable-peeler"}],"instructions":[{"id":60130,"primary_message":"Preheat oven to 260°C (500°F).","secondary_message":""},{"id":60129,"primary_message":"Wash parsnips, tomatoes, and green onions. Peel the parsnips, halve crosswise, then halve or quarter lengthwise to form equal-size pieces. Trim root ends and cut green onions into 5 cm pieces. Transfer everything to a sheet pan.","secondary_message":"12 medium parsnips\n1 ½ small pkg grape tomatoes\n1 ½ small bunches green onions"},{"id":60128,"primary_message":"Drizzle with oil and season with thyme, salt, and pepper; toss to coat.","secondary_message":"6 tbsp extra virgin olive oil\n¾ tsp thyme\n¾ tsp salt\n⅜ tsp black pepper"},{"id":60127,"primary_message":"Place in the oven and roast, tossing once halfway through, until parsnips are tender, 15-20 minutes.","secondary_message":""},{"id":60126,"primary_message":"Heat a skillet over medium-heat.","secondary_message":""},{"
{"id":4914,"recipe_id":121,"serving_count":6,"cooking_minutes":40,"name":"Grape Tomato, Basil \u0026 Ricotta Flatbread Pizza with Arugula Salad","slug":"grape-tomato-basil-ricotta-flatbread-pizza-arugula-salad","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/121/thumbnail_66b04870-e886-4247-9580-01757a38d496.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/121/presentation_66b04870-e886-4247-9580-01757a38d496.jpg","cookwares":[{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":15,"name":"grater","slug":"grater"},{"id":22,"name":"measuring cups","slug":"measuring-cups"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":23,"name":"mixing bowls","slug":"mixing-bowls"},{"id":36,"name":"salad spinner (optional)","slug":"salad-spinner"},{"id":42,"name":"whisk or fork","slug":"whisk-or-fork"}],"instructions":[{"id":59764,"primary_message":"Preheat oven to 200°C (400°F).","secondary_message":""},{"id":59763,"primary_message":"Peel and mince garlic. In a small bowl, mix together garlic, oil, salt, and pepper.","secondary_message":"9 cloves garlic\n3 tbsp extra virgin olive oil\n⅜ tsp salt\n3 pinches black pepper"},{"id":59762,"primary_message":"Wash, dry, and halve tomatoes.","secondary_message":"1 ½ small pkg grape tomatoes"},{"id":59761,"primary_message":"Measure out 3 cups of ricotta.","secondary_message":"1 ½ (425 g) pkg ricotta cheese"},{"id":59760,"primary_message":"Place flatbreads on a flat surface. Spoon oil and garlic mixture over top, add tomatoes, and finish off with spoonfuls of ricotta.","secondary_message":"6 flatbreads or naan"},{"id":59759,"primary_message":"Place in the oven, directly on the rack, and bake until cheese melts, 8-10 minutes. Then broil for 1-2 minutes.","secondary_messa
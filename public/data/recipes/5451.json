{"id":5451,"recipe_id":267,"serving_count":6,"cooking_minutes":40,"name":"Roasted Salmon with Garlic Buttered Leeks","slug":"roasted-salmon-garlic-buttered-leeks","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/267/thumbnail_4d340b73-bd44-4978-a5c9-f408dbafae01.jpg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/267/presentation_4d340b73-bd44-4978-a5c9-f408dbafae01.jpg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":34,"name":"oven mitts","slug":"oven-mitts"},{"id":27,"name":"stainless steel skillet","slug":"stainless-steel-skillet"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":65426,"primary_message":"Preheat oven to 220°C (425°F) and position rack in the centre.","secondary_message":""},{"id":65425,"primary_message":"Pat salmon dry with a paper towel and place, skin-side down, on a baking sheet. Rub with olive oil, drizzle with lemon juice, and season with salt and freshly ground pepper. Set aside.","secondary_message":"1.02 kg salmon fillet\n3 tsp extra virgin olive oil\njuice of ¾ lemon\n¾ tsp salt\n⅜ tsp black pepper"},{"id":65424,"primary_message":"Wash leeks and trim ends. Slice on the diagonal into ⅔ cm thick pieces.","secondary_message":"9 leeks"},{"id":65423,"primary_message":"Heat a skillet over medium heat.","secondary_message":""},{"id":65422,"primary_message":"Peel and mince garlic.","secondary_message":"9 cloves garlic"},{"id":65421,"primary_message":"Place salmon in the oven and roast until it's opaque, 10-15 minutes (depending on thickness).","secondary_message":""},{"id":65420,"primary_message":"Melt butter in skillet. Add garlic and stir until fragrant, 15-30 seconds. Add leeks and season with thyme, salt, and freshly ground pepper; stir to coat in the butter. Reduce heat to low and cook, stirring occasionally, until leeks are tender, about 10 minutes.","secondary_message":"9 tbsp butter, unsalted\n1 ½ tsp thyme\n¾ tsp salt\n⅜ tsp black pepper"},{"id":65419,"primary_message":"Serve salmon with buttered leeks on the side. Drizzle with juice from remaining lemon and enjoy!","secondary_message":""}],"line_items":[{"id":69942,"quantity":"9 cloves","ingredient_name":"garlic"},{"id":69950,"quantity":"9","ingredient_name":"leeks"},{"id":69949,"quantity":"1 ½","ingredient_name":"lemons"},{"id":69948,"quantity":"1.02 kg","ingredient_name":"salmon fillet"},{"id":69947,"quantity":"","ingredient_name":"black pepper"},{"id":69946,"quantity":"","ingredient_name":"butter, unsalted"},{"id":69945,"quantity":"","ingredient_name":"extra virgin olive oil"},{"id":69944,"quantity":"","ingredient_name":"salt"},{"id":69943,"quantity":"","ingredient_name":"thyme, dried"}],"nutrition":{"energy":515.31,"alcohol":0.0,"ash":5.14,"caffeine":0.0,"water":251.97,"carbs":21.55,"fiber":2.69,"starch":2.84,"sugars":5.57,"fructose":2.29,"galactose":0.0,"glucose":2.03,"lactose":0.13,"maltose":0.0,"sucrose":1.19,"sugar_alcohol":0.0,"fat":30.35,"monounsaturated":9.84,"polyunsaturated":4.52,"omega_3":2.93,"omega_6":1.49,"saturated":13.62,"transfats":0.71,"cholesterol":122.91,"protein":39.32,"alanine":2.33,"arginine":2.34,"aspartic_acid":3.99,"cystine":0.43,"glutamic_acid":5.87,"glycine":1.87,"histidine":1.13,"isoleucine":1.79,"leucine":3.15,"lysine":3.51,"methionine":1.13,"phenylalanine":1.53,"proline":1.41,"serine":1.64,"threonine":1.71,"tryptophan":0.43,"tyrosine":1.31,"valine":2.0,"b1_thiamine":0.29,"b2_riboflavin":0.29,"b3_niacin":12.89,"b5_pantothenic_acid":1.66,"b6_pyridoxine":1.31,"b12_cobalamin":7.13,"choline":204.52,"folate":104.6,"vitamin_a":233.99,"vitamin_c":23.88,"vitamin_d":626.65,"vitamin_e":3.34,"vitamin_k":66.36,"calcium":155.7,"copper":0.27,"iron":4.1
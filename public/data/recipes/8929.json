{"id":8929,"recipe_id":1027,"serving_count":6,"cooking_minutes":25,"name":"Mushroom Toasts with Goat Cheese, Balsamic \u0026 Thyme","slug":"mushroom-toasts-goat-cheese-balsamic-thyme","units":"Metric","thumbnail_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1027/thumbnail_503256f0-444e-4bfd-b6f9-eb9e86d04d6d.jpeg","presentation_image_url":"https://cdn-uploads.mealime.com/uploads/recipe/thumbnail/1027/presentation_503256f0-444e-4bfd-b6f9-eb9e86d04d6d.jpeg","cookwares":[{"id":33,"name":"baking sheet pan","slug":"baking-sheet-pan"},{"id":2,"name":"chef's knife","slug":"chef-s-knife"},{"id":11,"name":"colander","slug":"colander"},{"id":1,"name":"cutting board","slug":"cutting-board"},{"id":3,"name":"garlic press (optional)","slug":"garlic-press"},{"id":5,"name":"measuring spoons","slug":"measuring-spoons"},{"id":91,"name":"nonstick skillet","slug":"nonstick-skillet"},{"id":13,"name":"stirring spoon","slug":"stirring-spoon"}],"instructions":[{"id":138972,"primary_message":"Peel and thinly slice the shallots into rings. ","secondary_message":"3 shallots"},{"id":138973,"primary_message":"Wash and slice mushrooms. ","secondary_message":"0.68 kg white mushrooms"},{"id":138974,"primary_message":"Preheat a large skillet over medium-high heat.","secondary_message":null},{"id":138975,"primary_message":"Peel and mince garlic.","secondary_message":"3 cloves garlic"},{"id":138976,"primary_message":"Once the skillet is hot, add butter and swirl to coat the bottom. Add the mushrooms and shallot; cook, stirring occasionally, until mushrooms begin to soften, about 5 minutes. ","secondary_message":"⅓ cup butter, unsalted"},{"id":138977,"primary_message":"Preheat oven to broil on high; position rack under the broiler. ","secondary_message":null},{"id":138978,"primary_message":"Wash and dry thyme. Slide leaves off the stems; discard the stems.","secondary_message":"¾ small pkg fresh thyme"},{"id":138979,"primary_message":"Add garlic, vinegar, salt, and pepper to the
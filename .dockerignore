node_modules
**/node_modules
dist
.git
.pi
.env
*.local
.DS_Store
tsconfig.*.tsbuildinfo
Dockerfile
.dockerignore

# Repo/tooling content that must never reach the build context or image
docs
e2e
# Only the Python data generators are dead weight in the image. The TypeScript
# build steps must NOT be excluded: `bun run build` ends with
# scripts/generate-recipe-seo.ts (ADR-0048), so dropping scripts/ makes the
# Docker build fail with "Module not found" AFTER vite has already run.
scripts/*.py
test-results
playwright-report
raw_recipes
raw_images
# The relay image ships the WHOLE runtime surface (its Dockerfile globs, never a
# hand-picked list — issue #6), but never the decision table: those specs depend
# on bun:test and are dev-only.
server/relay-core/*.test.ts

# The relay ships src/lib whole (its Dockerfile globs, never a hand-picked
# list — issue #6), but never its dev-only specs.
src/lib/*.test.ts
